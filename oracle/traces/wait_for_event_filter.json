          "b:0",
          "z"
        ]
      },
      {
        "run": [
          "run",
          "tmux wait-for -E -l window-renamed | wc -l | tr -d ' '"
        ]
      },
      {
        "control_send": {
          "id": "c1",
          "line": "display -p done"
