      },
      {
        "control_wait": {
          "id": "c1",
          "until": "%end"
        }
      },
      {
        "control_send": {
          "id": "c1",
          "line": "capture-pane -t s"
        }
      },
      {
        "control_wait": {
          "id": "c1",
          "until": "%end"
        }
      },
      {
        "control_close": {
          "id": "c1"
        }
