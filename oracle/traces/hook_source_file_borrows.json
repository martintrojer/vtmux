{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "hook_source_file_borrows",
  "inputs": {
    "name": "hook_source_file_borrows",
    "size": [
      80,
      24
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w0",
          "cat",
          "-"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "status-right",
          "x"
        ]
      },
      {
        "run": [
          "run-shell",
          "printf 'display -p FROM_SOURCE\\nwait-for -S hk\\n' > '#{d:socket_path}/sub.conf'"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "session-renamed",
          "source-file -F '#{d:socket_path}/sub.conf'"
        ]
      },
      {
        "control": {
          "argv": [
            "attach",
            "-t",
            "a"
          ],
          "id": "c1"
        }
      },
      {
        "run": [
          "rename-session",
          "-t",
          "a",
          "a2"
        ]
      },
      {
        "wait_for": "hk"
      },
      {
        "control_send": {
          "id": "c1",
          "line": "display -p DONE"
        }
      },
      {
        "control_wait": {
          "id": "c1",
          "until": "%end"
        }
      },
      {
        "control_close": {
          "id": "c1"
        }
      },
      {
        "run": [
          "kill-server"
        ]
      }
    ]
  },
  "observations": [
    {
      "step": 0,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 1,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 2,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 3,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 5,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 6,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 9,
      "observation": {
        "kind": "control",
        "lines": [
          "%begin <TIME> #1 0",
          "%end <TIME> #1 0",
          "%session-changed $0 a",
          "%session-renamed $0 a2",
          "FROM_SOURCE",
          "%begin <TIME> #2 1",
          "DONE",
          "%end <TIME> #2 1",
          "%exit"
        ],
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 10,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    }
  ]
}
