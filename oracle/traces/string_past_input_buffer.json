{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "string_past_input_buffer",
  "inputs": {
    "name": "string_past_input_buffer",
    "size": [
      80,
      24
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w",
          "-x",
          "80",
          "-y",
          "24",
          "sh",
          "-c",
          "tmux wait-for go; big() { head -c 1100000 /dev/zero | tr '\\0' \"$1\"; }; printf '\\033_one\\033\\\\'; printf '\\033_'; big x; printf '\\033\\\\'; printf '\\033]52;c;'; big A; printf '\\007'; printf '\\033]2;'; big y; printf '\\007\\033]2;mid\\007'; tmux wait-for go2; printf '\\033]52;c;aGk=\\007\\033_two\\033\\\\\\033]2;end\\007'; exec cat -"
        ]
      },
      {
        "run": [
          "set",
          "-s",
          "set-clipboard",
          "on"
        ]
      },
      {
        "run": [
          "select-pane",
          "-t",
          "%0",
          "-T",
          "t0"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "@log",
          ""
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-title-changed",
          "set -gaF @log '[#{hook_new_title}]'"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-title-changed[1]",
          "if -F '#{==:#{hook_new_title},end}' 'wait-for -S done'"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-title-changed[2]",
          "if -F '#{==:#{hook_new_title},mid}' 'wait-for -S mid'"
        ]
      },
      {
        "run": [
          "wait-for",
          "-S",
          "go"
        ]
      },
      {
        "wait_for": "mid"
      },
      {
        "run": [
          "display",
          "-p",
          "-t",
          "%0",
          "[#{pane_title}]"
        ]
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "list-buffers"
        ]
      },
      {
        "run": [
          "wait-for",
          "-S",
          "go2"
        ]
      },
      {
        "wait_for": "done"
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "list-buffers",
          "-F",
          "#{buffer_sample}"
        ]
      },
      {
        "run": [
          "kill-server"
        ]
      }
    ]
  },
