{
  "tmux_version": "3.8",
  "recorded_host": "linuxpc",
  "name": "prompt_pane_hooks",
  "inputs": {
    "name": "prompt_pane_hooks",
    "size": [
      40,
      8
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w",
          "-x",
          "40",
          "-y",
          "7",
          "cat"
        ]
      },
      {
        "run": [
          "select-pane",
          "-t",
          "%0",
          "-T",
          "t"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "status-right",
          "R"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "@log",
          ""
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-prompt-opened",
          "set -agF @log '|o:#{hook_prompt_type}:#{hook_pane}:#{hook_window}:#{hook_event}'"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-prompt-closed",
          "set -agF @log '|c:#{hook_prompt_type}:#{hook_pane}'"
        ]
      },
      {
        "attach": {
          "session": "a"
        }
      },
      {
        "settle": {}
      },
      {
        "run": [
          "command-prompt",
          "-b",
          "-P",
          "-T",
          "search",
          "-p",
          "x#{prompt_flags}",
          "set -g @x '%%'"
        ]
      },
      {
        "settle": {
          "react": true
        }
      },
      {
        "screen": {}
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "command-prompt",
          "-b",
          "-P",
          "-p",
          "second",
          "set -g @y '%%'"
        ]
      },
      {
        "screen": {}
      },
      {
        "keys": "abc\r"
      },
      {
        "screen": {}
      },
      {
        "run": [
          "show",
          "-gv",
          "@x"
