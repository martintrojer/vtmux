      {
        "screen": {}
      },
      {
        "keys": "\u001b"
      },
      {
        "screen": {}
      },
      {
        "run": [
          "show",
          "-gqv",
          "@z"
        ]
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "split-window",
          "-t",
          "a",
          "cat"
        ]
      },
      {
        "run": [
          "command-prompt",
          "-b",
          "-P",
          "-p",
          "k",
          "set -g @k '%%'"
        ]
      },
      {
        "settle": {
          "react": true
        }
      },
      {
        "screen": {}
      },
      {
        "run": [
          "kill-pane",
          "-t",
          "%1"
        ]
      },
      {
        "settle": {
          "react": true
        }
      },
      {
        "screen": {}
      },
      {
