{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "format_table_no_environ",
  "inputs": {
    "name": "format_table_no_environ",
    "size": [
      80,
      24
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w",
          "-x",
          "80",
          "-y",
          "24",
          "cat",
          "-"
        ]
      },
      {
        "run": [
          "select-pane",
          "-t",
          "a:w",
          "-T",
          "t"
        ]
      },
      {
        "run": [
          "set-environment",
          "-g",
          "client_name",
          "G1"
        ]
      },
      {
        "run": [
          "set-environment",
          "-g",
          "pane_dead_status",
          "G2"
        ]
      },
