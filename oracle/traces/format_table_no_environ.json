          "-g",
          "buffer_name",
          "G3"
        ]
      },
      {
        "run": [
          "set-environment",
          "-g",
          "copy_cursor_x",
          "G4"
        ]
      },
      {
        "run": [
          "set-environment",
          "-g",
          "VTX",
          "G5"
        ]
      },
      {
        "run": [
          "set-environment",
          "-t",
          "a",
          "VTX",
          "S5"
        ]
      },
      {
        "run": [
          "display",
          "-p",
          "-t",
          "a",
          "[#{client_name}][#{pane_dead_status}][#{buffer_name}][#{copy_cursor_x}][#{VTX}]"
        ]
      },
      {
        "run": [
          "display",
          "-p",
          "-t",
          "a",
          "#{?client_name,y,n}#{?copy_cursor_x,y,n}"
        ]
      }
    ]
  },
