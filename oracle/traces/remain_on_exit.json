          "-g",
          "@log",
          ""
        ]
      },
      {
        "run": [
          "killp",
          "-t",
          "a:w.1"
        ]
      },
      {
        "run": [
          "killp",
          "-t",
          "a:wsig"
        ]
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "lsw",
          "-F",
          "#{window_index} #{window_name} #{window_panes}"
        ]
      },
      {
        "run": [
