        ]
      },
      {
        "settle": {}
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-focus-out[0]",
          "movew -d -s a:0 -t b:5"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "pane-focus-out[1]",
          "set -p @m yes; set -agF @log '|#{hook}:#{hook_pane}->#{session_name}:#{window_index}.#{pane_id}'"
        ]
      },
      {
        "run": [
          "selectw",
          "-t",
          "a:1"
        ]
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "lsp",
          "-a",
          "-F",
          "#{session_name}:#{window_index}.#{pane_id}=#{@m}"
        ]
      },
      {
        "run": [
          "kill-server"
        ]
      }
    ]
