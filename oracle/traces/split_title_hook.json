      }
    },
    {
      "step": 7,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 8,
      "observation": {
        "kind": "cli",
        "stdout": "[created %1][layout][title %1 t-w t-w][created %2][layout][title %2  ]\n",
        "stderr": "",
