{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "hook_pinned_child_message_log",
  "inputs": {
    "name": "hook_pinned_child_message_log",
    "size": [
      80,
      24
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w0",
          "cat",
          "-"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "status-right",
          "x"
        ]
      },
      {
        "attach": {
          "session": "a"
        }
      },
      {
        "run": [
          "set-hook",
          "-g",
          "session-renamed",
          "if -F 1 { set -g @x 1 } ; wait-for -S hk"
        ]
      },
      {
        "run": [
          "rename-session",
          "-t",
          "a",
          "a2"
        ]
      },
      {
        "wait_for": "hk"
      },
      {
        "run": [
          "run-shell",
          "tmux show-messages | grep 'command: set-option -g @x 1$' | sed -e 's/^.* \\([^ ]*\\) command:/\\1 command:/'"
        ]
      },
      {
        "run": [
          "kill-server"
        ]
      }
    ]
  },
  "observations": [
    {
      "step": 0,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 1,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 3,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 4,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 5,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 6,
      "observation": {
        "kind": "cli",
        "stdout": "<TTY> command: set-option -g @x 1\n",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 7,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    }
  ]
}
