{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "hooks_alert_activity",
  "inputs": {
    "name": "hooks_alert_activity",
    "size": [
      80,
      24
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w0",
          "-x",
          "40",
          "-y",
          "6",
          "sh",
          "-c",
          "tmux wait-for g0; printf y; exec cat"
        ]
      },
      {
        "run": [
          "neww",
          "-d",
          "-n",
          "w1",
          "sh",
          "-c",
          "tmux wait-for g1; printf x; exec cat"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "monitor-activity",
          "on"
        ]
      },
      {
        "run": [
          "set-hook",
          "-g",
          "alert-activity",
          "set -gaF @log '#{hook}:#{hook_window}:#{hook_window_index}:#{hook_session} '"
        ]
      },
      {
        "run": [
          "set-hook",
          "-ga",
          "alert-activity",
          "wait-for -S alert"
        ]
      },
      {
        "run": [
          "wait-for",
          "-S",
          "g1"
        ]
      },
      {
        "wait_for": "alert"
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "lsw",
          "-F",
          "#{window_index} #{window_flags} #{window_activity_flag}"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "activity-action",
          "any"
        ]
      },
      {
        "run": [
          "wait-for",
          "-S",
          "g0"
        ]
      },
      {
        "wait_for": "alert"
      },
      {
        "run": [
          "show",
          "-gv",
          "@log"
        ]
      },
      {
        "run": [
          "show-hooks",
          "-g",
          "-F",
          "#{option_name}=#{hook_fire_count}",
          "alert-activity"
        ]
      }
    ]
  },
