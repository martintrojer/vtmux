{
  "tmux_version": "3.8",
  "name": "attach_status_and_detach",
  "inputs": {
    "name": "attach_status_and_detach",
    "size": [
      40,
      6
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w",
          "-x",
          "40",
          "-y",
          "6",
          "sh",
          "-c",
          "printf '$ '; exec cat"
        ]
      },
      {
        "run": [
          "select-pane",
          "-t",
          "a",
          "-T",
          "t"
        ]
      },
      {
        "attach": {
          "session": "a"
        }
      },
      {
        "screen": {}
      },
      {
        "keys": "echo hi\r"
      },
      {
        "settle": {}
      },
      {
        "screen": {}
      },
      {
        "keys": "\u0002d"
      },
      {
        "settle": {}
      },
      {
        "run": [
          "has",
          "-t",
          "a"
        ]
      }
    ]
  },
  "observations": [
    {
      "step": 0,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 1,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    },
    {
      "step": 3,
      "observation": {
        "kind": "screen",
        "rows": [
          "$",
          "",
          "",
          "",
          "",
          "\\e[30m\\e[42m[a] \\e[4m0:w*\\e[0m\\e[42m             \\e[30m\"t\" <CLOCK>"
        ],
        "cursor": [
          2,
          0
        ]
      }
    },
    {
      "step": 6,
      "observation": {
        "kind": "screen",
        "rows": [
          "$ echo hi",
          "echo hi",
          "",
          "",
          "",
          "\\e[30m\\e[42m[a] \\e[4m0:w*\\e[0m\\e[42m             \\e[30m\"t\" <CLOCK>"
        ],
        "cursor": [
          0,
          2
        ]
      }
    },
    {
      "step": 9,
      "observation": {
        "kind": "cli",
        "stdout": "",
        "stderr": "",
        "exit": 0
      }
    }
  ]
}
