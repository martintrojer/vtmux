{
  "tmux_version": "3.8",
  "recorded_host": "<HOST>",
  "name": "scrollbars_autohide",
  "inputs": {
    "name": "scrollbars_autohide",
    "size": [
      40,
      12
    ],
    "steps": [
      {
        "run": [
          "new",
          "-d",
          "-s",
          "a",
          "-n",
          "w",
          "-x",
          "40",
          "-y",
          "12",
          "sh",
          "-c",
          "i=1; while [ $i -le 30 ]; do echo L$i; i=$((i+1)); done; exec cat"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "status",
          "off"
        ]
      },
      {
        "run": [
          "set",
          "-g",
          "mouse",
          "on"
        ]
      },
      {
        "run": [
