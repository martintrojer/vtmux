          "-t",
          "a:0.0",
          "-T",
          "t"
        ]
      },
      {
        "run": [
          "set",
          "-w",
          "-t",
          "a:0",
          "pane-scrollbars",
          "auto-hide"
        ]
      },
      {
        "run": [
          "set",
          "-w",
          "-t",
          "a:0",
          "pane-scrollbars-timeout",
          "600000"
        ]
      },
      {
        "run": [
          "set",
          "-w",
          "-t",
          "a:0",
          "pane-scrollbars-style",
          "bg=red,fg=blue,width=1,pad=0"
        ]
