kind=format
cols=20
bytes=abcdefghijklmnopqrstuvwxyz\nshort\nl2\nl3\033[?7l
format=#{history_size}
resize=12x5
command=new-session -d -x 20 -y 5 'sh -c 'printf '"'"'abcdefghijklmnopqrstuvwxyz\nshort\nl2\nl3\033[?7l'"'"'; $REF wait-for -S ready; exec cat'' ; wait-for ready ; resize-window -t 0 -x 12 -y 5 ; display-message -p -t 0 '#{history_size}'
expected=1\n
