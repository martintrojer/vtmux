        ("i", "alpha,", 0), // set -gF @out '#{C/i:alpha,}' ; show -gv @out
        ("i", "FOO", 2), // set -gF @out '#{C/i:FOO}' ; show -gv @out
        ("i", "ALPHA", 1), // set -gF @out '#{C/i:ALPHA}' ; show -gv @out
        ("i", "^beta", 0), // set -gF @out '#{C/i:^beta}' ; show -gv @out
