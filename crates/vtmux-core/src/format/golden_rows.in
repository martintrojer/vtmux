        r("#{!;n:@x}", "1"), // set -gF @out '#{!;n:@x}' ; show -gv @out
        r("#{<;=1:a,b}", "1"), // set -gF @out '#{<;=1:a,b}' ; show -gv @out
        r("#{<;p3:a,b}", "1  "), // set -gF @out '#{<;p3:a,b}' ; show -gv @out
