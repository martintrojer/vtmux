#[allow(clippy::too_many_lines)]
fn rows_nosession() -> Vec<(String, String)> {
    vec![
        r("a#{N:w}b", "a"), // set -gF @out 'a#{N:w}b' ; show -gv @out
        r("a#{N/w:w}b", "a"), // set -gF @out 'a#{N/w:w}b' ; show -gv @out
        r("a#{N/s:w}b", "a0b"), // set -gF @out 'a#{N/s:w}b' ; show -gv @out
        r("a#{N/s:#{session_name}}b", "a0b"), // set -gF @out 'a#{N/s:#{session_name}}b' ; show -gv @out
        r("a#{N/x:w}b", "ab"), // set -gF @out 'a#{N/x:w}b' ; show -gv @out
        r("a#{V:#{environ_name}}b", "ab"), // set -gF @out 'a#{V:#{environ_name}}b' ; show -gv @out
        r("a#{V/g:#{environ_name}=#{environ_value}|}b", "aCL1=x|CL2=y|HOME=/|LANG=C.UTF-8|PATH=/usr/bin:/bin|PWD=/|SHELL=/bin/sh|TZ=UTC|b"), // set -gF @out 'a#{V/g:#{environ_name}=#{environ_value}|}b' ; show -gv @out
        r("a#{V/c:#{environ_name}=#{environ_value}|}b", "aCL1=x|CL2=y|HOME=/|LANG=C.UTF-8|PATH=/usr/bin:/bin|SHELL=/bin/sh|TZ=UTC|b"), // set -gF @out 'a#{V/c:#{environ_name}=#{environ_value}|}b' ; show -gv @out
        r("a#{C:x}b", "a0b"), // set -gF @out 'a#{C:x}b' ; show -gv @out
        r("a#{C/r:x}b", "a0b"), // set -gF @out 'a#{C/r:x}b' ; show -gv @out
        r("x#{b:@nosuch}#{R:ab}y", "x"), // set -gF @out 'x#{b:@nosuch}#{R:ab}y' ; show -gv @out
        r("#{?#{N:w},y,n}z", "nz"), // set -gF @out '#{?#{N:w},y,n}z' ; show -gv @out
        r("#{?@x,#{N:w},n}z", "nz"), // set -gF @out '#{?@x,#{N:w},n}z' ; show -gv @out
        r("#{!:#{N:w}}z", "1z"), // set -gF @out '#{!:#{N:w}}z' ; show -gv @out
        r("#{E:#{N:w}}z", "z"), // set -gF @out '#{E:#{N:w}}z' ; show -gv @out
        r("#{e|+:1,2}#{N:w}#{e|+:1,2}", "3"), // set -gF @out '#{e|+:1,2}#{N:w}#{e|+:1,2}' ; show -gv @out
        r("#{n;N:w}", ""), // set -gF @out '#{n;N:w}' ; show -gv @out
        r("#{N:#{session_name}}", ""), // set -gF @out '#{N:#{session_name}}' ; show -gv @out
        r("#{session_name}-#{N:w}-x", "-"), // set -gF @out '#{session_name}-#{N:w}-x' ; show -gv @out
    ]
}
