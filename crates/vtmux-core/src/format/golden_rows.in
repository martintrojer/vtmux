        r("#{=4;w:@wide}", "4"), // set -gF @out '#{=4;w:@wide}' ; show -gv @out
        r("#{w;=3:@wide}", "2"), // set -gF @out '#{w;=3:@wide}' ; show -gv @out
        r("#{E;=3:@cond}", "yes"), // set -gF @out '#{E;=3:@cond}' ; show -gv @out
        r("#{E;b:@p1}", "foo.txt"), // set -gF @out '#{E;b:@p1}' ; show -gv @out
