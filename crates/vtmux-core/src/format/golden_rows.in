        r("#{||;n:0,hello}", "1"), // set -gF @out '#{||;n:0,hello}' ; show -gv @out
        r("#{&&;p4:1,1}", "1   "), // set -gF @out '#{&&;p4:1,1}' ; show -gv @out
        r("#{==;p4:a,a}", "1   "), // set -gF @out '#{==;p4:a,a}' ; show -gv @out
        r("#{<=:a,a}x#{>=:a,b}", "1x0"), // set -gF @out '#{<=:a,a}x#{>=:a,b}' ; show -gv @out
        r("#{e|+;p4:1,2}", "3   "), // set -gF @out '#{e|+;p4:1,2}' ; show -gv @out
        r("#{e|+|f;p8:1,2}", "3.00    "), // set -gF @out '#{e|+|f;p8:1,2}' ; show -gv @out
        r("#{e|+;=1:12,34}", "4"), // set -gF @out '#{e|+;=1:12,34}' ; show -gv @out
        r("#{e|+;n:12,34}", "2"), // set -gF @out '#{e|+;n:12,34}' ; show -gv @out
        r("#{e|+|f|3;=4:1,2}", "3.00"), // set -gF @out '#{e|+|f|3;=4:1,2}' ; show -gv @out
        r("#{e|/|f|3;p-8:1,3}", "   0.333"), // set -gF @out '#{e|/|f|3;p-8:1,3}' ; show -gv @out
        r("#{l;p6:ab}", "ab    "), // set -gF @out '#{l;p6:ab}' ; show -gv @out
        r("#{l;n:ab}", "2"), // set -gF @out '#{l;n:ab}' ; show -gv @out
        r("#{l;=-1:ab}", "b"), // set -gF @out '#{l;=-1:ab}' ; show -gv @out
        r("#{a;p3:65}", "A  "), // set -gF @out '#{a;p3:65}' ; show -gv @out
        r("#{a;=1:65}", "A"), // set -gF @out '#{a;=1:65}' ; show -gv @out
        r("#{c;=3:red}", "800"), // set -gF @out '#{c;=3:red}' ; show -gv @out
        r("#{c;p8:red}", "800000  "), // set -gF @out '#{c;p8:red}' ; show -gv @out
        r("#{c/f;n:red}", "5"), // set -gF @out '#{c/f;n:red}' ; show -gv @out
        r("#{R;=3:ab,5}", "aba"), // set -gF @out '#{R;=3:ab,5}' ; show -gv @out
        r("#{R;p10:ab,2}", "abab      "), // set -gF @out '#{R;p10:ab,2}' ; show -gv @out
        r("#{R;w:世,3}", "6"), // set -gF @out '#{R;w:世,3}' ; show -gv @out
        r("#{?#{==:#{=3:@name},hel},yes,no}", "yes"), // set -gF @out '#{?#{==:#{=3:@name},hel},yes,no}' ; show -gv @out
        r("#{?#{>:#{n:@name},3},long,short}", "long"), // set -gF @out '#{?#{>:#{n:@name},3},long,short}' ; show -gv @out
        r("#{?#{>=:#{w:@wide},4},wide,narrow}", "wide"), // set -gF @out '#{?#{>=:#{w:@wide},4},wide,narrow}' ; show -gv @out
        r("#{==:#{b:@p1},foo.txt}", "1"), // set -gF @out '#{==:#{b:@p1},foo.txt}' ; show -gv @out
        r("#{==:#{=/3/.:@name},hel.}", "1"), // set -gF @out '#{==:#{=/3/.:@name},hel.}' ; show -gv @out
        r("#{||:#{!:@x},#{!!:@zero},#{e|>:2,1}}", "1"), // set -gF @out '#{||:#{!:@x},#{!!:@zero},#{e|>:2,1}}' ; show -gv @out
        r("#{&&:#{e|>:2,1},#{<:a,b},#{b:@p1}}", "1"), // set -gF @out '#{&&:#{e|>:2,1},#{<:a,b},#{b:@p1}}' ; show -gv @out
        r("#{=/-4/~;p6:@name}", "~ello "), // set -gF @out '#{=/-4/~;p6:@name}' ; show -gv @out
        r("#{=/4/~;p-6:@name}", " hell~"), // set -gF @out '#{=/4/~;p-6:@name}' ; show -gv @out
        r("#{p3;p6;=2:@name}", "he    "), // set -gF @out '#{p3;p6;=2:@name}' ; show -gv @out
        r("#{!:#{=0:@zero}}", "1"), // set -gF @out '#{!:#{=0:@zero}}' ; show -gv @out
        r("#{n:#{R:ab,3}}", "6"), // set -gF @out '#{n:#{R:ab,3}}' ; show -gv @out
        r("#{w:#{R:世,3}}", "6"), // set -gF @out '#{w:#{R:世,3}}' ; show -gv @out
        r("#{=3:#{R:ab,3}}", "aba"), // set -gF @out '#{=3:#{R:ab,3}}' ; show -gv @out
        r("#{q:#{b:@p1}}", "foo.txt"), // set -gF @out '#{q:#{b:@p1}}' ; show -gv @out
        r("#{q;b:@p2}", "b"), // set -gF @out '#{q;b:@p2}' ; show -gv @out
        r("#{b:#{q:@p1}}", "/usr/lib/foo.txt"), // set -gF @out '#{b:#{q:@p1}}' ; show -gv @out
        r("#{E:#{=3:@cond}}", ""), // set -gF @out '#{E:#{=3:@cond}}' ; show -gv @out
        r("#{E:#{b:@p1}}", "foo.txt"), // set -gF @out '#{E:#{b:@p1}}' ; show -gv @out
        r("#[fg=#{c:red}]x", "#[fg=800000]x"), // set -gF @out '#[fg=#{c:red}]x' ; show -gv @out
        r("#{?@x,#{e|+:1,2},n}", "3"), // set -gF @out '#{?@x,#{e|+:1,2},n}' ; show -gv @out
        r("#{?@x,#{=2:@name},n}", "he"), // set -gF @out '#{?@x,#{=2:@name},n}' ; show -gv @out
        r("#{?#{==:1,1},#{p4:@x},n}", "1   "), // set -gF @out '#{?#{==:1,1},#{p4:@x},n}' ; show -gv @out
        r("[#{=5:@name}|#{p6:@x}|#{e|+:1,1}]", "[hello|1     |2]"), // set -gF @out '[#{=5:@name}|#{p6:@x}|#{e|+:1,1}]' ; show -gv @out
    ]
}

fn searches() -> Vec<(&'static str, &'static str, u32)> {
    vec![
        ("", "alpha", 1), // set -gF @out '#{C:alpha}' ; show -gv @out
        ("", "beta", 2), // set -gF @out '#{C:beta}' ; show -gv @out
