        r("#{=-3;d:@p1}", "lib"), // set -gF @out '#{=-3;d:@p1}' ; show -gv @out
        r("#{p10;=3:@p1}", "/us       "), // set -gF @out '#{p10;=3:@p1}' ; show -gv @out
        r("#{=3;p10:@name}", "hel       "), // set -gF @out '#{=3;p10:@name}' ; show -gv @out
        r("#{p10;=3;n:@name}", "10"), // set -gF @out '#{p10;=3;n:@name}' ; show -gv @out
        r("#{=3;n:@name}", "3"), // set -gF @out '#{=3;n:@name}' ; show -gv @out
