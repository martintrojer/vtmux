        ("", "b.ta F", 0), // set -gF @out '#{C:b.ta F}' ; show -gv @out
        ("", "^BETA", 0), // set -gF @out '#{C:^BETA}' ; show -gv @out
        ("", "^ALPHA$", 0), // set -gF @out '#{C:^ALPHA$}' ; show -gv @out
        ("", "(", 0), // set -gF @out '#{C:(}' ; show -gv @out
