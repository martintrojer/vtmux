        r("#{C/#{@x}:alpha}", "1"), // set -gF @out '#{C/#{@x}:alpha}' ; show -gv @out
        r("#{C:Foo}x#{C:alpha}", "2x1"), // set -gF @out '#{C:Foo}x#{C:alpha}' ; show -gv @out
        r("#{?#{C:Foo},yes,no}", "yes"), // set -gF @out '#{?#{C:Foo},yes,no}' ; show -gv @out
        r("#{?#{C:zzz},yes,no}", "no"), // set -gF @out '#{?#{C:zzz},yes,no}' ; show -gv @out
        r("#{=1;C:alpha}", "1"), // set -gF @out '#{=1;C:alpha}' ; show -gv @out
        r("#{p3;C:alpha}", "1  "), // set -gF @out '#{p3;C:alpha}' ; show -gv @out
        r("#{=3;b:@p1}", "foo"), // set -gF @out '#{=3;b:@p1}' ; show -gv @out
