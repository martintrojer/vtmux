// Rows: (template, expansion). Fixture: see tests/format_cases.sh.
fn vars() -> Vec<(&'static str, &'static str)> {
    vec![
        ("@x", "1"),
        ("@zero", "0"),
        ("@empty", ""),
        ("@name", "hello"),
        ("@loop", "x#{E:@loop}y"),
        ("@cond", "#{?@x,yes,no}"),
        ("@esc", "a#,b"),
        ("@epoch", "86400"),
        ("@p1", "/usr/lib/foo.txt"),
        ("@p2", "/a/b/"),
        ("@p3", "foo"),
        ("@p4", "//"),
        ("@p5", "a//b//c"),
        ("@p6", "/"),
        ("@p7", "///a//"),
        ("@p8", ".."),
        ("@p9", "//a"),
        ("@sp", "a b"),
        ("@dq", "a\"b"),
        ("@sq", "a'b"),
        ("@dol", "a$b"),
        ("@dol2", "$a"),
        ("@hash", "a#b"),
        ("@tilde", "~"),
        ("@tilde2", "~a"),
        ("@semi", "x;y"),
        ("@bs", "a\\b"),
        ("@tab", "a\u{9}b"),
        ("@nl", "a\u{a}b"),
        ("@utf", "é"),
        ("@wide", "世界"),
        ("@mix", "a世b"),
        ("@emoji", "\u{1f600}"),
        ("@comb", "e\u{301}x"),
        ("@sty", "#[fg=red]ab#[default]cd"),
        ("@hh", "a##b"),
        ("@braces", "{}"),
        ("@long", "abcdefghij"),
        ("@n65", "65"),
        ("@n5", "5"),
        ("@n3", "3"),
    ]
}

