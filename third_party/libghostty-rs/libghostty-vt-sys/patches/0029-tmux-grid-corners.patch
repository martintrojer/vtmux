+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings(switch (op) {
+            'L' => "a||bbbbbbbbbb|bb|c",
+            'M' => "a|bb|c",
+            else => "a|bbbbbbbbbb+|bb|c",
