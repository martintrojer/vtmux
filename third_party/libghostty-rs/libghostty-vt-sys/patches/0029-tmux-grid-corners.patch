+test "Terminal: reflow leaves empty rows before a tab wider than the pane (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // tmux 3.8, `printf 'ab\r\n\tcd\tx'` on 20 columns narrowed to 7,
+    // then 5: grid_reflow_split moves to the next line before a cell that
+    // does not fit with nothing on the line yet, so a line of one tab
+    // wider than the pane leaves two empty rows, and a join into an empty
+    // line stops at it consuming nothing.
+    var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 20 });
+    defer t.deinit(alloc);
+    try t.printString("ab");
+    t.carriageReturn();
+    try t.linefeed();
+    t.horizontalTab();
+    try t.printString("cd");
+    t.horizontalTab();
+    try t.printString("x");
+
+    try t.resize(alloc, .{ .cols = 7, .rows = 6 });
+    {
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("ab|T+|-------+|cd+|T-+|----x", rows);
+    }
+
+    try t.resize(alloc, .{ .cols = 5, .rows = 6 });
+    {
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("ab|+|+|T+|-----+|--cd+|T+|-----+|x", rows);
+    }
+
+    // Narrower again: the empty rows stay and the tabs leave two more each.
+    try t.resize(alloc, .{ .cols = 4, .rows = 6 });
+    {
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("ab|+|+|+|+|T+|----+|---c+|d+|+|+|T+|----+|-x", rows);
+    }
+
+    // Wide enough for the tabs again: one line of two rows (tmux's
+    // measure splits it before the second tab).
+    try t.resize(alloc, .{ .cols = 20, .rows = 6 });
+    {
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("ab|T-------cd+|T-----x", rows);
+    }
+}
