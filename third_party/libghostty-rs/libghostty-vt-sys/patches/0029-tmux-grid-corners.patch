+test "Terminal: tmux grid bookkeeping corners (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // EL 2 on a line never written to (screen_write_clearline returns
+    // early): the empty rows a reflow leaves before a tab wider than the
+    // pane stay wrapped. In a background colour it clears and unwraps.
+    for ([_]bool{ false, true }) |red| {
+        var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("ab");
+        t.carriageReturn();
+        try t.linefeed();
+        t.horizontalTab();
+        try t.resize(alloc, .{ .cols = 8, .rows = 6 });
+        try t.resize(alloc, .{ .cols = 5, .rows = 6 });
+        try t.setAttribute(if (red) .{ .@"8_bg" = .red } else .unset);
+        t.setCursorPos(3, 1);
+        t.eraseLine(.complete, false);
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings(if (red) "ab|||T+|-----+|--" else "ab|+|+|T+|-----+|--", rows);
+    }
+
+    // Scroll-on-clear (CSI 22 J as vtmux uses it) scrolls the rows up to
+    // the last with cells used, erased ones included
+    // (grid_view_clear_history).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("aaaaaaaaaabbb");
+        t.setCursorPos(2, 1);
+        t.eraseChars(3);
+        t.eraseDisplay(.scroll_complete, false);
+        try testing.expectEqual(@as(usize, 2), t.screens.active.pages.total_rows - t.rows);
+    }
+
+    // Without history: a region of two rows unwraps the line it moves to
+    // its top (grid_move_lines), and a region of one row (a one-row
+    // screen) does not scroll at all.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 2, .cols = 10, .max_scrollback_bytes = 0 });
+        defer t.deinit(alloc);
+        try t.printString("x");
+        t.carriageReturn();
+        try t.linefeed();
+        try t.printString("aaaaaaaaaabbb");
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("aaaaaaaaaa|bbb", rows);
+    }
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 1, .cols = 10, .max_scrollback_bytes = 0 });
+        defer t.deinit(alloc);
+        try t.printString("abcde");
+        t.carriageReturn();
+        try t.linefeed();
+        try t.printString("x");
+        try t.scrollUp(1);
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("xbcde", rows);
+    }
+
+    // RI at the top of a one-row screen does not scroll either, history or
+    // not (grid_view_scroll_region_down).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 1, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("abc");
+        t.reverseIndex();
+        const rows = try tmuxTestRows(&t, alloc);
+        defer alloc.free(rows);
+        try testing.expectEqualStrings("abc", rows);
+    }
+
+    // IL and DL with the cursor outside the scroll region work on the
+    // whole screen (grid_view_insert_lines, grid_view_delete_lines); an IL
+    // count reaching the bottom changes nothing.
+    for ([_]u8{ 'L', 'M', 'A' }) |op| {
