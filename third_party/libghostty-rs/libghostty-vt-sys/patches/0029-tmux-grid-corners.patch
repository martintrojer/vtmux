+/// vtmux: the screen's rows from the top of the scrollback as tmux's
+/// capture-pane -p would show them with tabs as `T` (a tab's first cell)
+/// and `-` (its other cells), each row followed by `+` when it wraps.
+fn tmuxTestRows(t: *Terminal, alloc: Allocator) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(alloc);
+    const pages = &t.screens.active.pages;
+    var y: usize = 0;
+    while (pages.getCell(.{ .screen = .{ .x = 0, .y = @intCast(y) } })) |first| : (y += 1) {
+        var line: std.ArrayList(u8) = .empty;
+        defer line.deinit(alloc);
+        for (0..t.cols) |x| {
+            const c = pages.getCell(.{ .screen = .{ .x = @intCast(x), .y = @intCast(y) } }).?;
+            const ch: u8 = if (c.cell.tab == Cell.tab_continuation)
+                '-'
+            else if (c.cell.tab != 0)
+                'T'
+            else if (c.cell.hasText())
+                @intCast(c.cell.codepoint())
+            else
+                ' ';
+            try line.append(alloc, ch);
+        }
+        var len = line.items.len;
+        while (len > 0 and line.items[len - 1] == ' ') len -= 1;
+        try out.appendSlice(alloc, line.items[0..len]);
+        if (first.row.wrap) try out.append(alloc, '+');
+        try out.append(alloc, '|');
+    }
+    // The blank rows at the bottom of the screen.
+    var len = out.items.len;
+    while (len > 0 and out.items[len - 1] == '|') len -= 1;
+    out.shrinkRetainingCapacity(len);
+    return out.toOwnedSlice(alloc);
+}
