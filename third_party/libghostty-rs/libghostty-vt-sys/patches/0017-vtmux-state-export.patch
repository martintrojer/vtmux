+test "vtmux state: rows round trip into a fresh terminal" {
+    const testing = std.testing;
+    var a: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(null, &a, 10, 3));
+    defer terminal_c.free(a);
+    const input = "\x1b[1;38;5;3mab\x1b[0m\xe4\xb8\x96\x1b]8;id=x;http://e\x1b\\L\x1b]8;;\x1b\\e\xcc\x81\r\n0123456789wrap\x1b7\x1b[2;3H";
+    terminal_c.vt_write(a, input.ptr, input.len);
+
+    var b: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(null, &b, 10, 3));
+    defer terminal_c.free(b);
+
+    var rows: [64]CRow = undefined;
+    var cells: [640]CCell = undefined;
+    var graphemes: [64]u32 = undefined;
+    var styles: [16]style_c.Style = undefined;
+    var links: [8]CLink = undefined;
+    var bytes: [256]u8 = undefined;
+    var imp: CImporter = null;
+    try testing.expectEqual(Result.success, importer_new(b, true, &imp));
+    var n: usize = 0;
+    try testing.expectEqual(Result.success, page_count(a, 0, &n));
+    for (0..n) |i| {
+        var page: CPage = .{
+            .size = @sizeOf(CPage),
+            .rows = &rows,
+            .rows_cap = rows.len,
+            .rows_len = 0,
+            .cells = &cells,
+            .cells_cap = cells.len,
+            .cells_len = 0,
+            .graphemes = &graphemes,
+            .graphemes_cap = graphemes.len,
+            .graphemes_len = 0,
+            .styles = &styles,
+            .styles_cap = styles.len,
+            .styles_len = 0,
+            .links = &links,
+            .links_cap = links.len,
+            .links_len = 0,
+            .bytes = &bytes,
+            .bytes_cap = bytes.len,
+            .bytes_len = 0,
+            .cols = 0,
+            .blob = false,
+            .capacity = .{},
+        };
+        try testing.expectEqual(Result.success, page_export(a, 0, i, true, &page));
+        try testing.expectEqual(Result.success, importer_page(imp, 0, &page));
+    }
+    var state: CState = undefined;
+    state.size = @sizeOf(CState);
+    var state_bytes: [256]u8 = undefined;
+    state.bytes = &state_bytes;
+    state.bytes_cap = state_bytes.len;
+    try testing.expectEqual(Result.success, state_export(a, &state));
+    try testing.expectEqual(Result.success, importer_finish(imp, &state));
+
+    const ta = a.?.terminal;
+    const tb = b.?.terminal;
+    const sa = ta.screens.active;
+    const sb = tb.screens.active;
+    try testing.expectEqual(sa.cursor.x, sb.cursor.x);
+    try testing.expectEqual(sa.cursor.y, sb.cursor.y);
+    try testing.expect(sb.saved_cursor != null);
+    const str_a = try sa.dumpStringAlloc(testing.allocator, .{ .screen = .{} });
+    defer testing.allocator.free(str_a);
+    const str_b = try sb.dumpStringAlloc(testing.allocator, .{ .screen = .{} });
+    defer testing.allocator.free(str_b);
+    try testing.expectEqualStrings(str_a, str_b);
+}
