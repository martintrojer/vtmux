diff --git a/src/terminal/c/vtmux_state.zig b/src/terminal/c/vtmux_state.zig
new file mode 100644
index 000000000..76bbdda58
--- /dev/null
+++ b/src/terminal/c/vtmux_state.zig
@@ -0,0 +1,1692 @@
+//! vtmux: export and import the whole state of a terminal (see
+//! include/ghostty/vt/vtmux_state.h).
+//!
+//! Pages come out as rows of cells through the page's own accessors, or,
+//! for a page compressed in memory, as a blob of the compressed page that
+//! only this build can read. Import builds the pages with
+//! `PageList.Builder`, as snapshot decoding does, and swaps them into the
+//! terminal's screens with the cursor, saved cursor and terminal state.
+
+const std = @import("std");
+const builtin = @import("builtin");
+const Allocator = std.mem.Allocator;
+const lib = @import("../lib.zig");
+const Result = @import("result.zig").Result;
+const terminal_c = @import("terminal.zig");
+const style_c = @import("style.zig");
+const ZigTerminal = @import("../Terminal.zig");
+const Screen = @import("../Screen.zig");
+const ScreenKey = @import("../ScreenSet.zig").Key;
+const PageList = @import("../PageList.zig");
+const pagepkg = @import("../page.zig");
+const compression = @import("../compress.zig");
+const stylepkg = @import("../style.zig");
+const hyperlink = @import("../hyperlink.zig");
+const modespkg = @import("../modes.zig");
+const charsets = @import("../charsets.zig");
+const BitmapAllocator = @import("../bitmap_allocator.zig").BitmapAllocator;
+
+const Page = pagepkg.Page;
+const Cell = pagepkg.Cell;
+const Row = pagepkg.Row;
+const Capacity = pagepkg.Capacity;
+
+/// C: GhosttyVtmuxRow
+pub const CRow = extern struct {
+    cell_start: u32,
+    cell_count: u16,
+    used: u16,
+    flags: u8,
+    reserved: [3]u8 = @splat(0),
+};
+
+/// C: GhosttyVtmuxCell
+pub const CCell = extern struct {
+    content: u32,
+    style: u16,
+    link: u16,
+    flags: u16,
+    tab: u8,
+    reserved: u8 = 0,
+};
+
+/// C: GhosttyVtmuxLink
+pub const CLink = extern struct {
+    uri_offset: u32,
+    uri_len: u32,
+    id_offset: u32,
+    id_len: u32,
+    implicit_id: u32,
+    explicit_id: u8,
+    reserved: [3]u8 = @splat(0),
+};
+
+/// C: GhosttyVtmuxCapacity
+pub const CCapacity = extern struct {
+    rows: u32 = 0,
+    styles: u32 = 0,
+    hyperlink_bytes: u32 = 0,
+    grapheme_bytes: u32 = 0,
+    string_bytes: u32 = 0,
+};
+
+/// C: GhosttyVtmuxPage
+pub const CPage = extern struct {
+    size: usize,
+    rows: ?[*]CRow,
+    rows_cap: usize,
+    rows_len: usize,
+    cells: ?[*]CCell,
+    cells_cap: usize,
+    cells_len: usize,
+    graphemes: ?[*]u32,
+    graphemes_cap: usize,
+    graphemes_len: usize,
+    styles: ?[*]style_c.Style,
+    styles_cap: usize,
+    styles_len: usize,
+    links: ?[*]CLink,
+    links_cap: usize,
+    links_len: usize,
+    bytes: ?[*]u8,
+    bytes_cap: usize,
+    bytes_len: usize,
+    cols: u16,
+    blob: bool,
+    capacity: CCapacity,
+};
+
+/// C: GhosttyVtmuxCharset
+pub const CCharset = extern struct {
+    g: [4]u8,
+    gl: u8,
+    gr: u8,
+    single_shift: u8,
+    reserved: u8 = 0,
+};
+
+/// C: GhosttyVtmuxScreenState
+pub const CScreenState = extern struct {
+    present: bool,
+    cursor_x: u16,
+    cursor_y: u16,
+    cursor_style: u8,
+    pending_wrap: bool,
+    protected_: bool,
+    semantic_content: u8,
+    semantic_content_clear_eol: bool,
+    pen: style_c.Style,
+    link_kind: u8,
+    link_implicit_id: u32,
+    link_uri_offset: u32,
+    link_uri_len: u32,
+    link_id_offset: u32,
+    link_id_len: u32,
+    hyperlink_implicit_counter: u32,
+    charset: CCharset,
+    protected_mode: u8,
+    kitty_flags: [8]u8,
+    kitty_index: u8,
+    semantic_click_kind: u8,
+    semantic_click_value: u8,
+    saved_present: bool,
+    saved_x: u16,
+    saved_y: u16,
+    saved_pen: style_c.Style,
+    saved_protected: bool,
+    saved_pending_wrap: bool,
+    saved_origin: bool,
+    saved_charset: CCharset,
+};
+
+/// C: GhosttyVtmuxMode
+pub const CMode = extern struct {
+    value: u16,
+    ansi: bool,
+    current: bool,
+    saved: bool,
+    default_: bool,
+};
+
+const max_modes = 96;
+const max_tabstop_bytes = 8192;
+
+/// C: GhosttyVtmuxState
+pub const CState = extern struct {
+    size: usize,
+    cols: u16,
+    rows: u16,
+    active_screen: u8,
+    scroll_top: u16,
+    scroll_bottom: u16,
+    scroll_left: u16,
+    scroll_right: u16,
+    status_display: u8,
+    previous_char: u32,
+    cursor_is_default: bool,
+    cursor_default_style: u8,
+    cursor_default_blink: u8,
+    shell_redraw: u8,
+    modify_other_keys_2: bool,
+    mouse_event: u8,
+    mouse_format: u8,
+    mouse_shift_capture: u8,
+    mouse_shape: u8,
+    password_input: bool,
+    xt_checksum: u8,
+    modes_len: usize,
+    modes: [max_modes]CMode,
+    tabstops: [max_tabstop_bytes]u8,
+    palette_mask: [32]u8,
+    palette: [256 * 3]u8,
+    fg_set: bool,
+    fg: [3]u8,
+    bg_set: bool,
+    bg: [3]u8,
+    cursor_color_set: bool,
+    cursor_color: [3]u8,
+    screens: [2]CScreenState,
+    bytes: ?[*]u8,
+    bytes_cap: usize,
+    bytes_len: usize,
+};
+
+comptime {
+    // The layout the Rust bindings declare (bindings.rs, `Vtmux*`).
+    if (@sizeOf(usize) == 8) {
+        std.debug.assert(@sizeOf(CRow) == 12 and @sizeOf(CCell) == 12);
+        std.debug.assert(@sizeOf(CLink) == 24 and @sizeOf(CCapacity) == 20);
+        std.debug.assert(@sizeOf(CPage) == 176 and @offsetOf(CPage, "capacity") == 156);
+        std.debug.assert(@sizeOf(CScreenState) == 112 and @offsetOf(CScreenState, "saved_pen") == 82);
+        std.debug.assert(@sizeOf(CState) == 9880 and @offsetOf(CState, "screens") == 9628);
+    }
+    // Every mode fits the fixed table.
+    std.debug.assert(@typeInfo(modespkg.Mode).@"enum".field_names.len <= max_modes);
+}
+
+/// A caller buffer that counts what does not fit, so one pass tells the
+/// caller how much to allocate.
+fn Out(comptime T: type) type {
+    return struct {
+        ptr: ?[*]T,
+        cap: usize,
+        len: usize = 0,
+
+        const Self = @This();
+
+        fn push(self: *Self, v: T) void {
+            if (self.len < self.cap) {
+                if (self.ptr) |p| p[self.len] = v;
+            }
+            self.len += 1;
+        }
+
+        fn pushSlice(self: *Self, vs: []const T) void {
+            if (self.len + vs.len <= self.cap) {
+                if (self.ptr) |p| @memcpy(p[self.len..][0..vs.len], vs);
+            }
+            self.len += vs.len;
+        }
+
+        fn fits(self: *const Self) bool {
+            return self.len <= self.cap;
+        }
+    };
+}
+
+fn screenKey(key: u8) ?ScreenKey {
+    return switch (key) {
+        0 => .primary,
+        1 => .alternate,
+        else => null,
+    };
+}
+
+fn screenOf(t: *ZigTerminal, key: u8) ?*Screen {
+    return t.screens.get(screenKey(key) orelse return null);
+}
+
+fn enumFromInt(comptime T: type, raw: anytype) ?T {
+    const Tag = @typeInfo(T).@"enum".tag_type;
+    const value = std.math.cast(Tag, raw) orelse return null;
+    return std.enums.fromInt(T, value);
+}
+
+fn enumByte(e: anytype) u8 {
+    return @intCast(@backingInt(e));
+}
+
+// ---------------------------------------------------------------------
+// Pages
+
+pub fn page_count(
+    terminal_: terminal_c.Terminal,
+    screen_key: u8,
+    out: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const screen = screenOf(wrapper.terminal, screen_key) orelse return .no_value;
+    var n: usize = 0;
+    var node = screen.pages.pages.first;
+    while (node) |current| : (node = current.next) n += 1;
+    if (out) |o| o.* = n;
+    return .success;
+}
+
+pub fn page_export(
+    terminal_: terminal_c.Terminal,
+    screen_key: u8,
+    index: usize,
+    blob_if_compressed: bool,
+    out_: ?*CPage,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (out.size < @sizeOf(CPage)) return .invalid_value;
+    const screen = screenOf(wrapper.terminal, screen_key) orelse return .no_value;
+    var node = screen.pages.pages.first;
+    var i: usize = 0;
+    while (node) |current| : (node = current.next) {
+        if (i == index) break;
+        i += 1;
+    }
+    const n = node orelse return .no_value;
+    const alloc = wrapper.terminal.gpa();
+    switch (n.data) {
+        .resident => |*p| return exportRows(alloc, p, out),
+        .compressed => |*c| {
+            if (blob_if_compressed) {
+                return exportBlob(c, n.owned == .heap, out);
+            }
+            // Decode into scratch memory: the page stays compressed.
+            const scratch = std.heap.page_allocator.alignedAlloc(
+                u8,
+                .fromByteUnits(std.heap.page_size_min),
+                c.page.memory.len,
+            ) catch return .out_of_memory;
+            defer std.heap.page_allocator.free(scratch);
+            const p = c.cloneBuf(scratch) catch return .invalid_value;
+            return exportRows(alloc, &p, out);
+        },
+    }
+}
+
+fn rowFlags(row: *const Row) u8 {
+    var flags: u8 = 0;
+    if (row.wrap) flags |= 0x01;
+    if (row.wrap_continuation) flags |= 0x02;
+    flags |= @as(u8, @backingInt(row.semantic_prompt)) << 2;
+    return flags;
+}
+
+fn exportRows(alloc: Allocator, page: *const Page, out: *CPage) Result {
+    var rows: Out(CRow) = .{ .ptr = out.rows, .cap = out.rows_cap };
+    var cells: Out(CCell) = .{ .ptr = out.cells, .cap = out.cells_cap };
+    var graphemes: Out(u32) = .{ .ptr = out.graphemes, .cap = out.graphemes_cap };
+    var styles: Out(style_c.Style) = .{ .ptr = out.styles, .cap = out.styles_cap };
+    var links: Out(CLink) = .{ .ptr = out.links, .cap = out.links_cap };
+    var bytes: Out(u8) = .{ .ptr = out.bytes, .cap = out.bytes_cap };
+
+    // Page-local style and hyperlink ids to table indexes, in first-use
+    // order.
+    var style_map: std.AutoHashMapUnmanaged(stylepkg.Id, u16) = .empty;
+    defer style_map.deinit(alloc);
+    var link_map: std.AutoHashMapUnmanaged(hyperlink.Id, u16) = .empty;
+    defer link_map.deinit(alloc);
+    styles.push(.default);
+    links.push(std.mem.zeroes(CLink));
+
+    for (0..page.size.rows) |y| {
+        const row = page.getRow(y);
+        const row_cells = page.getCells(row);
+        var count: usize = row_cells.len;
+        while (count > 0 and @as(u64, @bitCast(row_cells[count - 1])) == 0) count -= 1;
+        rows.push(.{
+            .cell_start = @intCast(cells.len),
+            .cell_count = @intCast(count),
+            .used = row.tmux_used,
+            .flags = rowFlags(row),
+        });
+        for (row_cells[0..count]) |*cell| {
+            var flags: u16 = 0;
+            var content: u32 = 0;
+            switch (cell.content_tag) {
+                .codepoint => content = cell.content.codepoint.data,
+                .codepoint_grapheme => {
+                    content = cell.content.codepoint.data;
+                    const cps = page.lookupGrapheme(cell) orelse &.{};
+                    if (cps.len > 0) {
+                        flags |= 1;
+                        graphemes.push(@intCast(cells.len));
+                        graphemes.push(@intCast(cps.len));
+                        for (cps) |cp| graphemes.push(cp);
+                    }
+                },
+                .bg_color_palette => {
+                    flags |= 2;
+                    content = cell.content.color_palette.data;
+                    if (cell.content.color_palette.palette_256) flags |= 1 << 5;
+                },
+                .bg_color_rgb => {
+                    flags |= 3;
+                    const c = cell.content.color_rgb;
+                    content = (@as(u32, c.r) << 16) | (@as(u32, c.g) << 8) | c.b;
+                },
+            }
+            flags |= @as(u16, @backingInt(cell.wide)) << 2;
+            if (cell.protected) flags |= 1 << 4;
+            flags |= @as(u16, @backingInt(cell.semantic_content)) << 6;
+
+            var style_index: u16 = 0;
+            if (cell.style_id != stylepkg.default_id) {
+                const entry = style_map.getOrPut(alloc, cell.style_id) catch
+                    return .out_of_memory;
+                if (!entry.found_existing) {
+                    entry.value_ptr.* = @intCast(styles.len);
+                    styles.push(.fromStyle(page.styles.get(page.memory, cell.style_id).*));
+                }
+                style_index = entry.value_ptr.*;
+            }
+
+            var link_index: u16 = 0;
+            if (cell.hyperlink) link: {
+                const id = page.lookupHyperlink(cell) orelse break :link;
+                const entry = link_map.getOrPut(alloc, id) catch
+                    return .out_of_memory;
+                if (!entry.found_existing) {
+                    entry.value_ptr.* = @intCast(links.len);
+                    const e = page.hyperlink_set.get(page.memory, id);
+                    const uri = e.uri.slice(page.memory);
+                    var link: CLink = .{
+                        .uri_offset = @intCast(bytes.len),
+                        .uri_len = @intCast(uri.len),
+                        .id_offset = 0,
+                        .id_len = 0,
+                        .implicit_id = 0,
+                        .explicit_id = 0,
+                    };
+                    bytes.pushSlice(uri);
+                    switch (e.id) {
+                        .implicit => |v| link.implicit_id = v,
+                        .explicit => |s| {
+                            const id_bytes = s.slice(page.memory);
+                            link.explicit_id = 1;
+                            link.id_offset = @intCast(bytes.len);
+                            link.id_len = @intCast(id_bytes.len);
+                            bytes.pushSlice(id_bytes);
+                        },
+                    }
+                    links.push(link);
+                }
+                link_index = entry.value_ptr.*;
+            }
+
+            cells.push(.{
+                .content = content,
+                .style = style_index,
+                .link = link_index,
+                .flags = flags,
+                .tab = cell.tab,
+            });
+        }
+    }
+
+    out.rows_len = rows.len;
+    out.cells_len = cells.len;
+    out.graphemes_len = graphemes.len;
+    out.styles_len = styles.len;
+    out.links_len = links.len;
+    out.bytes_len = bytes.len;
+    out.cols = page.size.cols;
+    out.blob = false;
+    out.capacity = .{
+        .rows = page.capacity.rows,
+        .styles = page.capacity.styles,
+        .hyperlink_bytes = page.capacity.hyperlink_bytes,
+        .grapheme_bytes = page.capacity.grapheme_bytes,
+        .string_bytes = page.capacity.string_bytes,
+    };
+    if (!(rows.fits() and cells.fits() and graphemes.fits() and
+        styles.fits() and links.fits() and bytes.fits())) return .out_of_space;
+    return .success;
+}
+
+/// The blob of a compressed page: this header, the page's metadata (its
+/// `Page` value, the memory pointer zeroed) and the compressed bytes. Only
+/// a library of the same build reads it back (`Page` is native layout).
+/// `checksum` is the Wyhash of everything after the header: the import
+/// reads nothing of a blob it does not match, and the page's LZ4 bytes
+/// are only decoded on its first read, long after the import.
+const BlobHeader = extern struct {
+    magic: u32 = blob_magic,
+    page_size: u32 = @sizeOf(Page),
+    memory_len: u64,
+    encoded_len: u64,
+    checksum: u64,
+    heap: u8,
+    reserved: [7]u8 = @splat(0),
+};
+const blob_magic: u32 = 0x32505456; // "VTP2"
+const blob_seed: u64 = 0x7674_6d75_7862_6c62; // "vtmuxblb"
+
+fn blobChecksum(meta: []const u8, encoded: []const u8) u64 {
+    var h: std.hash.Wyhash = .init(blob_seed);
+    h.update(meta);
+    h.update(encoded);
+    return h.final();
+}
+
+fn exportBlob(c: *const compression.Page, heap: bool, out: *CPage) Result {
+    var meta = c.page;
+    meta.memory = &.{};
+    const header: BlobHeader = .{
+        .memory_len = c.page.memory.len,
+        .encoded_len = c.encoded.len,
+        .checksum = blobChecksum(std.mem.asBytes(&meta), c.encoded),
+        .heap = @intFromBool(heap),
+    };
+    var bytes: Out(u8) = .{ .ptr = out.bytes, .cap = out.bytes_cap };
+    bytes.pushSlice(std.mem.asBytes(&header));
+    bytes.pushSlice(std.mem.asBytes(&meta));
+    bytes.pushSlice(c.encoded);
+    out.rows_len = 0;
+    out.cells_len = 0;
+    out.graphemes_len = 0;
+    out.styles_len = 0;
+    out.links_len = 0;
+    out.bytes_len = bytes.len;
+    out.cols = c.page.size.cols;
+    out.blob = true;
+    out.capacity = .{};
+    return if (bytes.fits()) .success else .out_of_space;
+}
+
+// ---------------------------------------------------------------------
+// Import
+
+const Importer = struct {
+    wrapper: @typeInfo(terminal_c.Terminal).optional.child,
+    alloc: Allocator,
+    builders: [2]?PageList.Builder = .{ null, null },
+    /// Decode every blob now and verify every page's integrity, instead
+    /// of trusting a blob's checksum until its first read (vtmux's dry
+    /// run before an upgrade's exec).
+    check: bool,
+
+    fn deinit(self: *Importer) void {
+        for (&self.builders) |*b| if (b.*) |*builder| builder.deinit();
+        self.alloc.destroy(self);
+    }
+};
+
+pub const CImporter = ?*Importer;
+
+pub fn importer_new(
+    terminal_: terminal_c.Terminal,
+    check: bool,
+    out: ?*CImporter,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const o = out orelse return .invalid_value;
+    // A tracked reference would keep a pin into a page list the import
+    // replaces.
+    if (wrapper.tracked_grid_refs.count() != 0) return .invalid_value;
+    const alloc = wrapper.terminal.gpa();
+    const imp = alloc.create(Importer) catch return .out_of_memory;
+    imp.* = .{ .wrapper = wrapper, .alloc = alloc, .check = check };
+    o.* = imp;
+    return .success;
+}
+
+pub fn importer_free(imp_: CImporter) callconv(lib.calling_conv) void {
+    const imp = imp_ orelse return;
+    imp.deinit();
+}
+
+pub fn importer_page(
+    imp_: CImporter,
+    screen_key: u8,
+    page_: ?*const CPage,
+) callconv(lib.calling_conv) Result {
+    const imp = imp_ orelse return .invalid_value;
+    const page = page_ orelse return .invalid_value;
+    if (page.size < @sizeOf(CPage) or screen_key > 1) return .invalid_value;
+    const t = imp.wrapper.terminal;
+    if (imp.builders[screen_key] == null) {
+        // Alternate screens never keep scrollback (as `screen.decode`);
+        // the primary's limits are copied from the terminal at finish.
+        imp.builders[screen_key] = PageList.Builder.init(imp.alloc, .{
+            .cols = t.cols,
+            .rows = t.rows,
+            .max_size = if (screen_key == 1) 0 else null,
+            .max_lines = if (screen_key == 1) 0 else null,
+        }) catch return .out_of_memory;
+    }
+    const builder = &imp.builders[screen_key].?;
+    if (page.blob) {
+        importBlob(imp, builder, page, t.cols) catch |err| return switch (err) {
+            error.OutOfMemory => .out_of_memory,
+            error.Invalid => .invalid_value,
+        };
+        return .success;
+    }
+    // Every page of a screen has the terminal's width: Ghostty's page
+    // list operations assume it (`PageList.resizeCols`, `beginUpdate`).
+    if (page.cols != t.cols) return .invalid_value;
+    // The exporter's capacity first: the same build's page held this
+    // content. Another build's may be too small for it; the page is then
+    // sized from its content.
+    importRows(imp, builder, page, true) catch |err| switch (err) {
+        error.PageFull => importRows(imp, builder, page, false) catch |err2| return switch (err2) {
+            error.OutOfMemory => .out_of_memory,
+            error.Invalid, error.PageFull => .invalid_value,
+        },
+        error.OutOfMemory => return .out_of_memory,
+        error.Invalid => return .invalid_value,
+    };
+    return .success;
+}
+
+const GraphemeBytes = BitmapAllocator(4 * @sizeOf(u21));
+const StringBytes = BitmapAllocator(32);
+/// page.zig `hyperlink_cell_multiplier`.
+const hyperlink_cell_multiplier = 16;
+/// `snapshot/grid.zig` `kitty_virtual_placeholder`.
+const kitty_virtual_placeholder: u21 = 0x10EEEE;
+
+/// The capacity for a page: the exporter's when it gave one and
+/// `use_hint` (the source page held exactly this content, so it fits;
+/// another build's may not, and the page is then filled again without
+/// it), else what `Page.exactRowCapacity` would count, and at least the
+/// standard capacity. Every sum is checked: the counts come from outside.
+fn capacityFor(page: *const CPage, use_hint: bool) error{Invalid}!Capacity {
+    if (page.cols == 0 or page.rows_len == 0) return error.Invalid;
+    const rows = std.math.cast(u16, page.rows_len) orelse return error.Invalid;
+    const hint = page.capacity;
+    const cap: Capacity = if (use_hint and hint.rows != 0) .{
+        .cols = page.cols,
+        .rows = @max(rows, std.math.cast(u16, hint.rows) orelse return error.Invalid),
+        .styles = std.math.cast(u16, hint.styles) orelse return error.Invalid,
+        .hyperlink_bytes = std.math.cast(u16, hint.hyperlink_bytes) orelse return error.Invalid,
+        // libghostty-vt 1.0 sizes the hyperlink map on its own
+        // (`Capacity.hyperlink_cells`), which the hint does not carry.
+        .hyperlink_cells = linkCellsCapacity(page),
+        .grapheme_bytes = hint.grapheme_bytes,
+        .string_bytes = hint.string_bytes,
+    } else try countedCapacity(page, rows);
+    if (Page.layout(cap).total_size > size_max_page) return error.Invalid;
+    return cap;
+}
+
+const size_max_page = @import("../size.zig").max_page_size;
+const OffsetBuf = @import("../size.zig").OffsetBuf;
+
+fn countedCapacity(page: *const CPage, rows: u16) error{Invalid}!Capacity {
+    var cap: Capacity = pagepkg.std_capacity.adjust(.{ .cols = page.cols }) catch
+        .{ .cols = page.cols, .rows = 1 };
+    cap.rows = @max(cap.rows, rows);
+
+    const add = std.math.add;
+    var grapheme_bytes: usize = 0;
+    if (page.graphemes) |g| {
+        var i: usize = 0;
+        while (i + 1 < page.graphemes_len) {
+            const n: usize = g[i + 1];
+            const need = std.math.mul(usize, @sizeOf(u21), n) catch return error.Invalid;
+            grapheme_bytes = add(usize, grapheme_bytes, GraphemeBytes.bytesRequired(u8, need)) catch
+                return error.Invalid;
+            i = add(usize, i, add(usize, 2, n) catch return error.Invalid) catch return error.Invalid;
+        }
+    }
+    var string_bytes: usize = 0;
+    var link_cells: usize = 0;
+    if (page.links) |l| {
+        if (page.links_len > 1) for (l[1..page.links_len]) |link| {
+            string_bytes = add(usize, string_bytes, StringBytes.bytesRequired(u8, link.uri_len)) catch
+                return error.Invalid;
+            if (link.explicit_id != 0) string_bytes = add(
+                usize,
+                string_bytes,
+                StringBytes.bytesRequired(u8, link.id_len),
+            ) catch return error.Invalid;
+        };
+    }
+    if (page.cells) |c| {
+        for (c[0..page.cells_len]) |cell| {
+            if (cell.link != 0) link_cells += 1;
+        }
+    }
+    const styles = stylepkg.Set.capacityForCount(page.styles_len -| 1);
+    const links = @max(
+        hyperlink.Set.capacityForCount(page.links_len -| 1),
+        std.math.divCeil(usize, link_cells, hyperlink_cell_multiplier) catch 0,
+    );
+    const link_bytes = std.math.mul(usize, links, @sizeOf(hyperlink.Set.Item)) catch
+        return error.Invalid;
+    // Ghostty's own pages stop at the 16-bit fields' maximum (a page of
+    // 1000 one-cell links fills `hyperlink_bytes`), so these clamp.
+    cap.styles = @intCast(@min(std.math.maxInt(u16), @max(cap.styles, styles)));
+    cap.grapheme_bytes = std.math.cast(u32, @max(cap.grapheme_bytes, grapheme_bytes)) orelse
+        return error.Invalid;
+    cap.string_bytes = std.math.cast(u32, @max(cap.string_bytes, string_bytes)) orelse
+        return error.Invalid;
+    cap.hyperlink_bytes = @intCast(@min(std.math.maxInt(u16), @max(cap.hyperlink_bytes, link_bytes)));
+    cap.hyperlink_cells = linkCellsCapacity(page);
+    return cap;
+}
+
+/// The hyperlink map capacity for `page`'s linked cells: Ghostty's
+/// default or the count, whichever is more, clamped to the field (the
+/// map rounds it up, as `Page.capacity` counts it).
+fn linkCellsCapacity(page: *const CPage) size_HyperlinkCountInt {
+    var link_cells: usize = 0;
+    if (page.cells) |c| {
+        for (c[0..page.cells_len]) |cell| {
+            if (cell.link != 0) link_cells += 1;
+        }
+    }
+    const default: Capacity = .{ .cols = 1, .rows = 1 };
+    return @intCast(@min(
+        std.math.maxInt(size_HyperlinkCountInt),
+        @max(default.hyperlink_cells, link_cells),
+    ));
+}
+
+const size_HyperlinkCountInt = @import("../size.zig").HyperlinkCountInt;
+
+fn styleColor(c: style_c.Color) stylepkg.Style.Color {
+    return switch (c.tag) {
+        1 => .palette(c.value.palette),
+        2 => .rgb(.{ .r = c.value.rgb.r, .g = c.value.rgb.g, .b = c.value.rgb.b }),
+        else => .none,
+    };
+}
+
+const sgr_underline = @FieldType(@FieldType(stylepkg.Style, "flags"), "underline");
+
+fn styleFromC(s: style_c.Style) stylepkg.Style {
+    // The C flags are the internal flags (c/style.zig); reserved bits
+    // are dropped and an underline style past the known ones reads as
+    // none, as an export never writes either.
+    const Flags = @FieldType(stylepkg.Style, "flags");
+    var raw: u16 = @bitCast(s.flags);
+    raw &= ~@as(u16, @bitCast(Flags{ ._padding = std.math.maxInt(u3) }));
+    const underline_shift = @bitOffsetOf(Flags, "underline");
+    if (enumFromInt(sgr_underline, (raw >> underline_shift) & 0x7) == null)
+        raw &= ~(@as(u16, 0x7) << underline_shift);
+    const flags: Flags = @bitCast(raw);
+    return .{
+        .fg_color = styleColor(s.fg_color),
+        .bg_color = styleColor(s.bg_color),
+        .underline_color = styleColor(s.underline_color),
+        .flags = flags,
+    };
+}
+
+/// Take the builder's last page off again (an import that failed half
+/// way), as `PageList.destroyNodeExt` frees a resident page.
+fn dropLastPage(builder: *PageList.Builder, page_size: usize, page_serial: u64) void {
+    const node = builder.pages.pop() orelse return;
+    const pool = &builder.pool;
+    const page = node.pageAssumeResident();
+    switch (node.owned) {
+        .pool => {
+            // Pool items are handed out zeroed.
+            @memset(page.memory, 0);
+            pool.pages.destroy(@ptrCast(page.memory.ptr));
+        },
+        .heap => pool.pages.allocator.free(page.memory),
+    }
+    pool.nodes.destroy(node);
+    builder.page_size = page_size;
+    builder.page_serial = page_serial;
+}
+
+fn importRows(
+    imp: *Importer,
+    builder: *PageList.Builder,
+    src: *const CPage,
+    use_hint: bool,
+) (Allocator.Error || error{ Invalid, PageFull })!void {
+    const alloc = imp.alloc;
+    const cap = try capacityFor(src, use_hint);
+    const rows = (src.rows orelse return error.Invalid)[0..src.rows_len];
+    const cells = if (src.cells) |c| c[0..src.cells_len] else &[_]CCell{};
+    const styles = if (src.styles) |s| s[0..src.styles_len] else &[_]style_c.Style{};
+    const links = if (src.links) |l| l[0..src.links_len] else &[_]CLink{};
+    const bytes = if (src.bytes) |b| b[0..src.bytes_len] else &[_]u8{};
+    const graphemes = if (src.graphemes) |g| g[0..src.graphemes_len] else &[_]u32{};
+
+    const size_before = builder.page_size;
+    const serial_before = builder.page_serial;
+    const page = try builder.allocatePage(cap);
+    errdefer dropLastPage(builder, size_before, serial_before);
+    page.size = .{ .cols = src.cols, .rows = @intCast(rows.len) };
+    page.pauseIntegrityChecks(true);
+    defer page.pauseIntegrityChecks(false);
+
+    // Table indexes to page ids. Each table entry holds one reference
+    // while the cells take theirs, released at the end (as
+    // `page.decodePayloadBody`).
+    const style_ids = try alloc.alloc(stylepkg.Id, styles.len);
+    defer alloc.free(style_ids);
+    @memset(style_ids, 0);
+    defer for (style_ids) |id| if (id != 0) page.styles.release(page.memory, id);
+    for (styles, 0..) |s, i| {
+        if (i == 0) continue;
+        const value = styleFromC(s);
+        if (value.default()) continue;
+        style_ids[i] = page.styles.add(page.memory, value) catch return error.PageFull;
+    }
+
+    const link_ids = try alloc.alloc(hyperlink.Id, links.len);
+    defer alloc.free(link_ids);
+    @memset(link_ids, 0);
+    defer for (link_ids) |id| if (id != 0) page.hyperlink_set.release(page.memory, id);
+    for (links, 0..) |l, i| {
+        if (i == 0) continue;
+        if (@as(usize, l.uri_offset) + l.uri_len > bytes.len) return error.Invalid;
+        if (l.explicit_id != 0 and @as(usize, l.id_offset) + l.id_len > bytes.len) return error.Invalid;
+        const link: hyperlink.Hyperlink = .{
+            .uri = bytes[l.uri_offset..][0..l.uri_len],
+            .id = if (l.explicit_id != 0)
+                .{ .explicit = bytes[l.id_offset..][0..l.id_len] }
+            else
+                .{ .implicit = l.implicit_id },
+        };
+        link_ids[i] = page.insertHyperlink(link) catch return error.PageFull;
+    }
+
+    for (rows, 0..) |r, y| {
+        const row = page.getRow(y);
+        row.wrap = r.flags & 0x01 != 0;
+        row.wrap_continuation = r.flags & 0x02 != 0;
+        row.semantic_prompt = enumFromInt(Row.SemanticPrompt, (r.flags >> 2) & 0x3) orelse .none;
+        row.tmux_used = r.used;
+        const dst = page.getCells(row);
+        if (r.cell_count > dst.len) return error.Invalid;
+        if (@as(usize, r.cell_start) + r.cell_count > cells.len) return error.Invalid;
+        for (cells[r.cell_start..][0..r.cell_count], dst[0..r.cell_count]) |c, *cell| {
+            var v: Cell = .{};
+            switch (c.flags & 0x3) {
+                0, 1 => v.content = .{ .codepoint = .{ .data = std.math.cast(u21, c.content) orelse return error.Invalid } },
+                2 => {
+                    v.content_tag = .bg_color_palette;
+                    v.content = .{ .color_palette = .{
+                        .data = @truncate(c.content),
+                        .palette_256 = c.flags & (1 << 5) != 0,
+                    } };
+                },
+                else => {
+                    v.content_tag = .bg_color_rgb;
+                    v.content = .{ .color_rgb = .{
+                        .r = @truncate(c.content >> 16),
+                        .g = @truncate(c.content >> 8),
+                        .b = @truncate(c.content),
+                    } };
+                },
+            }
+            v.wide = enumFromInt(Cell.Wide, (c.flags >> 2) & 0x3) orelse .narrow;
+            v.protected = c.flags & (1 << 4) != 0;
+            v.semantic_content = enumFromInt(Cell.SemanticContent, (c.flags >> 6) & 0x3) orelse .output;
+            v.tab = c.tab;
+            if (c.style != 0) {
+                if (c.style >= style_ids.len) return error.Invalid;
+                const id = style_ids[c.style];
+                if (id != 0) {
+                    page.styles.use(page.memory, id);
+                    v.style_id = id;
+                    row.styled = true;
+                }
+            }
+            if (v.content_tag == .codepoint and
+                v.content.codepoint.data == kitty_virtual_placeholder)
+            {
+                row.kitty_virtual_placeholder = true;
+            }
+            cell.* = v;
+            if (c.link != 0) {
+                if (c.link >= link_ids.len) return error.Invalid;
+                const id = link_ids[c.link];
+                page.hyperlink_set.use(page.memory, id);
+                page.setHyperlink(row, cell, id) catch {
+                    page.hyperlink_set.release(page.memory, id);
+                    return error.PageFull;
+                };
+            }
+        }
+    }
+
+    var i: usize = 0;
+    while (i < graphemes.len) {
+        if (i + 1 >= graphemes.len) return error.Invalid;
+        const index = graphemes[i];
+        const n: usize = graphemes[i + 1];
+        if (n == 0 or n > graphemes.len - i - 2) return error.Invalid;
+        const cps = graphemes[i + 2 ..][0..n];
+        i += 2 + n;
+        // Find the cell's row: rows are in cell order.
+        const y = rowOfCell(rows, index) orelse return error.Invalid;
+        const row = page.getRow(y);
+        const cell = &page.getCells(row)[index - rows[y].cell_start];
+        // Only a cell with a codepoint carries more.
+        if (cell.content_tag != .codepoint and cell.content_tag != .codepoint_grapheme) return error.Invalid;
+        if (cell.content.codepoint.data == 0) return error.Invalid;
+        for (cps) |cp| {
+            const v = std.math.cast(u21, cp) orelse return error.Invalid;
+            page.appendGrapheme(row, cell, v) catch return error.PageFull;
+        }
+    }
+
+    if (imp.check) page.verifyIntegrity(alloc) catch return error.Invalid;
+}
+
+fn rowOfCell(rows: []const CRow, index: u32) ?usize {
+    var lo: usize = 0;
+    var hi: usize = rows.len;
+    while (lo < hi) {
+        const mid = (lo + hi) / 2;
+        const r = rows[mid];
+        if (index < r.cell_start) {
+            hi = mid;
+        } else if (@as(u64, index) >= @as(u64, r.cell_start) + r.cell_count) {
+            lo = mid + 1;
+        } else return mid;
+    }
+    return null;
+}
+
+/// Whether a blob's `Page` value is the one `Page.initBuf` gives for its
+/// capacity over `buf`, but for what changes as the page is used (its
+/// size, dirty flag, allocator search hints and set counters), and those
+/// are in range. `buf` is only used for its address.
+fn blobPageValid(meta: *const Page, buf: []align(std.heap.page_size_min) u8, cols: u16) bool {
+    const cap = meta.capacity;
+    if (cap.cols == 0 or cap.rows == 0) return false;
+    const l = Page.layout(cap);
+    if (l.total_size > size_max_page or l.total_size > buf.len) return false;
+    if (meta.size.cols != cols or meta.size.cols > cap.cols) return false;
+    if (meta.size.rows == 0 or meta.size.rows > cap.rows) return false;
+    const ob: OffsetBuf = .init(buf);
+    var want: Page = .{
+        .memory = meta.memory,
+        .rows = ob.member(Row, l.rows_start),
+        .cells = ob.member(Cell, l.cells_start),
+        .styles = @TypeOf(meta.styles).initAssumeZeroed(ob.add(l.styles_start), l.styles_layout, .{}),
+        .string_alloc = @TypeOf(meta.string_alloc).initAssumeZeroed(
+            ob.add(l.string_alloc_start),
+            l.string_alloc_layout,
+        ),
+        .grapheme_alloc = @TypeOf(meta.grapheme_alloc).initAssumeZeroed(
+            ob.add(l.grapheme_alloc_start),
+            l.grapheme_alloc_layout,
+        ),
+        .grapheme_map = @TypeOf(meta.grapheme_map).initAssumeZeroed(
+            ob.add(l.grapheme_map_start),
+            l.grapheme_map_layout,
+        ),
+        .hyperlink_map = @TypeOf(meta.hyperlink_map).initAssumeZeroed(
+            ob.add(l.hyperlink_map_start),
+            l.hyperlink_map_layout,
+        ),
+        .hyperlink_set = @TypeOf(meta.hyperlink_set).initAssumeZeroed(
+            ob.add(l.hyperlink_set_start),
+            l.hyperlink_set_layout,
+            .{},
+        ),
+        .size = meta.size,
+        .capacity = cap,
+        .dirty = meta.dirty,
+    };
+    want.pause_integrity_checks = meta.pause_integrity_checks;
+    want.string_alloc.search_start = meta.string_alloc.search_start;
+    want.grapheme_alloc.search_start = meta.grapheme_alloc.search_start;
+    inline for (.{ "styles", "hyperlink_set" }) |name| {
+        const got = &@field(meta, name);
+        const set = &@field(want, name);
+        if (got.next_id == 0 or got.next_id > got.layout.cap) return false;
+        if (got.living > got.layout.cap or got.max_psl >= got.psl_stats.len) return false;
+        set.max_psl = got.max_psl;
+        set.psl_stats = got.psl_stats;
+        set.living = got.living;
+        set.next_id = got.next_id;
+    }
+    return std.meta.eql(want, meta.*);
+}
+
+fn importBlob(
+    imp: *Importer,
+    builder: *PageList.Builder,
+    src: *const CPage,
+    cols: u16,
+) error{ OutOfMemory, Invalid }!void {
+    const bytes = (src.bytes orelse return error.Invalid)[0..src.bytes_len];
+    if (bytes.len < @sizeOf(BlobHeader) + @sizeOf(Page)) return error.Invalid;
+    var header: BlobHeader = undefined;
+    @memcpy(std.mem.asBytes(&header), bytes[0..@sizeOf(BlobHeader)]);
+    if (header.magic != blob_magic or header.page_size != @sizeOf(Page)) return error.Invalid;
+    const rest = bytes[@sizeOf(BlobHeader)..];
+    if (rest.len - @sizeOf(Page) != header.encoded_len) return error.Invalid;
+    // Nothing of the page is read before its bytes are known to be the
+    // ones exported: a `Page` value from anywhere else is not one.
+    if (blobChecksum(rest[0..@sizeOf(Page)], rest[@sizeOf(Page)..]) != header.checksum) return error.Invalid;
+    var meta: Page = undefined;
+    @memcpy(std.mem.asBytes(&meta), rest[0..@sizeOf(Page)]);
+    const encoded = rest[@sizeOf(Page)..];
+    const len: usize = std.math.cast(usize, header.memory_len) orelse return error.Invalid;
+    if (len != Page.layout(meta.capacity).total_size) return error.Invalid;
+    const heap = header.heap != 0;
+    const std_size = Page.layout(pagepkg.std_capacity).total_size;
+    if (!heap and len > std_size) return error.Invalid;
+
+    // As `PageList.cloneCompressedNode`: fresh backing memory of the same
+    // kind, never touched until the page is first read and decoded.
+    const pool = &builder.pool;
+    const node = try pool.nodes.create();
+    errdefer pool.nodes.destroy(node);
+    const buf: []align(std.heap.page_size_min) u8 = if (heap)
+        try pool.pages.allocator.alignedAlloc(u8, .fromByteUnits(std.heap.page_size_min), len)
+    else
+        try pool.pages.create();
+    errdefer if (heap) pool.pages.allocator.free(buf) else pool.pages.destroy(@ptrCast(buf.ptr));
+    if (!blobPageValid(&meta, buf, cols)) return error.Invalid;
+    const encoded_alloc = if (builtin.is_test) pool.alloc else pool.pages.allocator;
+    const owned_encoded = try encoded_alloc.dupe(u8, encoded);
+    errdefer encoded_alloc.free(owned_encoded);
+    meta.memory = buf[0..len];
+    const compressed: compression.Page = .{ .page = meta, .encoded = owned_encoded, .alloc = encoded_alloc };
+    if (imp.check) {
+        // Decode it into scratch memory now, as its first read would.
+        const scratch = try std.heap.page_allocator.alignedAlloc(
+            u8,
+            .fromByteUnits(std.heap.page_size_min),
+            len,
+        );
+        defer std.heap.page_allocator.free(scratch);
+        const p = compressed.cloneBuf(scratch) catch return error.Invalid;
+        p.verifyIntegrity(imp.alloc) catch return error.Invalid;
+    }
+    node.* = .{
+        .data = .{ .compressed = compressed },
+        .serial = builder.page_serial,
+        .owned = if (heap) .heap else .pool,
+    };
+    builder.page_serial += 1;
+    builder.page_size += buf.len;
+    builder.pages.append(node);
+}
+
+pub fn importer_finish(
+    imp_: CImporter,
+    state_: ?*const CState,
+) callconv(lib.calling_conv) Result {
+    const imp = imp_ orelse return .invalid_value;
+    defer imp.deinit();
+    const state = state_ orelse return .invalid_value;
+    if (state.size < @sizeOf(CState)) return .invalid_value;
+    const wrapper = imp.wrapper;
+    const t = wrapper.terminal;
+    if (state.cols != t.cols or state.rows != t.rows) return .invalid_value;
+    if (wrapper.tracked_grid_refs.count() != 0) return .invalid_value;
+    if (imp.builders[0] == null) return .invalid_value;
+    if (state.screens[1].present != (imp.builders[1] != null)) return .invalid_value;
+    if (!stateValid(state, t.cols, t.rows)) return .invalid_value;
+    finish(imp, state) catch |err| return switch (err) {
+        error.OutOfMemory => .out_of_memory,
+        else => .invalid_value,
+    };
+    return .success;
+}
+
+/// Whether `finish` can apply the state as it is: what it would clamp or
+/// map to a default is refused instead, so nothing changes on a bad one.
+fn stateValid(s: *const CState, cols: u16, rows: u16) bool {
+    if (s.scroll_top > s.scroll_bottom or s.scroll_bottom >= rows) return false;
+    if (s.scroll_left > s.scroll_right or s.scroll_right >= cols) return false;
+    if (s.previous_char != 0xffffffff) {
+        const c = std.math.cast(u21, s.previous_char) orelse return false;
+        if (!std.unicode.utf8ValidCodepoint(c)) return false;
+    }
+    const bytes_len = if (s.bytes == null) 0 else s.bytes_len;
+    for (s.screens) |screen| {
+        if (!screen.present) continue;
+        if (screen.cursor_x >= cols or screen.cursor_y >= rows) return false;
+        if (screen.link_kind > 2) return false;
+        if (screen.link_kind != 0) {
+            if (screen.link_uri_len == 0) return false;
+            if (@as(usize, screen.link_uri_offset) + screen.link_uri_len > bytes_len) return false;
+        }
+        if (screen.link_kind == 2 and
+            @as(usize, screen.link_id_offset) + screen.link_id_len > bytes_len) return false;
+    }
+    return true;
+}
+
+fn finish(imp: *Importer, state: *const CState) !void {
+    const t = imp.wrapper.terminal;
+    const io = t.screens.get(.primary).?.io;
+    const bytes = if (state.bytes) |b| b[0..state.bytes_len] else &[_]u8{};
+
+    // Build both page lists before changing anything.
+    var lists: [2]?PageList = .{ null, null };
+    errdefer for (&lists) |*l| if (l.*) |*list| list.deinit();
+    for (&imp.builders, 0..) |*b, i| {
+        if (b.*) |*builder| lists[i] = try builder.finish();
+    }
+
+    if (lists[1] != null) {
+        _ = try t.screens.getInit(io, imp.alloc, .alternate, .{
+            .cols = t.cols,
+            .rows = t.rows,
+            .max_scrollback_bytes = 0,
+        });
+    }
+
+    for (&lists, 0..) |*l, i| {
+        var list = l.* orelse continue;
+        l.* = null;
+        const screen = t.screens.get(screenKey(@intCast(i)).?).?;
+        list.limits = screen.pages.limits;
+        try installScreen(screen, list, &state.screens[i], bytes);
+    }
+
+    applyTerminal(t, state);
+    t.screens.switchTo(if (state.active_screen == 1 and t.screens.get(.alternate) != null)
+        .alternate
+    else
+        .primary);
+    t.flags.dirty.clear = true;
+}
+
+fn charsetFromC(c: CCharset) Screen.CharsetState {
+    var result: Screen.CharsetState = .{};
+    result.charsets.set(.G0, enumFromInt(charsets.Charset, c.g[0]) orelse .utf8);
+    result.charsets.set(.G1, enumFromInt(charsets.Charset, c.g[1]) orelse .utf8);
+    result.charsets.set(.G2, enumFromInt(charsets.Charset, c.g[2]) orelse .utf8);
+    result.charsets.set(.G3, enumFromInt(charsets.Charset, c.g[3]) orelse .utf8);
+    result.gl = enumFromInt(charsets.Slots, c.gl) orelse .G0;
+    result.gr = enumFromInt(charsets.Slots, c.gr) orelse .G2;
+    result.single_shift = if (c.single_shift == 0xff) null else enumFromInt(charsets.Slots, c.single_shift);
+    return result;
+}
+
+fn charsetToC(s: Screen.CharsetState) CCharset {
+    return .{
+        .g = .{
+            enumByte(s.charsets.get(.G0)),
+            enumByte(s.charsets.get(.G1)),
+            enumByte(s.charsets.get(.G2)),
+            enumByte(s.charsets.get(.G3)),
+        },
+        .gl = enumByte(s.gl),
+        .gr = enumByte(s.gr),
+        .single_shift = if (s.single_shift) |slot| enumByte(slot) else 0xff,
+    };
+}
+
+/// Replace `screen`'s pages with `list` and set its cursor and the rest
+/// of its state, as `snapshot/screen.zig` `decode` assembles a screen.
+fn installScreen(
+    screen: *Screen,
+    list: PageList,
+    s: *const CScreenState,
+    bytes: []const u8,
+) !void {
+    var pages = list;
+    // Locate the cursor before anything is replaced.
+    const y = @min(s.cursor_y, pages.rows - 1);
+    const row_pin = pages.pin(.{ .active = .{ .y = y } }) orelse return error.Invalid;
+    const x = @min(s.cursor_x, row_pin.node.cols() - 1);
+    const pin = try pages.trackPin(.{ .node = row_pin.node, .x = x, .y = row_pin.y });
+    var link: ?struct { uri: []const u8, id: ?[]const u8 } = null;
+    if (s.link_kind != 0) {
+        if (@as(usize, s.link_uri_offset) + s.link_uri_len > bytes.len) return error.Invalid;
+        const uri = bytes[s.link_uri_offset..][0..s.link_uri_len];
+        var id: ?[]const u8 = null;
+        if (s.link_kind == 2) {
+            if (@as(usize, s.link_id_offset) + s.link_id_len > bytes.len) return error.Invalid;
+            id = bytes[s.link_id_offset..][0..s.link_id_len];
+        }
+        link = .{ .uri = uri, .id = id };
+    }
+
+    // No fallible step until the cursor's style and link below.
+    screen.endHyperlink();
+    screen.cursor.style_id = stylepkg.default_id;
+    screen.pages.deinit();
+    screen.pages = pages;
+    screen.selection = null;
+    const rac = pin.rowAndCell();
+    screen.cursor.x = x;
+    screen.cursor.y = y;
+    screen.cursor.page_pin = pin;
+    screen.cursor.page_row = rac.row;
+    screen.cursor.page_cell = rac.cell;
+    screen.cursor.cursor_style = enumFromInt(Screen.CursorStyle, s.cursor_style) orelse .block;
+    // As it was, even off the last column (a resize can leave it so).
+    screen.cursor.pending_wrap = s.pending_wrap;
+    screen.cursor.protected = s.protected_;
+    screen.cursor.semantic_content = enumFromInt(Cell.SemanticContent, s.semantic_content) orelse .output;
+    screen.cursor.semantic_content_clear_eol = s.semantic_content_clear_eol;
+    screen.cursor.style = styleFromC(s.pen);
+    screen.charset = charsetFromC(s.charset);
+    screen.protected_mode = enumFromInt(@TypeOf(screen.protected_mode), s.protected_mode) orelse .off;
+    screen.kitty_keyboard.idx = @intCast(s.kitty_index & 7);
+    for (&screen.kitty_keyboard.flags, s.kitty_flags) |*f, raw| {
+        f.* = @bitCast(@as(u5, @truncate(raw)));
+    }
+    screen.semantic_prompt.click = click: {
+        const Kind = Screen.SemanticPrompt.SemanticClickKind;
+        const kind = enumFromInt(Kind, s.semantic_click_kind) orelse break :click .none;
+        break :click switch (kind) {
+            .none => .none,
+            .click_events => .{ .click_events = enumFromInt(
+                @FieldType(Screen.SemanticPrompt.SemanticClick, "click_events"),
+                s.semantic_click_value,
+            ) orelse break :click .none },
+            .cl => .{ .cl = enumFromInt(
+                @FieldType(Screen.SemanticPrompt.SemanticClick, "cl"),
+                s.semantic_click_value,
+            ) orelse break :click .none },
+        };
+    };
+    screen.saved_cursor = if (s.saved_present) .{
+        .x = @min(s.saved_x, pages.cols - 1),
+        .y = @min(s.saved_y, pages.rows - 1),
+        .style = styleFromC(s.saved_pen),
+        .protected = s.saved_protected,
+        .pending_wrap = s.saved_pending_wrap,
+        .origin = s.saved_origin,
+        .charset = charsetFromC(s.saved_charset),
+    } else null;
+
+    try screen.manualStyleUpdate();
+    if (link) |l| {
+        if (l.id) |id| {
+            try screen.startHyperlink(l.uri, id);
+        } else {
+            screen.cursor.hyperlink_implicit_id = s.link_implicit_id;
+            try screen.startHyperlink(l.uri, null);
+        }
+    }
+    screen.cursor.hyperlink_implicit_id = s.hyperlink_implicit_counter;
+    screen.semantic_prompt.seen = screen.cursor.semantic_content != .output or
+        anyPrompt(&screen.pages);
+    screen.pages.assertIntegrity();
+    screen.assertIntegrity();
+}
+
+fn anyPrompt(pages: *PageList) bool {
+    var node = pages.pages.first;
+    while (node) |n| : (node = n.next) {
+        const page = switch (n.data) {
+            .resident => |*p| p,
+            // Compressed pages are not read for a derived flag.
+            .compressed => continue,
+        };
+        for (0..page.size.rows) |y| {
+            const row = page.getRow(y);
+            if (row.semantic_prompt != .none) return true;
+            for (page.getCells(row)) |cell| {
+                if (cell.semantic_content == .prompt) return true;
+            }
+        }
+    }
+    return false;
+}
+
+fn applyTerminal(t: *ZigTerminal, s: *const CState) void {
+    t.scrolling_region = .{
+        .top = @min(s.scroll_top, t.rows - 1),
+        .bottom = @min(s.scroll_bottom, t.rows - 1),
+        .left = @min(s.scroll_left, t.cols - 1),
+        .right = @min(s.scroll_right, t.cols - 1),
+    };
+    t.status_display = enumFromInt(@TypeOf(t.status_display), s.status_display) orelse .main;
+    t.previous_char = if (s.previous_char == 0xffffffff)
+        null
+    else
+        std.math.cast(u21, s.previous_char);
+    t.cursor.is_default = s.cursor_is_default;
+    t.cursor.default_style = enumFromInt(Screen.CursorStyle, s.cursor_default_style) orelse .block;
+    t.cursor.default_blink = switch (s.cursor_default_blink) {
+        1 => false,
+        2 => true,
+        else => null,
+    };
+    t.flags.shell_redraws_prompt = enumFromInt(@TypeOf(t.flags.shell_redraws_prompt), s.shell_redraw) orelse .true;
+    t.flags.modify_other_keys_2 = s.modify_other_keys_2;
+    t.flags.mouse_event = enumFromInt(@TypeOf(t.flags.mouse_event), s.mouse_event) orelse .none;
+    t.flags.mouse_format = enumFromInt(@TypeOf(t.flags.mouse_format), s.mouse_format) orelse .x10;
+    t.flags.mouse_shift_capture = switch (s.mouse_shift_capture) {
+        1 => .false,
+        2 => .true,
+        else => .null,
+    };
+    t.mouse_shape = enumFromInt(@TypeOf(t.mouse_shape), s.mouse_shape) orelse .text;
+    t.flags.password_input = s.password_input;
+    t.flags.xt_checksum = @bitCast(@as(u5, @truncate(s.xt_checksum)));
+
+    for (s.modes[0..@min(s.modes_len, max_modes)]) |m| {
+        const mode = modespkg.modeFromInt(m.value, m.ansi) orelse continue;
+        setMode(&t.modes, mode, m.current, m.saved, m.default_);
+    }
+
+    t.tabstops.reset(0);
+    for (0..t.cols) |col| {
+        if (col / 8 >= max_tabstop_bytes) break;
+        if (s.tabstops[col / 8] & (@as(u8, 1) << @intCast(col % 8)) != 0) t.tabstops.set(col);
+    }
+
+    for (0..256) |i| {
+        if (s.palette_mask[i / 8] & (@as(u8, 1) << @intCast(i % 8)) != 0) {
+            t.colors.palette.set(@intCast(i), .{
+                .r = s.palette[i * 3],
+                .g = s.palette[i * 3 + 1],
+                .b = s.palette[i * 3 + 2],
+            });
+        }
+    }
+    t.colors.foreground.override = if (s.fg_set) .{ .r = s.fg[0], .g = s.fg[1], .b = s.fg[2] } else null;
+    t.colors.background.override = if (s.bg_set) .{ .r = s.bg[0], .g = s.bg[1], .b = s.bg[2] } else null;
+    t.colors.cursor.override = if (s.cursor_color_set)
+        .{ .r = s.cursor_color[0], .g = s.cursor_color[1], .b = s.cursor_color[2] }
+    else
+        null;
+    t.flags.dirty.palette = true;
+}
+
+fn setMode(state: *modespkg.ModeState, mode: modespkg.Mode, current: bool, saved: bool, default: bool) void {
+    switch (mode) {
+        inline else => |tag| {
+            const name = @tagName(tag);
+            @field(state.values, name) = current;
+            @field(state.saved, name) = saved;
+            @field(state.default, name) = default;
+        },
+    }
+}
+
+// ---------------------------------------------------------------------
+// State export
+
+pub fn state_export(
+    terminal_: terminal_c.Terminal,
+    out_: ?*CState,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (out.size < @sizeOf(CState)) return .invalid_value;
+    const t = wrapper.terminal;
+    var bytes: Out(u8) = .{ .ptr = out.bytes, .cap = out.bytes_cap };
+
+    out.cols = t.cols;
+    out.rows = t.rows;
+    out.active_screen = if (t.screens.active_key == .alternate) 1 else 0;
+    out.scroll_top = t.scrolling_region.top;
+    out.scroll_bottom = t.scrolling_region.bottom;
+    out.scroll_left = t.scrolling_region.left;
+    out.scroll_right = t.scrolling_region.right;
+    out.status_display = enumByte(t.status_display);
+    out.previous_char = if (t.previous_char) |c| c else 0xffffffff;
+    out.cursor_is_default = t.cursor.is_default;
+    out.cursor_default_style = enumByte(t.cursor.default_style);
+    out.cursor_default_blink = if (t.cursor.default_blink) |b| (if (b) 2 else 1) else 0;
+    out.shell_redraw = enumByte(t.flags.shell_redraws_prompt);
+    out.modify_other_keys_2 = t.flags.modify_other_keys_2;
+    out.mouse_event = enumByte(t.flags.mouse_event);
+    out.mouse_format = enumByte(t.flags.mouse_format);
+    out.mouse_shift_capture = switch (t.flags.mouse_shift_capture) {
+        .null => 0,
+        .false => 1,
+        .true => 2,
+    };
+    out.mouse_shape = enumByte(t.mouse_shape);
+    out.password_input = t.flags.password_input;
+    out.xt_checksum = @as(u5, @bitCast(t.flags.xt_checksum));
+
+    out.modes_len = 0;
+    inline for (@typeInfo(modespkg.Mode).@"enum".field_names) |name| {
+        const mode: modespkg.Mode = @field(modespkg.Mode, name);
+        const tag = modespkg.ModeTag.fromMode(mode);
+        out.modes[out.modes_len] = .{
+            .value = tag.value,
+            .ansi = tag.ansi,
+            .current = @field(t.modes.values, name),
+            .saved = @field(t.modes.saved, name),
+            .default_ = @field(t.modes.default, name),
+        };
+        out.modes_len += 1;
+    }
+
+    @memset(&out.tabstops, 0);
+    for (0..t.cols) |col| {
+        if (col / 8 >= max_tabstop_bytes) break;
+        if (t.tabstops.get(col)) out.tabstops[col / 8] |= @as(u8, 1) << @intCast(col % 8);
+    }
+
+    @memset(&out.palette_mask, 0);
+    for (0..256) |i| {
+        const c = t.colors.palette.current[i];
+        out.palette[i * 3] = c.r;
+        out.palette[i * 3 + 1] = c.g;
+        out.palette[i * 3 + 2] = c.b;
+        if (t.colors.palette.mask.isSet(i)) out.palette_mask[i / 8] |= @as(u8, 1) << @intCast(i % 8);
+    }
+    out.fg_set = t.colors.foreground.override != null;
+    out.fg = rgbBytes(t.colors.foreground.override);
+    out.bg_set = t.colors.background.override != null;
+    out.bg = rgbBytes(t.colors.background.override);
+    out.cursor_color_set = t.colors.cursor.override != null;
+    out.cursor_color = rgbBytes(t.colors.cursor.override);
+
+    for (&out.screens, 0..) |*s, i| {
+        const screen = screenOf(t, @intCast(i)) orelse {
+            s.* = std.mem.zeroes(CScreenState);
+            s.pen = .default;
+            s.saved_pen = .default;
+            continue;
+        };
+        exportScreen(screen, s, &bytes);
+    }
+    out.bytes_len = bytes.len;
+    return if (bytes.fits()) .success else .out_of_space;
+}
+
+fn rgbBytes(c: anytype) [3]u8 {
+    const v = c orelse return .{ 0, 0, 0 };
+    return .{ v.r, v.g, v.b };
+}
+
+fn exportScreen(screen: *const Screen, s: *CScreenState, bytes: *Out(u8)) void {
+    const c = &screen.cursor;
+    s.* = std.mem.zeroes(CScreenState);
+    s.present = true;
+    s.cursor_x = c.x;
+    s.cursor_y = c.y;
+    s.cursor_style = enumByte(c.cursor_style);
+    s.pending_wrap = c.pending_wrap;
+    s.protected_ = c.protected;
+    s.semantic_content = @backingInt(c.semantic_content);
+    s.semantic_content_clear_eol = c.semantic_content_clear_eol;
+    s.pen = .fromStyle(c.style);
+    if (c.hyperlink) |link| {
+        s.link_uri_offset = @intCast(bytes.len);
+        s.link_uri_len = @intCast(link.uri.len);
+        bytes.pushSlice(link.uri);
+        switch (link.id) {
+            .implicit => |v| {
+                s.link_kind = 1;
+                s.link_implicit_id = v;
+            },
+            .explicit => |id| {
+                s.link_kind = 2;
+                s.link_id_offset = @intCast(bytes.len);
+                s.link_id_len = @intCast(id.len);
+                bytes.pushSlice(id);
+            },
+        }
+    }
+    s.hyperlink_implicit_counter = c.hyperlink_implicit_id;
+    s.charset = charsetToC(screen.charset);
+    s.protected_mode = enumByte(screen.protected_mode);
+    s.kitty_index = screen.kitty_keyboard.idx;
+    for (screen.kitty_keyboard.flags, &s.kitty_flags) |f, *raw| {
+        raw.* = @as(u5, @bitCast(f));
+    }
+    switch (screen.semantic_prompt.click) {
+        .none => {},
+        .click_events => |v| {
+            s.semantic_click_kind = 1;
+            s.semantic_click_value = enumByte(v);
+        },
+        .cl => |v| {
+            s.semantic_click_kind = 2;
+            s.semantic_click_value = enumByte(v);
+        },
+    }
+    s.saved_pen = .default;
+    if (screen.saved_cursor) |saved| {
+        s.saved_present = true;
+        s.saved_x = saved.x;
+        s.saved_y = saved.y;
+        s.saved_pen = .fromStyle(saved.style);
+        s.saved_protected = saved.protected;
+        s.saved_pending_wrap = saved.pending_wrap;
+        s.saved_origin = saved.origin;
+        s.saved_charset = charsetToC(saved.charset);
+    }
+}
+
+pub fn set_active_screen(
+    terminal_: terminal_c.Terminal,
+    screen_key: u8,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const key = screenKey(screen_key) orelse return .invalid_value;
+    if (wrapper.terminal.screens.get(key) == null) return .no_value;
+    wrapper.terminal.screens.switchTo(key);
+    wrapper.terminal.flags.dirty.clear = true;
+    return .success;
+}
