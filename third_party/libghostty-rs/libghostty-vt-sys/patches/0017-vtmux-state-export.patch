+test "vtmux state: malformed pages and states are refused" {
+    const testing = std.testing;
+    var b: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(null, &b, 10, 3));
+    defer terminal_c.free(b);
+    var imp: CImporter = null;
+    try testing.expectEqual(Result.success, importer_new(b, true, &imp));
+
+    var rows = [_]CRow{
+        .{ .cell_start = 0, .cell_count = 1, .used = 1, .flags = 0 },
+        .{ .cell_start = 1, .cell_count = 0, .used = 0, .flags = 0 },
+        .{ .cell_start = 1, .cell_count = 0, .used = 0, .flags = 0 },
+    };
+    var cells = [_]CCell{.{ .content = 'e', .style = 0, .link = 0, .flags = 1, .tab = 0 }};
+    // A wild count of codepoints after the first: it once overflowed the
+    // capacity's sum.
+    var graphemes = [_]u32{ 0, 0xffffffff, 0x301 };
+    var styles = [_]style_c.Style{.default};
+    var links = [_]CLink{std.mem.zeroes(CLink)};
+    var page: CPage = .{
+        .size = @sizeOf(CPage),
+        .rows = &rows,
+        .rows_cap = rows.len,
+        .rows_len = rows.len,
+        .cells = &cells,
+        .cells_cap = cells.len,
+        .cells_len = cells.len,
+        .graphemes = &graphemes,
+        .graphemes_cap = graphemes.len,
+        .graphemes_len = graphemes.len,
+        .styles = &styles,
+        .styles_cap = styles.len,
+        .styles_len = styles.len,
+        .links = &links,
+        .links_cap = links.len,
+        .links_len = links.len,
+        .bytes = null,
+        .bytes_cap = 0,
+        .bytes_len = 0,
+        .cols = 10,
+        .blob = false,
+        .capacity = .{},
+    };
+    try testing.expectEqual(Result.invalid_value, importer_page(imp, 0, &page));
+    graphemes[1] = 1;
+    // Another width than the terminal's.
+    page.cols = 11;
+    try testing.expectEqual(Result.invalid_value, importer_page(imp, 0, &page));
+    // A capacity over the page limit.
+    page.cols = 10;
+    page.capacity = .{ .rows = 0xffff, .styles = 0xffff, .hyperlink_bytes = 0xffff, .grapheme_bytes = 0xffffffff, .string_bytes = 0xffffffff };
+    try testing.expectEqual(Result.invalid_value, importer_page(imp, 0, &page));
+    page.capacity = .{};
+    try testing.expectEqual(Result.success, importer_page(imp, 0, &page));
+
+    var state: CState = undefined;
+    state.size = @sizeOf(CState);
+    state.bytes = null;
+    state.bytes_cap = 0;
+    try testing.expectEqual(Result.success, state_export(b, &state));
+    // A scroll region whose top is below its bottom.
+    state.scroll_top = 2;
+    state.scroll_bottom = 1;
+    try testing.expectEqual(Result.invalid_value, importer_finish(imp, &state));
+}
