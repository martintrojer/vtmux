diff --git a/include/ghostty/vt/vtmux_state.h b/include/ghostty/vt/vtmux_state.h
new file mode 100644
index 000000000..adcc99d2d
--- /dev/null
+++ b/include/ghostty/vt/vtmux_state.h
@@ -0,0 +1,325 @@
+/**
+ * @file vtmux_state.h
+ *
+ * vtmux: export and import the whole state of a terminal.
+ *
+ * Every page of both screens comes out as rows of cells (or, for a page
+ * compressed in memory, as an opaque blob only a library of the same build
+ * can read back), together with the terminal and screen state that is not
+ * in the grid. A fresh terminal of the same size imports it and is then
+ * the same terminal: same cells, row flags, cursor, modes, charsets, tab
+ * stops, scroll region, colours.
+ *
+ * The cell and row records are this header's own: they are filled through
+ * the page's accessors, never copied from Ghostty's memory layout, so they
+ * keep their meaning when Ghostty's layout changes. Only blobs are tied to
+ * the build that wrote them.
+ */
+
+#ifndef GHOSTTY_VT_VTMUX_STATE_H
+#define GHOSTTY_VT_VTMUX_STATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <ghostty/vt/types.h>
+#include <ghostty/vt/style.h>
+#include <ghostty/vt/terminal.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** Screen keys: 0 primary, 1 alternate. */
+#define GHOSTTY_VTMUX_PRIMARY 0
+#define GHOSTTY_VTMUX_ALTERNATE 1
+
+/** Row flags. Bits 2-3 are the row's semantic prompt (0 none, 1 prompt,
+ * 2 prompt continuation). */
+#define GHOSTTY_VTMUX_ROW_WRAP 0x01
+#define GHOSTTY_VTMUX_ROW_WRAP_CONTINUATION 0x02
+
+/**
+ * One row. Its cells are `cells[cell_start .. cell_start + cell_count]`
+ * of the page; the row's remaining columns are default cells (all zero).
+ */
+typedef struct {
+  uint32_t cell_start;
+  uint16_t cell_count;
+  /** tmux's cells used (`Row.tmux_used`, patch 0013). */
+  uint16_t used;
+  uint8_t flags;
+  uint8_t reserved[3];
+} GhosttyVtmuxRow;
+
+/**
+ * One cell.
+ *
+ * flags: bits 0-1 the content kind (0 a codepoint, 1 a codepoint with more
+ * codepoints in the page's graphemes, 2 a palette background with no text,
+ * 3 an RGB background with no text), bits 2-3 the width (0 narrow, 1 wide,
+ * 2 spacer tail, 3 spacer head), bit 4 protected, bit 5 the palette
+ * background in its 256-colour form (patch 0010), bits 6-7 the semantic
+ * content (0 output, 1 input, 2 prompt).
+ *
+ * content: the codepoint (kinds 0 and 1), the palette index (kind 2) or
+ * 0xRRGGBB (kind 3). style and link index the page's tables; 0 is the
+ * default style and no link. tab is the tab mark (patch 0002).
+ */
+typedef struct {
+  uint32_t content;
+  uint16_t style;
+  uint16_t link;
+  uint16_t flags;
+  uint8_t tab;
+  uint8_t reserved;
+} GhosttyVtmuxCell;
+
+/**
+ * A hyperlink: the URI and, when explicit, the OSC 8 id, as offsets into
+ * the page's bytes; an implicit link has Ghostty's implicit id instead.
+ */
+typedef struct {
+  uint32_t uri_offset;
+  uint32_t uri_len;
+  uint32_t id_offset;
+  uint32_t id_len;
+  uint32_t implicit_id;
+  uint8_t explicit_id;
+  uint8_t reserved[3];
+} GhosttyVtmuxLink;
+
+/** A page's allocation sizes: hints, all zero when unknown. */
+typedef struct {
+  uint32_t rows;
+  uint32_t styles;
+  uint32_t hyperlink_bytes;
+  uint32_t grapheme_bytes;
+  uint32_t string_bytes;
+} GhosttyVtmuxCapacity;
+
+/**
+ * One page: a run of rows of one width, or a compressed page's blob.
+ *
+ * Export: the caller sets `size`, the buffers and their capacities; each
+ * `*_len` comes back as the count needed, and if any is over its capacity
+ * the call returns GHOSTTY_OUT_OF_SPACE and the caller grows the buffers
+ * and calls again. Import: the `*_len` say how much of each buffer holds
+ * the page; capacities are ignored.
+ *
+ * graphemes: for every cell of kind 1, in cell order, the cell's index in
+ * `cells`, the number of codepoints after the first, then those codepoints.
+ * styles: entry 0 is unused. links: entry 0 is unused. bytes: the links'
+ * strings, or the blob.
+ */
+typedef struct {
+  size_t size;
+  GhosttyVtmuxRow* rows;
+  size_t rows_cap;
+  size_t rows_len;
+  GhosttyVtmuxCell* cells;
+  size_t cells_cap;
+  size_t cells_len;
+  uint32_t* graphemes;
+  size_t graphemes_cap;
+  size_t graphemes_len;
+  GhosttyStyle* styles;
+  size_t styles_cap;
+  size_t styles_len;
+  GhosttyVtmuxLink* links;
+  size_t links_cap;
+  size_t links_len;
+  uint8_t* bytes;
+  size_t bytes_cap;
+  size_t bytes_len;
+  uint16_t cols;
+  /** The page is a blob: `bytes` holds it and nothing else is set. */
+  bool blob;
+  GhosttyVtmuxCapacity capacity;
+} GhosttyVtmuxPage;
+
+/** G0-G3 (0 UTF-8, 1 ASCII, 2 British, 3 DEC special graphics), GL and GR
+ * (slot numbers), and the single shift (0xff for none). */
+typedef struct {
+  uint8_t g[4];
+  uint8_t gl;
+  uint8_t gr;
+  uint8_t single_shift;
+  uint8_t reserved;
+} GhosttyVtmuxCharset;
+
+/** One screen's state outside its grid. */
+typedef struct {
+  bool present;
+  uint16_t cursor_x;
+  uint16_t cursor_y;
+  uint8_t cursor_style;
+  bool pending_wrap;
+  bool protected_;
+  uint8_t semantic_content;
+  bool semantic_content_clear_eol;
+  GhosttyStyle pen;
+  /** The cursor's hyperlink: 0 none, 1 implicit, 2 explicit. Its URI and
+   * explicit id are in the state's bytes. */
+  uint8_t link_kind;
+  uint32_t link_implicit_id;
+  uint32_t link_uri_offset;
+  uint32_t link_uri_len;
+  uint32_t link_id_offset;
+  uint32_t link_id_len;
+  /** The next implicit hyperlink id. */
+  uint32_t hyperlink_implicit_counter;
+  GhosttyVtmuxCharset charset;
+  uint8_t protected_mode;
+  uint8_t kitty_flags[8];
+  uint8_t kitty_index;
+  uint8_t semantic_click_kind;
+  uint8_t semantic_click_value;
+  bool saved_present;
+  uint16_t saved_x;
+  uint16_t saved_y;
+  GhosttyStyle saved_pen;
+  bool saved_protected;
+  bool saved_pending_wrap;
+  bool saved_origin;
+  GhosttyVtmuxCharset saved_charset;
+} GhosttyVtmuxScreenState;
+
+/** One mode: its number, whether it is an ANSI mode, and its current,
+ * saved (XTSAVE) and default values. */
+typedef struct {
+  uint16_t value;
+  bool ansi;
+  bool current;
+  bool saved;
+  bool default_;
+} GhosttyVtmuxMode;
+
+#define GHOSTTY_VTMUX_MAX_MODES 96
+#define GHOSTTY_VTMUX_MAX_TABSTOP_BYTES 8192
+
+/**
+ * The terminal's state outside its grids.
+ *
+ * Export fills everything; `bytes` (the cursors' hyperlink strings) works
+ * as in GhosttyVtmuxPage. Import applies everything but the size, which
+ * must be the terminal's, and `modes` entries whose number Ghostty does
+ * not know are ignored. Title and working directory have their own
+ * terminal options.
+ */
+typedef struct {
+  size_t size;
+  uint16_t cols;
+  uint16_t rows;
+  uint8_t active_screen;
+  uint16_t scroll_top;
+  uint16_t scroll_bottom;
+  uint16_t scroll_left;
+  uint16_t scroll_right;
+  uint8_t status_display;
+  /** 0xffffffff for none. */
+  uint32_t previous_char;
+  bool cursor_is_default;
+  uint8_t cursor_default_style;
+  /** 0 unset, 1 false, 2 true. */
+  uint8_t cursor_default_blink;
+  uint8_t shell_redraw;
+  bool modify_other_keys_2;
+  uint8_t mouse_event;
+  uint8_t mouse_format;
+  /** 0 unset, 1 false, 2 true. */
+  uint8_t mouse_shift_capture;
+  uint8_t mouse_shape;
+  bool password_input;
+  uint8_t xt_checksum;
+  size_t modes_len;
+  GhosttyVtmuxMode modes[GHOSTTY_VTMUX_MAX_MODES];
+  /** One bit per column, least significant first. */
+  uint8_t tabstops[GHOSTTY_VTMUX_MAX_TABSTOP_BYTES];
+  /** Palette entries changed from the default (bit n of byte n / 8), and
+   * the current palette, RGB. */
+  uint8_t palette_mask[32];
+  uint8_t palette[256 * 3];
+  /** Foreground, background and cursor colour overrides (OSC 10/11/12). */
+  bool fg_set;
+  uint8_t fg[3];
+  bool bg_set;
+  uint8_t bg[3];
+  bool cursor_color_set;
+  uint8_t cursor_color[3];
+  GhosttyVtmuxScreenState screens[2];
+  uint8_t* bytes;
+  size_t bytes_cap;
+  size_t bytes_len;
+} GhosttyVtmuxState;
+
+/** An import in progress. */
+typedef struct GhosttyVtmuxImporterImpl* GhosttyVtmuxImporter;
+
+/**
+ * The number of pages of a screen, history and active area together, or
+ * GHOSTTY_NO_VALUE when the screen does not exist.
+ */
+GHOSTTY_API GhosttyResult ghostty_vtmux_page_count(GhosttyTerminal terminal,
+                                                   uint8_t screen,
+                                                   size_t* out_count);
+
+/**
+ * Export page `index` (0 is the oldest) of a screen. A page compressed in
+ * memory comes out as a blob when `blob_if_compressed`, else as rows (it is
+ * decoded into scratch memory and stays compressed). Pages never change
+ * while the terminal does not.
+ */
+GHOSTTY_API GhosttyResult ghostty_vtmux_page_export(GhosttyTerminal terminal,
+                                                    uint8_t screen,
+                                                    size_t index,
+                                                    bool blob_if_compressed,
+                                                    GhosttyVtmuxPage* page);
+
+/** Export the terminal's state outside its grids. */
+GHOSTTY_API GhosttyResult ghostty_vtmux_state_export(GhosttyTerminal terminal,
+                                                     GhosttyVtmuxState* state);
+
+/**
+ * Start importing into `terminal`, which must be fresh: no tracked grid
+ * references, and the size the state will have. With `check`, every blob
+ * is decoded at once and every page's integrity verified (a dry run);
+ * without, a blob is only checked against its checksum and its `Page`
+ * value against the layout of its capacity, and decoded on its first read.
+ */
+GHOSTTY_API GhosttyResult ghostty_vtmux_importer_new(GhosttyTerminal terminal,
+                                                     bool check,
+                                                     GhosttyVtmuxImporter* out);
+
+/**
+ * Add the next page (oldest first) of a screen. The page is copied. A page
+ * of another width than the terminal's, a count or offset out of range, a
+ * blob that fails its checksum or a capacity over Ghostty's page limit is
+ * GHOSTTY_INVALID_VALUE, and the importer is as it was.
+ */
+GHOSTTY_API GhosttyResult ghostty_vtmux_importer_page(GhosttyVtmuxImporter importer,
+                                                      uint8_t screen,
+                                                      const GhosttyVtmuxPage* page);
+
+/**
+ * Replace the terminal's screens with the pages added and apply `state`.
+ * A cursor outside the screen, a scroll region out of order or off it, or
+ * a previous character that is not a Unicode scalar value is
+ * GHOSTTY_INVALID_VALUE. On failure the terminal is unchanged. Free the
+ * importer either way.
+ */
+GHOSTTY_API GhosttyResult ghostty_vtmux_importer_finish(GhosttyVtmuxImporter importer,
+                                                        const GhosttyVtmuxState* state);
+
+GHOSTTY_API void ghostty_vtmux_importer_free(GhosttyVtmuxImporter importer);
+
+/** Make a screen the active one, as an import's state does, without the
+ * side effects of a mode switch. */
+GHOSTTY_API GhosttyResult ghostty_vtmux_set_active_screen(GhosttyTerminal terminal,
+                                                          uint8_t screen);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* GHOSTTY_VT_VTMUX_STATE_H */
