+test "vtmux state: blobs are checked before they are trusted" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    var resident = try Page.init(try pagepkg.std_capacity.adjust(.{ .cols = 10 }));
+    defer resident.deinit();
+    resident.size.rows = 5;
+    resident.getRowAndCell(1, 2).cell.* = .init('A');
+    const scratch = try alloc.alloc(u8, try compression.Page.requiredScratch(resident.memory.len));
+    defer alloc.free(scratch);
+    var table: compression.lz4.HashTable = undefined;
+    var compressed = (try compression.Page.init(alloc, &resident, scratch, &table)).?;
+    defer compressed.deinit();
+
+    const buf = try alloc.alloc(u8, 1 << 20);
+    defer alloc.free(buf);
+    var out = std.mem.zeroes(CPage);
+    out.size = @sizeOf(CPage);
+    out.bytes = buf.ptr;
+    out.bytes_cap = buf.len;
+    try testing.expectEqual(Result.success, exportBlob(&compressed, false, &out));
+    const good = try alloc.dupe(u8, buf[0..out.bytes_len]);
+    defer alloc.free(good);
+
+    const Case = struct {
+        fn import(blob: []u8, check: bool) !Result {
+            var t: terminal_c.Terminal = null;
+            try testing.expectEqual(Result.success, terminal_c.new(null, &t, 10, 3));
+            defer terminal_c.free(t);
+            var imp: CImporter = null;
+            try testing.expectEqual(Result.success, importer_new(t, check, &imp));
+            defer importer_free(imp);
+            var page = std.mem.zeroes(CPage);
+            page.size = @sizeOf(CPage);
+            page.bytes = blob.ptr;
+            page.bytes_cap = blob.len;
+            page.bytes_len = blob.len;
+            page.blob = true;
+            return importer_page(imp, 0, &page);
+        }
+
+        /// Make the checksum match again, as a forger would.
+        fn reseal(blob: []u8) void {
+            var header: BlobHeader = undefined;
+            @memcpy(std.mem.asBytes(&header), blob[0..@sizeOf(BlobHeader)]);
+            const rest = blob[@sizeOf(BlobHeader)..];
+            header.encoded_len = rest.len - @sizeOf(Page);
+            header.checksum = blobChecksum(rest[0..@sizeOf(Page)], rest[@sizeOf(Page)..]);
+            @memcpy(blob[0..@sizeOf(BlobHeader)], std.mem.asBytes(&header));
+        }
+
+        fn meta(blob: []u8) *align(1) Page {
+            return @ptrCast(blob[@sizeOf(BlobHeader)..].ptr);
+        }
+    };
+
+    try testing.expectEqual(Result.success, try Case.import(good, true));
+    const bad = try alloc.dupe(u8, good);
+    defer alloc.free(bad);
+
+    // A byte of the compressed data changed: the checksum fails.
+    bad[bad.len - 3] ^= 0x10;
+    try testing.expectEqual(Result.invalid_value, try Case.import(bad, false));
+
+    // A `Page` value that is not its capacity's layout.
+    @memcpy(bad, good);
+    Case.meta(bad).cells.offset += 64;
+    Case.reseal(bad);
+    try testing.expectEqual(Result.invalid_value, try Case.import(bad, false));
+
+    // Another width than the terminal's.
+    @memcpy(bad, good);
+    Case.meta(bad).size.cols = 9;
+    Case.reseal(bad);
+    try testing.expectEqual(Result.invalid_value, try Case.import(bad, false));
+
+    // Compressed data that does not decode: only a dry run decodes it.
+    @memcpy(bad, good);
+    const short = bad[0 .. bad.len - 8];
+    Case.reseal(short);
+    try testing.expectEqual(Result.success, try Case.import(short, false));
+    try testing.expectEqual(Result.invalid_value, try Case.import(short, true));
+}
