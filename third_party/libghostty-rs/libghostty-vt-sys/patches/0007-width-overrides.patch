+/// vtmux: a width given to a range of codepoints, `first` to `last`
+/// inclusive, that wins over the table (tmux's `codepoint-widths`).
+pub const WidthRange = extern struct {
+    first: u32,
+    last: u32,
+    width: u8,
+};
+
+/// vtmux: the width overrides, sorted and not overlapping, process-wide
+/// like tmux's width cache. Set with `setWidthOverrides`.
+pub var width_overrides: []const WidthRange = &.{};
+
+/// vtmux: the highest codepoint the printer may take as narrow without
+/// looking: 0xFF, or 0x7F while an override reaches below 0x100.
+pub var narrow_max: u21 = 0xFF;
+
+/// vtmux: the overridden width of `cp`, if any.
+pub inline fn widthOverride(cp: u21) ?u2 {
+    if (width_overrides.len == 0) return null;
+    return widthOverrideSlow(cp);
+}
+
+fn widthOverrideSlow(cp: u21) ?u2 {
+    var lo: usize = 0;
+    var hi: usize = width_overrides.len;
+    while (lo < hi) {
+        const mid = lo + (hi - lo) / 2;
+        const r = width_overrides[mid];
+        if (cp < r.first) {
+            hi = mid;
+        } else if (cp > r.last) {
+            lo = mid + 1;
+        } else {
+            return @intCast(@min(r.width, 2));
+        }
+    }
+    return null;
+}
+
+/// vtmux: replace the width overrides with a copy of `ranges` (sorted by
+/// `first`, not overlapping). Not safe while another thread prints.
+pub fn setWidthOverrides(ranges: []const WidthRange) !void {
+    const alloc = @import("std").heap.page_allocator;
+    const copy = try alloc.dupe(WidthRange, ranges);
+    const old = width_overrides;
+    width_overrides = copy;
+    narrow_max = if (copy.len != 0 and copy[0].first <= 0xFF) 0x7F else 0xFF;
+    if (old.len != 0) alloc.free(old);
+}
+
+/// vtmux: the width the printer gives `cp`: an override, else 1 for a
+/// codepoint up to 0xFF, else the table.
+pub inline fn printWidth(cp: u21) u2 {
+    if (widthOverride(cp)) |w| return w;
+    return if (cp <= 0xFF) 1 else table.get(cp).width;
+}
