+const Result = @import("result.zig").Result;
 
 pub fn codepoint_width(cp: u32) callconv(lib.calling_conv) u8 {
     if (cp > 0x10FFFF) return 1;
     return unicode_pkg.codepointWidth(@intCast(cp));
