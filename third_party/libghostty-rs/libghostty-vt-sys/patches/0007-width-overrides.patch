+const Result = @import("result.zig").Result;
 
 pub fn codepoint_width(cp: u32) callconv(lib.calling_conv) u8 {
     if (cp > 0x10FFFF) return 1;
     return unicode_pkg.codepointWidth(@intCast(cp));
 }
 
+/// vtmux: replace the width overrides (see `unicode.setWidthOverrides`).
+pub fn set_width_overrides(
+    ranges: ?[*]const unicode_pkg.WidthRange,
+    len: usize,
+) callconv(lib.calling_conv) Result {
+    const slice: []const unicode_pkg.WidthRange = if (len == 0) &.{} else (ranges orelse return .invalid_value)[0..len];
+    var prev: ?u32 = null;
+    for (slice) |r| {
+        if (r.first > r.last or r.width > 2) return .invalid_value;
+        if (prev) |p| if (r.first <= p) return .invalid_value;
+        prev = r.last;
+    }
+    unicode_pkg.setWidthOverrides(slice) catch return .out_of_memory;
+    return .success;
+}
+
+test "set_width_overrides" {
+    const testing = std.testing;
+    const ranges = [_]unicode_pkg.WidthRange{
+        .{ .first = 0xE9, .last = 0xE9, .width = 2 },
+        .{ .first = 0x3B1, .last = 0x3B3, .width = 2 },
+        .{ .first = 0x1F600, .last = 0x1F600, .width = 1 },
+    };
+    try testing.expectEqual(Result.success, set_width_overrides(&ranges, ranges.len));
+    try testing.expectEqual(2, codepoint_width(0xE9));
+    try testing.expectEqual(2, codepoint_width(0x3B3));
+    try testing.expectEqual(1, codepoint_width(0x3B4));
+    try testing.expectEqual(1, codepoint_width(0x1F600));
+    try testing.expectEqual(0x7F, unicode_pkg.narrow_max);
+    const bad = [_]unicode_pkg.WidthRange{
+        .{ .first = 5, .last = 9, .width = 1 },
+        .{ .first = 9, .last = 10, .width = 1 },
+    };
+    try testing.expectEqual(Result.invalid_value, set_width_overrides(&bad, bad.len));
+    try testing.expectEqual(Result.success, set_width_overrides(null, 0));
+    try testing.expectEqual(2, codepoint_width(0x1F600));
+    try testing.expectEqual(0xFF, unicode_pkg.narrow_max);
+}
