@@ -15539,6 +15539,87 @@ test "Terminal: reflow measures a wide character as tmux does (vtmux)" {
     }
 }
 
+test "Terminal: tmux hscrolled through resizes (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    const line = "abcdefghijklmnopqr\n";
+
+    const History = struct {
+        fn rows(t: *Terminal) usize {
+            const pages = &t.screens.active.pages;
+            return pages.total_rows - pages.rows;
+        }
+        fn take(t: *Terminal) usize {
+            const pages = &t.screens.active.pages;
+            const h = pages.tmux_hscrolled.?.h;
+            pages.tmux_hscrolled = null;
+            return h;
+        }
+    };
+
+    // A taller screen pulls back at most hscrolled rows, wherever the
+    // cursor is, the rest blank at the bottom (screen_resize_y).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("1\n2\n3\n4\n5\n6");
+        t.setCursorPos(1, 1);
+        try testing.expectEqual(@as(usize, 2), History.rows(&t));
+        t.screens.active.pages.tmux_hscrolled = .{ .h = 1, .origin = 0 };
+        try t.resize(alloc, .{ .cols = 10, .rows = 6 });
+        try testing.expectEqual(@as(usize, 1), History.rows(&t));
+        try testing.expectEqual(@as(size.CellCountInt, 1), t.screens.active.cursor.y);
+        try testing.expectEqual(@as(usize, 0), History.take(&t));
+        const str = try t.plainString(alloc);
+        defer alloc.free(str);
+        try testing.expectEqualStrings("2\n3\n4\n5\n6", str);
+    }
+
+    // A shorter screen adds the rows it pushes into history.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("1\n2\n3\n4\n5\n6");
+        t.screens.active.pages.tmux_hscrolled = .{ .h = 0, .origin = 0 };
+        try t.resize(alloc, .{ .cols = 10, .rows = 4 });
+        try testing.expectEqual(@as(usize, 2), History.take(&t));
+    }
+
+    // A narrowing reflow adds a split line's extra rows only while its
+    // index from the top is not past hscrolled (grid_reflow_split): a short
+    // first line stops it...
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 12, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("$ ls\n" ++ line ++ line ++ line ++ "$ ");
+        t.screens.active.pages.tmux_hscrolled = .{ .h = 0, .origin = 0 };
+        try t.resize(alloc, .{ .cols = 8, .rows = 12 });
+        try testing.expectEqual(@as(usize, 0), History.take(&t));
+    }
+
+    // ...a long one runs on through the lines after it, and rows tmux no
+    // longer has do not count.
+    for ([_]usize{ 0, 1 }, [_]usize{ 8, 6 }) |origin, want| {
+        var t = try init(io_impl, alloc, .{ .rows = 12, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString(line ++ line ++ line ++ line ++ "$ ");
+        t.screens.active.pages.tmux_hscrolled = .{ .h = 0, .origin = origin };
+        try t.resize(alloc, .{ .cols = 8, .rows = 12 });
+        try testing.expectEqual(want, History.take(&t));
+    }
+
+    // A widening reflow takes away the rows it joins before hscrolled and
+    // stops at the line they join (grid_reflow_join).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 12, .cols = 8 });
+        defer t.deinit(alloc);
+        try t.printString("$ ls\n" ++ line ++ line ++ line ++ "$ ");
+        t.screens.active.pages.tmux_hscrolled = .{ .h = 5, .origin = 0 };
+        try t.resize(alloc, .{ .cols = 20, .rows = 12 });
+        try testing.expectEqual(@as(usize, 2), History.take(&t));
+    }
+}
