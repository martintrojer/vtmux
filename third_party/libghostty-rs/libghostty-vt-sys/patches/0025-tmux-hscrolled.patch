+/// vtmux: tmux's `hscrolled` through a resize (see `tmux_hscrolled`).
+///
+/// tmux pulls back only lines that scrolled into history, not those a
+/// clear moved there (grid-view.c `grid_view_clear_history` sets it to 0)
+/// or a narrowing reflow pushed there: `screen_resize_y` (screen.c) adds the
+/// lines a shorter screen pushes into history and pulls at most `hscrolled`
+/// lines back into a taller one, wherever the cursor is, the rest blank at
+/// the bottom. `grid_reflow` (grid.c) then moves it as if it were the index
+/// of a line from the top of the history: `grid_reflow_split` adds a split
+/// line's extra lines when its index is not past it, `grid_reflow_join`
+/// takes away the lines it consumes before it (or stops at the line they
+/// join), and the result is at most the new history size.
+pub const TmuxHscrolled = struct {
+    h: usize,
+
+    /// Rows at the top that tmux no longer has (Ghostty prunes whole pages,
+    /// so it keeps a few more): tmux's line indexes start below them.
+    origin: usize,
+
+    /// Reflow bookkeeping, reset by each reflow: the source row reflowed
+    /// next, the destination row tmux's first line went to, and the
+    /// destination row the line being joined is on.
+    src: usize = 0,
+    dst_origin: usize = 0,
+    join_to: usize = 0,
+
+    /// A line of `pieces` rows (from its row's own cells) starts at source
+    /// row `src` and ends on destination row `last`
+    /// (`grid_reflow_split`, `grid_reflow_move`, the first line of
+    /// `grid_reflow_join`).
+    fn lineStart(self: *TmuxHscrolled, src: usize, pieces: usize, last: usize) void {
+        if (src < self.origin) return;
+        if (pieces >= 2 and src - self.origin <= self.h) self.h += pieces - 1;
+        self.join_to = last -| self.dst_origin;
+    }
+
+    /// Source row `src` was joined whole to the line being joined
+    /// (`grid_reflow_join`, one consumed line at a time).
+    fn consumed(self: *TmuxHscrolled, src: usize) void {
+        if (src < self.origin) return;
+        const to = self.join_to;
+        if (self.h > to + 1) {
+            self.h -= 1;
+        } else if (self.h > to) {
+            self.h = to;
+        }
+    }
+};
