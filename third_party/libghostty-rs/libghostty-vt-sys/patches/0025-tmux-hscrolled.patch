+/// vtmux: carry tmux's `hscrolled` through the next resizes of the
+/// primary screen (PageList.tmux_hscrolled): `origin` rows at the top are
+/// rows tmux no longer has.
+pub fn set_hscrolled(
+    terminal_: terminal_c.Terminal,
+    hscrolled: usize,
+    origin: usize,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const screen = wrapper.terminal.screens.get(.primary) orelse return .no_value;
+    screen.pages.tmux_hscrolled = .{ .h = hscrolled, .origin = origin };
+    return .success;
+}
+
+/// vtmux: tmux's `hscrolled` after the resizes since `set_hscrolled`, which
+/// stops carrying it.
+pub fn take_hscrolled(
+    terminal_: terminal_c.Terminal,
+    out: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const out_ = out orelse return .invalid_value;
+    const screen = wrapper.terminal.screens.get(.primary) orelse return .no_value;
+    const t = screen.pages.tmux_hscrolled orelse return .no_value;
+    out_.* = t.h;
+    screen.pages.tmux_hscrolled = null;
+    return .success;
+}
+
