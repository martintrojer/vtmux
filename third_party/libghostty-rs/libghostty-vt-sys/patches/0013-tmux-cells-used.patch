         assert(!self.managedMemory());
         self.* = .{ .cells = self.cells, .dirty = true };
     }
+
+    /// vtmux: cells up to `end` (exclusive) have been written
+    /// (grid_set_cell's `cellused` update).
+    pub inline fn tmuxRaiseUsed(self: *Row, end: usize) void {
+        const e: size.CellCountInt = @intCast(@min(end, std.math.maxInt(size.CellCountInt)));
+        if (e > self.tmux_used) self.tmux_used = e;
+    }
+
+    /// vtmux: tmux's `cellused` for this row: the high-water mark, or
+    /// the row's text extent where that is further (a row whose cells
+    /// came from somewhere that does not keep the mark). `cells` is the
+    /// row's cells.
+    pub fn tmuxCellsUsed(self: Row, cells: []const Cell) size.CellCountInt {
+        var end = cells.len;
+        while (end > 0) : (end -= 1) {
+            const c = cells[end - 1];
+            if (c.hasText() or c.wide == .wide or c.wide == .spacer_tail) break;
+        }
+        const used = @min(@as(usize, self.tmux_used), cells.len);
+        return @intCast(@max(used, end));
+    }
 };
 
