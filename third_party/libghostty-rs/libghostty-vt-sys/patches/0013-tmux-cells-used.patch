+    /// row has been written, a high-water mark that printing raises and
+    /// erasing does not lower (grid_set_cell raises it, grid_clear keeps
+    /// it), so a cell written then erased with a background still counts
+    /// and a cell only erased does not. A full-row clear resets it with
+    /// the rest of the row (grid_clear_lines). Reflow measures an
+    /// unwrapped row by it (grid_reflow). Readers take the larger of this
+    /// and the row's text extent (`tmuxCellsUsed`), so a row that came
+    /// from somewhere that does not keep it measures by its text.
+    tmux_used: size.CellCountInt = 0,
+
+    _padding: u7 = 0,
 
     /// The semantic prompt state of the row. See `semantic_prompt`.
