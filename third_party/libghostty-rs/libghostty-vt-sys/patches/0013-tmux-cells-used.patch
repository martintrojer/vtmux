+test "Terminal: cells used follow tmux's cellused (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 20 });
+    defer t.deinit(alloc);
+    const used = struct {
+        fn at(term: *Terminal, y: usize) size.CellCountInt {
+            return term.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = @intCast(y) } }).?.row.tmux_used;
+        }
+    }.at;
+
+    // print raises it, ECH and a partial EL do not lower it.
+    try t.printString("abcde");
+    try testing.expectEqual(@as(size.CellCountInt, 5), used(&t, 0));
+    t.setCursorPos(1, 2);
+    t.eraseChars(2);
+    t.eraseLine(.right, false);
+    try testing.expectEqual(@as(size.CellCountInt, 5), used(&t, 0));
+    // DCH counts the cells it moved to (grid_move_cells): sx - n.
+    t.deleteChars(3);
+    try testing.expectEqual(@as(size.CellCountInt, 17), used(&t, 0));
+    // A full-line clear empties the line.
+    t.eraseLine(.complete, false);
+    try testing.expectEqual(@as(size.CellCountInt, 0), used(&t, 0));
+    // ICH counts up to the end of the line.
+    try t.printString("ab");
+    t.setCursorPos(1, 1);
+    t.insertBlanks(1);
+    try testing.expectEqual(@as(size.CellCountInt, 20), used(&t, 0));
+    // A tab over blanks is a written cell of its width.
+    t.setCursorPos(2, 1);
+    t.horizontalTab();
+    try testing.expectEqual(@as(size.CellCountInt, 8), used(&t, 1));
+    // A wide character counts both its cells, through either print path.
+    t.setCursorPos(3, 1);
+    try t.print(0x4E00);
+    try testing.expectEqual(@as(size.CellCountInt, 2), used(&t, 2));
+    try t.printString("\u{4E00}\u{4E00}");
+    try testing.expectEqual(@as(size.CellCountInt, 6), used(&t, 2));
+    // ECH over the whole line from its start is a line clear.
+    t.setCursorPos(3, 1);
+    t.eraseChars(20);
+    try testing.expectEqual(@as(size.CellCountInt, 0), used(&t, 2));
+}
