+test "Terminal: decaln writes default cells and keeps the pen and origin mode (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .cols = 3, .rows = 3 });
+    defer t.deinit(alloc);
+
+    try t.setAttribute(.{ .bold = {} });
+    try t.setAttribute(.{ .direct_color_fg = .{ .r = 0xFF, .g = 0, .b = 0 } });
+    t.modes.set(.origin, true);
+    t.setTopAndBottomMargin(2, 3);
+    try t.decaln();
+    try testing.expectEqual(@as(usize, 0), t.screens.active.cursor.y);
+    try testing.expectEqual(@as(usize, 0), t.screens.active.cursor.x);
+    try testing.expect(t.modes.get(.origin));
+    try testing.expect(t.screens.active.cursor.style.flags.bold);
+    const e = t.screens.active.pages.getCell(.{ .active = .{ .x = 2, .y = 2 } }).?;
+    try testing.expectEqual(@as(u21, 'E'), e.cell.content.codepoint.data);
+    try testing.expectEqual(style.default_id, e.cell.style_id);
+}
