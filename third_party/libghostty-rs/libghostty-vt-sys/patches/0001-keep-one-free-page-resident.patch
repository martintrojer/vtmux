+/// Whether a freed pool item should stay resident: only while no other
+/// free item does.
+fn keepWarm(
+    pool: *MemoryPool,
+    item: *align(std.heap.page_size_min) [std_size]u8,
+) bool {
+    if (comptime wasm_page_pool) return false;
+    if (pool.warm) |warm| {
+        for (pool.pages.free.items) |free| {
+            if (free == warm) return false;
+        }
+    }
+    pool.warm = item;
+    return true;
+}
