+/// vtmux: a compressed node with a copy of `src`'s encoding over fresh
+/// backing memory of the same kind (pool item or heap), left untouched: the
+/// node's first page access decodes into it (`Node.restore`).
+fn cloneCompressedNode(
+    pool: *MemoryPool,
+    src: *const List.Node,
+    serial: *u64,
+    total_size: *usize,
+) Allocator.Error!*List.Node {
+    const compressed = &src.data.compressed;
+    const node = try pool.nodes.create();
+    errdefer pool.nodes.destroy(node);
+    const len = compressed.page.memory.len;
+    const buf: []align(std.heap.page_size_min) u8 = switch (src.owned) {
+        .pool => try pool.pages.create(),
+        .heap => try pool.pages.allocator.alignedAlloc(
+            u8,
+            .fromByteUnits(std.heap.page_size_min),
+            len,
+        ),
+    };
+    errdefer switch (src.owned) {
+        .pool => pool.pages.destroy(@ptrCast(buf.ptr)),
+        .heap => pool.pages.allocator.free(buf),
+    };
+    const encoded_alloc = if (builtin.is_test) pool.alloc else pool.pages.allocator;
+    var page_ = compressed.*;
+    page_.page.memory = buf[0..len];
+    page_.encoded = try encoded_alloc.dupe(u8, compressed.encoded);
+    page_.alloc = encoded_alloc;
+    node.* = .{
+        .data = .{ .compressed = page_ },
+        .serial = serial.*,
+        .owned = src.owned,
+    };
+    serial.* += 1;
+    total_size.* += buf.len;
+    return node;
+}
