+/// A frozen copy of the active screen in a new terminal of the same size:
+/// every page (history included) is copied, so later changes to `terminal_`
+/// do not show in it. Only the screen's grid, cursor and selection are
+/// copied; modes, callbacks and parser state are the new terminal's own.
+pub fn clone_screen(
+    terminal_: Terminal,
+    result: *Terminal,
+) callconv(lib.calling_conv) Result {
+    result.* = clone_screen_(terminal_) catch |err| {
+        result.* = null;
+        return switch (err) {
+            error.InvalidValue => .invalid_value,
+            error.OutOfMemory => .out_of_memory,
+        };
+    };
+    return .success;
+}
+
+fn clone_screen_(terminal_: Terminal) NewError!Terminal {
+    const src = (terminal_ orelse return error.InvalidValue).terminal;
+    const out = try new_(null, src.cols, src.rows);
+    errdefer free(out);
+    const screen = out.?.terminal.screens.active;
+    const copy = src.screens.active.clone(
+        screen.io,
+        screen.alloc,
+        .{ .screen = .{} },
+        null,
+    ) catch return error.OutOfMemory;
+    screen.deinit();
+    screen.* = copy;
+    return out;
+}
