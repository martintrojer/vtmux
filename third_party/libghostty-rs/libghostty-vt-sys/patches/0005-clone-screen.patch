+/// Copy every cell of the ref's row (the ref's x is ignored) into
+/// `out_buf`. `out_len` gets the row's cell count: the page's width, which
+/// an incomplete reflow can leave below the terminal's.
+pub fn grid_ref_row_cells(
+    ref: *const CGridRef,
+    out_buf: ?[*]cell_c.CCell,
+    buf_len: usize,
+    out_len: *usize,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const terminal_page = p.node.page();
+    const row = terminal_page.getRow(p.y);
+    const cells = terminal_page.getCells(row);
+    out_len.* = cells.len;
+    if (out_buf == null or buf_len < cells.len) return .out_of_space;
+    for (cells, 0..) |cell, i| out_buf.?[i] = @bitCast(cell);
+    return .success;
+}
