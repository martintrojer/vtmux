+    // vtmux: a cursor at or past the end of the cells its line used goes
+    // to the end of the reflowed line, as tmux's does (grid_wrap_position
+    // gives it UINT_MAX, grid_unwrap_position the cellused of the line's
+    // last row), so a line that now ends at the last column leaves the
+    // cursor past it, as a pending wrap. Upstream moved the cursor as a
+    // cell after the line and started a new row with it. Put it on the
+    // last used cell with a pending wrap: the reflow moves it with that
+    // cell, and the pending wrap is dropped below with the cursor moved
+    // one on unless the cell ends a row.
+    const tmux_line_end: ?size.CellCountInt = tmux_line_end: {
+        if (!opts.reflow or opts.cols == self.pages.cols) break :tmux_line_end null;
+        if (self.cursor.pending_wrap or self.cursor.page_row.wrap) break :tmux_line_end null;
+        const page = self.cursor.page_pin.node.page();
+        const used = self.cursor.page_row.tmuxCellsUsed(page.getCells(self.cursor.page_row));
+        if (used == 0 or self.cursor.x < used) break :tmux_line_end null;
+        const x = self.cursor.x;
+        self.cursorHorizontalAbsolute(used - 1);
+        self.cursor.pending_wrap = true;
+        break :tmux_line_end x;
+    };
+    errdefer if (tmux_line_end) |x| {
+        self.cursor.pending_wrap = false;
+        self.cursorHorizontalAbsolute(x);
+    };
