+test "Terminal: reflow leaves a cursor at the line's end past it (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // 18 characters on 20 columns, the cursor after them, narrowed to 9:
+    // tmux's cursor ends the second row, past its last column (9,1).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("abcdefghijklmnopqr");
+        try t.resize(alloc, .{ .cols = 9, .rows = 5 });
+        try testing.expectEqual(@as(size.CellCountInt, 8), t.screens.active.cursor.x);
+        try testing.expectEqual(@as(size.CellCountInt, 1), t.screens.active.cursor.y);
+        try testing.expect(t.screens.active.cursor.pending_wrap);
+
+        // The next character starts the third row.
+        try t.print('Z');
+        try testing.expectEqual(@as(size.CellCountInt, 1), t.screens.active.cursor.x);
+        try testing.expectEqual(@as(size.CellCountInt, 2), t.screens.active.cursor.y);
+    }
+
+    // A line that does not end its last row: the cursor right after it.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("abcdefghijklmnop");
+        try t.resize(alloc, .{ .cols = 9, .rows = 5 });
+        try testing.expectEqual(@as(size.CellCountInt, 7), t.screens.active.cursor.x);
+        try testing.expectEqual(@as(size.CellCountInt, 1), t.screens.active.cursor.y);
+        try testing.expect(!t.screens.active.cursor.pending_wrap);
+    }
+
+    // A cursor moved past the line's end goes to its end.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("abc");
+        t.setCursorPos(1, 10);
+        try t.resize(alloc, .{ .cols = 9, .rows = 5 });
+        try testing.expectEqual(@as(size.CellCountInt, 3), t.screens.active.cursor.x);
+        try testing.expectEqual(@as(size.CellCountInt, 0), t.screens.active.cursor.y);
+    }
+}
+
