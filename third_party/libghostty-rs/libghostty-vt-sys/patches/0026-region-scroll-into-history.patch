+test "Terminal: a region below the top scrolls into history as tmux's does (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // tmux 3.8, 6x4: printf 'A\nB\nC\033[2;3r\033[2;1HX\033D\033DY' has
+    // history_size 1 and capture-pane -S - starts with X
+    // (grid_scroll_history_region).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 6 });
+        defer t.deinit(alloc);
+        try t.printString("A\nB\nC");
+        t.setTopAndBottomMargin(2, 3);
+        t.setCursorPos(2, 1);
+        try t.print('X');
+        try t.index();
+        try t.index();
+        try t.print('Y');
+        const str = try t.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(str);
+        try testing.expectEqualStrings("X\nA\nC\n Y", str);
+        try testing.expectEqual(@as(usize, 2), t.screens.active.cursor.y);
+    }
+
+    // SU counts lines up to the region's height; each goes into history.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 6 });
+        defer t.deinit(alloc);
+        try t.printString("A\nB\nC\nD");
+        t.setTopAndBottomMargin(2, 3);
+        t.setCursorPos(4, 2);
+        try t.scrollUp(5);
+        const str = try t.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(str);
+        try testing.expectEqualStrings("B\nC\nA\n\n\nD", str);
+        try testing.expectEqual(@as(usize, 3), t.screens.active.cursor.y);
+        try testing.expectEqual(@as(usize, 1), t.screens.active.cursor.x);
+    }
+
+    // The region's top row keeps its wrap flag in history, so the row
+    // under it (active row 0) is its continuation, as tmux's history
+    // line stays wrapped; the region's new top row is not one.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("x\naaaaaaaaaab");
+        t.setTopAndBottomMargin(2, 3);
+        t.setCursorPos(3, 1);
+        try t.index();
+        const pages = &t.screens.active.pages;
+        const h = pages.getCell(.{ .screen = .{ .x = 0, .y = 0 } }).?.row;
+        const r0 = pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?.row;
+        const r1 = pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?.row;
+        const r2 = pages.getCell(.{ .active = .{ .x = 0, .y = 2 } }).?.row;
+        try testing.expect(h.wrap);
+        try testing.expect(r0.wrap_continuation);
+        try testing.expect(!r1.wrap_continuation);
+        try testing.expect(!r2.wrap_continuation);
+        const str = try t.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(str);
+        try testing.expectEqualStrings("aaaaaaaaaa\nx\nb", str);
+    }
+
+    // The bottom row is cleared with the cursor's background.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 6 });
+        defer t.deinit(alloc);
+        try t.printString("A\nB\nC");
+        t.setTopAndBottomMargin(2, 3);
+        t.setCursorPos(3, 1);
+        try t.setAttribute(.{ .direct_color_bg = .{ .r = 0xFF, .g = 0, .b = 0 } });
+        try t.index();
+        const list_cell = t.screens.active.pages.getCell(.{ .active = .{ .x = 5, .y = 2 } }).?;
+        try testing.expect(list_cell.cell.content_tag == .bg_color_rgb);
+        try testing.expectEqual(@as(u8, 0xFF), list_cell.cell.content.color_rgb.r);
+        const str = try t.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+        defer alloc.free(str);
+        try testing.expectEqualStrings("B\nA\nC", str);
+    }
+
+    // Rows on either side of a page boundary, styled (managed memory moves
+    // with a copy across pages): every step a scroll moves the boundary up
+    // a row, so it passes between each pair of the rows that rotate.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 8 });
+        defer t.deinit(alloc);
+        const pages = &t.screens.active.pages;
+        var n: usize = 0;
+        while (pages.pages.first == pages.pages.last) : (n += 1) {
+            try t.printString("fill\n");
+        }
+        try t.setAttribute(.bold);
+        t.setCursorPos(1, 1);
+        t.eraseDisplay(.below, false);
+        try t.printString("T0\nT1\nR0\nR1\nR2");
+        t.setTopAndBottomMargin(3, 5);
+        var next: usize = 3;
+        while (next < 3 + 8) : (next += 1) {
+            t.setCursorPos(5, 1);
+            try t.index();
+            var buf: [8]u8 = undefined;
+            try t.printString(try std.fmt.bufPrint(&buf, "R{d}", .{next}));
+            const str = try t.screens.active.dumpStringAlloc(alloc, .{ .screen = .{} });
+            defer alloc.free(str);
+            var want_buf: [64]u8 = undefined;
+            const want = try std.fmt.bufPrint(
+                &want_buf,
+                "\nR{d}\nT0\nT1\nR{d}\nR{d}\nR{d}",
+                .{ next - 3, next - 2, next - 1, next },
+            );
+            try testing.expect(std.mem.endsWith(u8, str, want));
+            for (0..5) |y| {
+                const c = pages.getCell(.{ .active = .{ .x = 0, .y = @intCast(y) } }).?;
+                try testing.expect(c.style().flags.bold);
+            }
+            const h = pages.pin(.{ .active = .{} }).?.up(1).?;
+            const hc = h.rowAndCell().cell;
+            try testing.expect(h.style(hc).flags.bold);
+        }
+        try testing.expect(pages.getTopLeft(.active).node != pages.pages.first);
+    }
+}
