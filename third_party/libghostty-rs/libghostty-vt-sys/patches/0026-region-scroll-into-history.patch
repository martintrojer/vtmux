+/// vtmux: whether a region scrolled up puts its top row into history as
+/// tmux's does and Ghostty's does not: a full-width region (tmux has no
+/// left and right margins) below the top on a screen that keeps history.
+/// tmux's grid_view_scroll_region_up (grid-view.c) takes
+/// grid_scroll_history_region for any region of a grid with history; the
+/// alternate screen (tmux's alternate grid has none) moves lines in place.
+/// With Kitty image placements Ghostty's in-place path, which moves them,
+/// is kept (vtmux stores no images).
+fn tmuxRegionScrollsIntoHistory(self: *const Terminal) bool {
+    const screen = self.screens.active;
+    if (screen.no_scrollback) return false;
+    if (self.scrolling_region.top == 0) return false;
+    if (self.scrolling_region.left != 0 or
+        self.scrolling_region.right != self.cols - 1) return false;
+    if (comptime build_options.kitty_graphics) {
+        if (screen.kitty_images.placements.count() != 0) return false;
+    }
+    return true;
+}
+
+/// vtmux: a full-width region below the top scrolled up by one into
+/// history, as tmux's grid_scroll_history_region (grid.c) does it: the
+/// region's top row becomes the newest history row, the rows above the
+/// region stay where they are, the rest of the region moves up a row and
+/// its bottom row is cleared with the cursor's background
+/// (grid_empty_line). The cursor is on the region's bottom row and stays
+/// there.
+///
+/// It scrolls the rows from the top to the region's bottom as a region
+/// at the top does (cursorScrollAbove: row 0 into history), then rotates
+/// the newest history row and the rows above the region down by one, so
+/// the region's old top row is in history and those rows are back where
+/// they were. The blank cursor row holds the row on the move meanwhile.
+/// Ghostty's history limits are lifted until the rows are back: a page
+/// pruned by the scroll would take the old row 0 with it.
+fn tmuxScrollRegionUpIntoHistory(self: *Terminal) !void {
+    const screen: *Screen = self.screens.active;
+    const top: usize = self.scrolling_region.top;
+    const bottom: usize = self.scrolling_region.bottom;
+    assert(top > 0 and top <= bottom);
+    assert(screen.cursor.y == bottom);
+
+    const limits = screen.pages.limits;
+    screen.pages.limits.set(.bytes, null);
+    screen.pages.limits.set(.lines, null);
+    defer {
+        screen.pages.limits = limits;
+        screen.pages.limits.enforce(&screen.pages, .lines, .reclaim);
+        screen.pages.limits.enforce(&screen.pages, .bytes, .reclaim);
+    }
+
+    try screen.cursorScrollAbove();
+
+    // Rows by index (tmuxRotationPin): 0 is the newest history row, i > 0
+    // active row i - 1, so `top` is the region's old top row (now on
+    // active row top - 1).
+    const first = tmuxRotationPin(screen, 0);
+    const last = tmuxRotationPin(screen, top);
+    self.invalidateFullWidthRowRange(first.node, screen.cursor.page_pin.node);
+    if (first.node == last.node) {
+        // One page: rotate the rows in place, [ 0 1 2 3 ] to [ 3 0 1 2 ].
+        const page = first.node.page();
+        const rows = page.rows.ptr(page.memory.ptr)[first.y .. last.y + 1];
+        fastmem.rotateOnceR(Row, rows);
+        for (rows) |*row| row.dirty = true;
+    } else {
+        // Walking up keeps every pin valid: a copy replaces only the page
+        // of its destination, and later moves are all in earlier pages.
+        var dst = last;
+        tmuxMoveRow(screen, dst, screen.cursor.page_pin.*);
+        var i: usize = top;
+        while (i > 0) : (i -= 1) {
+            const src = dst.up(1).?;
+            tmuxMoveRow(screen, src, dst);
+            dst = src;
+        }
+        tmuxMoveRow(screen, screen.cursor.page_pin.*, dst);
+
+        // The cursor row is the region's blank bottom row again.
+        const p = screen.cursor.page_pin.*;
+        const page = p.node.page();
+        const row = p.rowAndCell().row;
+        screen.clearCells(page, row, page.getCells(row));
+        row.reset();
+        const rac = p.rowAndCell();
+        screen.cursor.page_row = rac.row;
+        screen.cursor.page_cell = rac.cell;
+    }
+
+    // Rows with a new row above them: the history row, active row 0 (under
+    // the region's old top row, as tmux's history line is), the region's
+    // new top row and the row below the region (patch 0011).
+    tmuxFixContinuationAt(tmuxRotationPin(screen, 0));
+    tmuxFixContinuationAt(tmuxRotationPin(screen, 1));
+    if (top < bottom) tmuxFixContinuationAt(tmuxRotationPin(screen, top + 1));
+    self.tmuxFixContinuationsBelowRegion();
+}
+
+/// vtmux: row `i` of tmuxScrollRegionUpIntoHistory's rotation (0 the
+/// newest history row, i > 0 active row i - 1).
+fn tmuxRotationPin(screen: *Screen, i: usize) PageList.Pin {
+    if (i == 0) return screen.pages.pin(.{ .active = .{} }).?.up(1).?;
+    return screen.pages.pin(.{ .active = .{ .y = @intCast(i - 1) } }).?;
+}
+
+/// vtmux: move row `src` into row `dst` with its metadata: a swap in one
+/// page, a copy across pages (`src` keeps a copy, which a later move or
+/// the final clear replaces). A copy can replace `dst`'s page (to grow
+/// it), which leaves pins into that page stale.
+fn tmuxMoveRow(screen: *Screen, src: PageList.Pin, dst: PageList.Pin) void {
+    const src_row = src.rowAndCell().row;
+    if (src.node == dst.node) {
+        const dst_row = dst.rowAndCell().row;
+        const tmp = dst_row.*;
+        dst_row.* = src_row.*;
+        src_row.* = tmp;
+        src_row.dirty = true;
+        dst_row.dirty = true;
+        src.node.page().assertIntegrity();
+    } else {
+        const node = screen.clonePartialRowGrowCapacity(
+            dst.node,
+            dst.y,
+            src.node.page(),
+            src_row,
+            0,
+            screen.pages.cols,
+        );
+        const page = node.page();
+        page.rows.ptr(page.memory.ptr)[dst.y].dirty = true;
+    }
+}
