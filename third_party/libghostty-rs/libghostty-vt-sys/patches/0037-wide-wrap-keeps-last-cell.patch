+test "Terminal: a wide char that wraps leaves the last cell as it was (vtmux)" {
+    var t = try init(testing.io, testing.allocator, .{ .cols = 5, .rows = 4 });
+    defer t.deinit(testing.allocator);
+
+    // tmux's screen_write_cell wraps a wide character that does not fit
+    // and leaves the last column alone: text, style and link.
+    try t.printString("abcd");
+    try t.screens.active.startHyperlink("http://x/", null);
+    try t.setAttribute(.{ .bold = {} });
+    try t.print('x');
+    t.setCursorPos(1, 5);
+    try t.setAttribute(.{ .unset = {} });
+    t.screens.active.endHyperlink();
+    try t.print(0x4E00);
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .screen = .{ .x = 4, .y = 0 } }).?;
+        try testing.expectEqual(@as(u21, 'x'), list_cell.cell.content.codepoint.data);
+        try testing.expectEqual(Cell.Wide.narrow, list_cell.cell.wide);
+        try testing.expect(list_cell.cell.hyperlink);
+        try testing.expect(list_cell.cell.style_id != 0);
+        try testing.expect(list_cell.row.wrap);
+    }
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .screen = .{ .x = 0, .y = 1 } }).?;
+        try testing.expectEqual(@as(u21, 0x4E00), list_cell.cell.content.codepoint.data);
+        try testing.expectEqual(Cell.Wide.wide, list_cell.cell.wide);
+    }
+
+    // An empty last cell becomes the spacer head.
+    t.setCursorPos(3, 1);
+    try t.setAttribute(.{ .direct_color_bg = .{ .r = 1, .g = 2, .b = 3 } });
+    try t.printString("abcd");
+    t.setCursorPos(3, 5);
+    try t.setAttribute(.{ .unset = {} });
+    try t.print(0x4E00);
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .screen = .{ .x = 4, .y = 2 } }).?;
+        try testing.expectEqual(Cell.Wide.spacer_head, list_cell.cell.wide);
+        try testing.expectEqual(@as(u21, 0), list_cell.cell.content.codepoint.data);
+        try testing.expect(list_cell.row.wrap);
+    }
+
+    // The batched path (printSlice) does the same.
+    t.setCursorPos(4, 1);
+    try t.printSlice(&.{ 'a', 'b', 'c', 'd', 'y' });
+    t.setCursorPos(4, 5);
+    try t.printSlice(&.{ 0x4E00, 0x4E00 });
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .active = .{ .x = 4, .y = 2 } }).?;
+        try testing.expectEqual(@as(u21, 'y'), list_cell.cell.content.codepoint.data);
+        try testing.expectEqual(Cell.Wide.narrow, list_cell.cell.wide);
+        try testing.expect(list_cell.row.wrap);
+    }
+    t.setCursorPos(4, 1);
+    try t.printSlice(&.{ 'a', 'b', 'c', 'd' });
+    t.setCursorPos(4, 5);
+    try t.printSlice(&.{ 0x4E00, 0x4E00 });
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .active = .{ .x = 4, .y = 2 } }).?;
+        try testing.expectEqual(Cell.Wide.spacer_head, list_cell.cell.wide);
+        try testing.expect(list_cell.row.wrap);
+    }
+}
