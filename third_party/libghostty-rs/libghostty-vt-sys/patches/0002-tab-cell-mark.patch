         // "last cursor position" because we want a space to be written
         // at the tabstop unless we're at the end (the while condition).
-        if (self.tabstops.get(self.screens.active.cursor.x)) return;
-    }
+        if (self.tabstops.get(self.screens.active.cursor.x)) break;
+    }
+    self.markTab(start_x, self.screens.active.cursor.x);
+}
+
+/// Whether two blank cells look the same (`grid_cells_look_equal`, for
+/// cells that are already known to be blank).
+fn blankLooksAlike(a: Cell, b: Cell) bool {
+    return a.content_tag == b.content_tag and
+        a.style_id == b.style_id and
+        a.hyperlink == b.hyperlink and
+        a.protected == b.protected and
+        (a.content_tag == .codepoint or
+            @as(u24, @bitCast(a.content)) == @as(u24, @bitCast(b.content)));
+}
+
+/// A cell tmux would call a plain space: no text (or a space), narrow,
+/// not part of a tab.
+fn blankForTab(c: Cell) bool {
+    return switch (c.content_tag) {
+        .codepoint => (c.content.codepoint.data == 0 or c.content.codepoint.data == ' ') and
+            c.wide == .narrow and c.tab == 0,
+        .codepoint_grapheme => false,
+        .bg_color_palette, .bg_color_rgb => c.wide == .narrow and c.tab == 0,
+    };
+}
+
+/// Mark the columns `from..to` of the cursor row as one tab when the tab
+/// that just moved the cursor there crossed only blank cells (the rule of
+/// input.c's HT case). The first cell holds the width, the rest are
+/// `Cell.tab_continuation`.
+fn markTab(self: *Terminal, from: usize, to: usize) void {
+    if (to <= from) return;
+    const width = to - from;
+    if (width > Cell.tab_max) return;
+
+    // tmux has no margins: with any, the cursor stopped somewhere it
+    // would not have.
+    if (self.scrolling_region.left != 0 or
+        self.scrolling_region.right != self.cols - 1) return;
+    if (self.modes.get(.insert)) return;
+
+    const here: [*]Cell = @ptrCast(self.screens.active.cursor.page_cell);
+    const cur = self.screens.active.cursor.x;
+    // `here` is the cursor, at `to`: the row starts `to` cells back.
+    const row = here - cur;
+    const first = row[from];
+    for (from..to) |x| {
+        if (!blankForTab(row[x]) or !blankLooksAlike(row[x], first)) return;
+    }
+
+    row[from].tab = @intCast(width);
+    for (from + 1..to) |x| row[x].tab = Cell.tab_continuation;
+    self.screens.active.cursorMarkDirty();
+}
+
+/// Drop the tab mark of the whole tab that includes the cursor cell, before
+/// the cell is overwritten (screen_write_overwrite, screen-write.c: writing
+/// over any part of a tab clears the rest of it).
+fn clearTabAtCursor(self: *Terminal) void {
+    const cur = self.screens.active.cursor.x;
+    const here: [*]Cell = @ptrCast(self.screens.active.cursor.page_cell);
+    const row = here - cur;
+    var start = cur;
+    while (start > 0 and row[start].tab == Cell.tab_continuation) start -= 1;
+    var end = cur;
+    while (end + 1 < self.cols and row[end + 1].tab == Cell.tab_continuation) end += 1;
+    for (start..end + 1) |x| row[x].tab = 0;
 }
 
