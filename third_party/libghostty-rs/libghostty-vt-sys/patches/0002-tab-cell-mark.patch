 /// Horizontal tab moves the cursor to the next tabstop, clearing
 /// the screen to the left the tabstop.
+///
+/// vtmux: when the tab moves over blank cells that all look alike it also
+/// marks them as a tab (`Cell.tab`), the way tmux stores a TAB cell
+/// (input_c0_dispatch, input.c, case HT: `grid_set_tab`).
 pub fn horizontalTab(self: *Terminal) void {
+    const start_x = self.screens.active.cursor.x;
     while (self.screens.active.cursor.x < self.scrolling_region.right) {
