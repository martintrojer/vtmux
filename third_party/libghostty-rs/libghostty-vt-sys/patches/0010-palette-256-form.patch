+/// vtmux: a style without the 256-colour form flags, which the VT
+/// formatter does not preserve (it writes 38;5;N for every palette colour).
+fn withoutPaletteForm(s: Style) Style {
+    var copy = s;
+    copy.flags.fg_palette_256 = false;
+    copy.flags.bg_palette_256 = false;
+    return copy;
+}
