     }
 }
 
+test "Terminal: 256-colour SGR keeps its form (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    try t.setAttribute(.{ .@"256_fg" = 1 });
+    try t.print('A');
+    try t.setAttribute(.{ .@"8_fg" = .red });
+    try t.print('B');
+    try t.setAttribute(.{ .@"256_bg" = 2 });
+    t.eraseLine(.right, false);
+
+    const a = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?;
+    const b = t.screens.active.pages.getCell(.{ .active = .{ .x = 1, .y = 0 } }).?;
+    const c = t.screens.active.pages.getCell(.{ .active = .{ .x = 2, .y = 0 } }).?;
+    try testing.expect(a.style().flags.fg_palette_256);
+    try testing.expect(!b.style().flags.fg_palette_256);
+    try testing.expectEqual(a.style().fg_color, b.style().fg_color);
+    try testing.expect(c.cell.content_tag == .bg_color_palette);
+    try testing.expect(c.cell.content.color_palette.palette_256);
+
+    try t.setAttribute(.{ .@"8_bg" = .green });
+    t.eraseLine(.right, false);
+    const d = t.screens.active.pages.getCell(.{ .active = .{ .x = 2, .y = 0 } }).?;
+    try testing.expect(!d.cell.content.color_palette.palette_256);
+}
