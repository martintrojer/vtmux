+test "Terminal: reflow keeps the links of a page full of them (vtmux)" {
+    const alloc = testing.allocator;
+    var t = try init(testing.io, alloc, .{
+        .cols = 80,
+        .rows = 4,
+        .max_scrollback_bytes = null,
+    });
+    defer t.deinit(alloc);
+
+    // Short linked lines fill pages' hyperlink maps; narrower, each line
+    // takes two rows of a destination page with as many cells, so the
+    // reflow needs more map than a page can grow to and moves rows to
+    // new pages. It reached `unreachable` in ReflowCursor.writeCell.
+    const s = t.screens.active;
+    try s.startHyperlink("http://example.com", null);
+    for (0..3000) |_| {
+        for (0..30) |_| try t.print('x');
+        t.carriageReturn();
+        try t.linefeed();
+    }
+    s.endHyperlink();
+    try t.resize(alloc, .{ .cols = 17, .rows = 4 });
+
+    var it = s.pages.rowIterator(.right_down, .{ .screen = .{} }, null);
+    var linked: usize = 0;
+    while (it.next()) |row| {
+        for (row.cells(.all)) |cell| {
+            if (!cell.hasText()) continue;
+            try testing.expect(cell.hyperlink);
+            linked += 1;
+        }
+    }
+    try testing.expectEqual(@as(usize, 3000 * 30), linked);
+}
