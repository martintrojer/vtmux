+test "Terminal: reflow measures a tab as tmux does (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // A tab that does not fit the rest of the row moves whole: 12
+    // characters, a tab of 4 and Z on 20 columns, narrowed to 14.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("abcdefghijkl");
+        t.horizontalTab();
+        try t.printString("Z");
+        try t.resize(alloc, .{ .cols = 14, .rows = 4 });
+        const head = t.screens.active.pages.getCell(.{ .screen = .{ .x = 0, .y = 1 } }).?;
+        try testing.expectEqual(@as(u8, 4), head.cell.tab);
+        const z = t.screens.active.pages.getCell(.{ .screen = .{ .x = 4, .y = 1 } }).?;
+        try testing.expectEqual(@as(u21, 'Z'), z.cell.codepoint());
+        const row0 = t.screens.active.pages.getCell(.{ .screen = .{ .x = 0, .y = 0 } }).?;
+        try testing.expect(row0.row.wrap);
+        try testing.expectEqual(@as(size.CellCountInt, 12), row0.row.tmux_used);
+        try testing.expectEqual(@as(size.CellCountInt, 5), t.screens.active.cursor.x);
+
+        // Widened back, the tab joins the row again where it was.
+        try t.resize(alloc, .{ .cols = 20, .rows = 4 });
+        const back = t.screens.active.pages.getCell(.{ .screen = .{ .x = 12, .y = 0 } }).?;
+        try testing.expectEqual(@as(u8, 4), back.cell.tab);
+        const z2 = t.screens.active.pages.getCell(.{ .screen = .{ .x = 16, .y = 0 } }).?;
+        try testing.expectEqual(@as(u21, 'Z'), z2.cell.codepoint());
+    }
+
+    // tmux counts a tab of width w as 2w - 1 columns: ab, a tab of 6 and
+    // c (9 cells, 14 to tmux) splits on 12 columns after the tab's fifth
+    // column, and c lands in column 1 of the next row.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("ab");
+        t.horizontalTab();
+        try t.printString("c");
+        try t.resize(alloc, .{ .cols = 12, .rows = 4 });
+        const c = t.screens.active.pages.getCell(.{ .screen = .{ .x = 1, .y = 1 } }).?;
+        try testing.expectEqual(@as(u21, 'c'), c.cell.codepoint());
+        const cont = t.screens.active.pages.getCell(.{ .screen = .{ .x = 0, .y = 1 } }).?;
+        try testing.expectEqual(Cell.tab_continuation, cont.cell.tab);
+        try testing.expectEqual(@as(size.CellCountInt, 2), t.screens.active.cursor.x);
+
+        // Widened back: one line again, c in column 8.
+        try t.resize(alloc, .{ .cols = 20, .rows = 4 });
+        const c2 = t.screens.active.pages.getCell(.{ .screen = .{ .x = 8, .y = 0 } }).?;
+        try testing.expectEqual(@as(u21, 'c'), c2.cell.codepoint());
+        try testing.expectEqual(@as(size.CellCountInt, 9), t.screens.active.cursor.x);
+    }
+}
