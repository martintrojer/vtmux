+/// True only after publication. A failed/no-op job leaves the traversal
+/// marker at its attempted node, so the following call advances.
+fn stepCompressionJob(self: *PageList, node: *List.Node) bool {
+    const pending = &self.compression_job.?;
+    if (!(pending.job.step() catch false)) {
+        self.cancelCompressionJob();
+        return false;
+    }
+    if (!pending.job.complete()) return false;
+    if (!pending.job.matches(node.page())) {
+        self.cancelCompressionJob();
+        return false;
+    }
+    const compressed = pending.job.finish() orelse {
+        self.cancelCompressionJob();
+        return false;
+    };
+    const allowed: bool = allowed: {
+        compressPage_tw.check(.decommit) catch break :allowed false;
+        break :allowed true;
+    };
+    if (!allowed or !terminal_mem.decommit(.strict, node.page().memory, node.page().memory.len)) {
+        self.cancelCompressionJob();
+        return false;
+    }
+    pending.job.output = &.{};
+    node.data = .{ .compressed = compressed };
+    self.cancelCompressionJob();
+    return true;
