+
+/// Incremental block encoding of a page snapshot. Raw grid pages are never
+/// split: only the codec input is chunked. A job owns all intermediate bytes.
+pub const Job = struct {
+    pub const block_bytes = 128 * 1024;
+    /// Copy/publish are bounded too. Larger pages remain resident.
+    pub const max_bytes = 4 * 1024 * 1024;
+    source: TerminalPage,
+    raw: []u8,
+    output: []u8,
+    pos: usize = 0,
+    used: usize = 0,
+    alloc: Allocator,
+
+    pub fn init(alloc: Allocator, source: *const TerminalPage) Allocator.Error!?Job {
+        if (source.memory.len > max_bytes) return null;
+        if (std.valgrind.runningOnValgrind() > 0)
+            std.valgrind.memcheck.makeMemDefined(source.memory);
+        const raw = try alloc.dupe(u8, source.memory);
+        errdefer alloc.free(raw);
+        const output = try alloc.alloc(u8, source.memory.len);
+        return .{ .source = source.*, .raw = raw, .output = output, .alloc = alloc };
+    }
+
+    pub fn deinit(self: *Job) void {
+        self.alloc.free(self.raw);
+        self.alloc.free(self.output);
+        self.* = undefined;
+    }
+
+    /// One independent raw LZ4 block; its four-byte length precedes it.
+    /// Return false if the complete representation cannot save memory.
+    pub fn step(self: *Job) lz4.CompressError!bool {
+        if (self.pos == self.raw.len) return true;
+        const end = @min(self.raw.len, self.pos + block_bytes);
+        if (self.output.len - self.used < 4) return false;
+        var table: lz4.HashTable = undefined;
+        const n = lz4.compress(self.raw[self.pos..end], self.output[self.used + 4 ..], &table) catch |err| switch (err) {
+            error.OutputTooSmall => return false,
+            else => return err,
+        };
+        std.mem.writeInt(u32, self.output[self.used..][0..4], @intCast(n), .little);
+        self.used += n + 4;
+        self.pos = end;
+        return true;
+    }
+
+    pub fn complete(self: *const Job) bool {
+        return self.pos == self.raw.len;
+    }
+
+    /// Validate both page metadata and every byte before publishing. In-place
+    /// writes need not bump PageList's activity token (e.g. row dirty flags).
+    pub fn matches(self: *const Job, source: *const TerminalPage) bool {
+        return std.meta.eql(self.source, source.*) and
+            std.mem.eql(u8, self.raw, source.memory);
+    }
+
+    /// Transfer encoded ownership; no full-size copy on the final step.
+    pub fn finish(self: *Job) ?Page {
+        assert(self.complete());
+        if (self.used + (@sizeOf(Page) - @sizeOf(TerminalPage)) >= self.raw.len)
+            return null;
+        // Shrink in place only: publication must not copy a whole large
+        // page's encoding on the event loop. Failure leaves it resident.
+        self.output = self.alloc.remap(self.output, self.used) orelse return null;
+        return .{
+            .page = self.source,
+            .encoded = self.output[0..self.used],
+            .allocation = self.output,
+            .chunked = true,
+            .alloc = self.alloc,
+        };
+    }
+};
+
+/// Decode independent blocks into the original contiguous page mapping.
+fn decode(self: *const Page, memory: []u8) lz4.DecompressError!void {
+    if (!self.chunked) {
+        _ = try lz4.decompress(self.encoded, memory);
+        return;
+    }
+    var ip: usize = 0;
+    var op: usize = 0;
+    while (op < memory.len) {
+        if (self.encoded.len - ip < 4) return error.TruncatedInput;
+        const n = std.mem.readInt(u32, self.encoded[ip..][0..4], .little);
+        ip += 4;
+        if (n > self.encoded.len - ip) return error.TruncatedInput;
+        const end = @min(memory.len, op + Job.block_bytes);
+        _ = try lz4.decompress(self.encoded[ip..][0..n], memory[op..end]);
+        ip += n;
+        op = end;
+    }
+    if (ip != self.encoded.len) return error.OutputSizeMismatch;
+}
+
+test "chunked Page completes with bounded codec work and exact identity" {
+    const testing = std.testing;
+    var source = try TerminalPage.init(.{ .cols = 80, .rows = 600, .styles = 50000 });
+    defer source.deinit();
+    var job = (try Job.init(testing.allocator, &source)).?;
+    defer job.deinit();
+    var steps: usize = 0;
+    while (!job.complete()) {
+        const pos = job.pos;
+        try testing.expect(try job.step());
+        try testing.expect(job.pos > pos);
+        try testing.expect(job.pos - pos <= Job.block_bytes);
+        steps += 1;
+        try testing.expect(steps < 100);
+    }
+    try testing.expect(steps > 1);
+    try testing.expect(job.matches(&source));
+    source.memory[0] ^= 1;
+    try testing.expect(!job.matches(&source));
+    source.memory[0] ^= 1;
+    var compressed = job.finish().?;
+    // finish transfers output, while the snapshot remains owned by the job.
+    job.output = &.{};
+    defer compressed.deinit();
+    @memset(source.memory, 0);
+    const restored = try compressed.restore();
+    try testing.expectEqualSlices(u8, job.raw, restored.memory);
+}
