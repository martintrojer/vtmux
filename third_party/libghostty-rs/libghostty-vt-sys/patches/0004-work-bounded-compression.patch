+    var job = (compression.Page.Job.init(self.pool.pages.allocator, node.page()) catch
+        return false) orelse return false;
+    defer job.deinit();
+    while (!job.complete()) {
+        if (!(job.step() catch false)) return false;
+    }
+    // The job's output becomes the page's encoding only on success; on any
+    // failure the deferred deinit frees it.
+    const compressed = job.finish() orelse return false;
+    const allowed: bool = allowed: {
+        compressPage_tw.check(.decommit) catch break :allowed false;
+        break :allowed true;
+    };
+    if (!allowed or !terminal_mem.decommit(.strict, node.page().memory, node.page().memory.len))
+        return false;
+    job.output = &.{};
+    node.data = .{ .compressed = compressed };
+    return true;
+}
