diff --git a/src/terminal/Terminal.zig b/src/terminal/Terminal.zig
index 1bd68ac4e..a2e1e6dd1 100644
--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -1932,6 +1932,13 @@ pub fn print(self: *Terminal, c: u21) !void {
         return;
     }
 
+    // vtmux: REP repeats the last character printed, a zero-width one
+    // too (one that joins the previous cell or is dropped): tmux keeps
+    // every character it prints as `ictx->last` (input.c input_print,
+    // input_top_bit_set) and INPUT_CSI_REP writes that one again.
+    // Upstream kept only characters that take a cell.
+    self.previous_char = c;
+
     // After doing any printing, wrapping, scrolling, etc. we want to ensure
     // that our screen remains in a consistent state.
     defer self.screens.active.assertIntegrity();
@@ -2221,9 +2228,6 @@ pub fn print(self: *Terminal, c: u21) !void {
         return;
     }
 
-    // We have a printable character, save it
-    self.previous_char = c;
-
     if (self.screens.active.cursor.pending_wrap) {
         if (self.modes.get(.wraparound)) {
             try self.printWrap();
@@ -17036,6 +17040,26 @@ test "Terminal: printRepeat stops at the end of the line (vtmux)" {
     }
 }
 
+test "Terminal: printRepeat repeats a zero-width character (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 10 });
+    defer t.deinit(alloc);
+
+    // tmux: `e`, U+0301, REP 2, `|` is one cell with three accents.
+    try t.print('e');
+    try t.print(0x301);
+    try t.printRepeat(2);
+    try t.print('|');
+    try testing.expectEqual(@as(size.CellCountInt, 2), t.screens.active.cursor.x);
+
+    {
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("e\u{301}\u{301}\u{301}|", str);
+    }
+}
+
 test "Terminal: printRepeat no previous character" {
     const alloc = testing.allocator;
     const io_impl = testing.io;
