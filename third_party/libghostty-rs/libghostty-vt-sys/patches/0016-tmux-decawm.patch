+test "Terminal: DECAWM as tmux (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // A line filled under autowrap leaves the cursor past the last
+    // column; with autowrap reset since, a character is dropped.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 3, .cols = 5 });
+        defer t.deinit(alloc);
+        try t.printString("abcde");
+        t.modes.set(.wraparound, false);
+        try t.printString("YZ");
+        try testing.expect(t.screens.active.cursor.pending_wrap);
+        try testing.expectEqual(@as(size.CellCountInt, 4), t.screens.active.cursor.x);
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("abcde", str);
+
+        // Autowrap set again: the next character wraps.
+        t.modes.set(.wraparound, true);
+        try t.printString("Q");
+        const str2 = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str2);
+        try testing.expectEqualStrings("abcde\nQ", str2);
+    }
+
+    // Filled under autowrap reset, the cursor stays on the last column:
+    // each character replaces the last, and one after autowrap is set
+    // again replaces it too, then waits to wrap.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 3, .cols = 5 });
+        defer t.deinit(alloc);
+        t.modes.set(.wraparound, false);
+        try t.printString("abcdeXY");
+        try testing.expect(!t.screens.active.cursor.pending_wrap);
+        try testing.expectEqual(@as(size.CellCountInt, 4), t.screens.active.cursor.x);
+        t.modes.set(.wraparound, true);
+        try t.printString("Z");
+        try testing.expect(t.screens.active.cursor.pending_wrap);
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("abcdZ", str);
+    }
+
+    // The main screen reflows with autowrap reset.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("abcdefghijkl\nmn");
+        t.modes.set(.wraparound, false);
+        try t.resize(alloc, .{ .cols = 6, .rows = 4 });
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("abcdef\nghijkl\nmn", str);
+    }
+}
