+/// vtmux patch 0028: switch screens as tmux does (Terminal.tmux_alternate).
+pub fn set_tmux_alternate(
+    terminal_: terminal_c.Terminal,
+    enabled: bool,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    wrapper.terminal.tmux_alternate = enabled;
+    return .success;
+}
+
+/// C: GhosttyVtmuxAltSaved
+pub const CAltSaved = extern struct {
+    size: usize = @sizeOf(CAltSaved),
+    x: u16,
+    y: u16,
+    pen: style_c.Style,
+};
+
+/// vtmux patch 0028: what `?1049h` saved (Terminal.tmux_alt_saved);
+/// GHOSTTY_NO_VALUE when nothing is.
+pub fn alternate_saved(
+    terminal_: terminal_c.Terminal,
+    out_: ?*CAltSaved,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    if (out.size < @sizeOf(CAltSaved)) return .invalid_value;
+    const saved = wrapper.terminal.tmux_alt_saved orelse return .no_value;
+    out.x = saved.x;
+    out.y = saved.y;
+    out.pen = .fromStyle(saved.style);
+    return .success;
+}
+
+/// vtmux patch 0028: set what `?1049h` saved, or clear it (null).
+pub fn set_alternate_saved(
+    terminal_: terminal_c.Terminal,
+    saved_: ?*const CAltSaved,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const saved = saved_ orelse {
+        t.tmux_alt_saved = null;
+        return .success;
+    };
+    if (saved.size < @sizeOf(CAltSaved)) return .invalid_value;
+    t.tmux_alt_saved = .{ .x = saved.x, .y = saved.y, .style = styleFromC(saved.pen) };
+    return .success;
+}
+
+/// vtmux patch 0028: the primary screen's size, which is not the
+/// terminal's while the alternate screen has left it at its old one.
+pub fn primary_size(
+    terminal_: terminal_c.Terminal,
+    cols: ?*u16,
+    rows: ?*u16,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const c = cols orelse return .invalid_value;
+    const r = rows orelse return .invalid_value;
+    const primary = wrapper.terminal.screens.get(.primary) orelse return .no_value;
+    c.* = primary.pages.cols;
+    r.* = primary.pages.rows;
+    return .success;
+}
+
+/// vtmux patch 0028: import the primary screen at this size, before its
+/// first page; the state must then have the alternate screen up.
+pub fn importer_primary_size(
+    imp_: CImporter,
+    cols: u16,
+    rows: u16,
+) callconv(lib.calling_conv) Result {
+    const imp = imp_ orelse return .invalid_value;
+    if (cols == 0 or rows == 0 or imp.builders[0] != null) return .invalid_value;
+    const t = imp.wrapper.terminal;
+    imp.primary_size = if (cols == t.cols and rows == t.rows) null else .{ .cols = cols, .rows = rows };
+    return .success;
+}
