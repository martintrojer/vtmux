 /// If the transmission fails or is abandoned (see abandonLoad), the old
 /// image is still deleted, so every way a transmission ends leaves the
 /// same images behind as deleting the old image at the start would.
+/// vtmux patch 0043: a pending (chunked) load holds no more than its
+/// storage's limit, which no image it could complete to may exceed
+/// (`addImage`). The chunk past it frees what the load holds, the chunks
+/// after it are dropped unanswered (`.over`), and the last one ends the
+/// load with `ENOMEM`, as `addImage` answers an image over the limit: one
+/// answer per transmission, at its end. Its buffer grows as `addData`'s
+/// would, capped at the limit, so what it costs is bounded too.
+const VtmuxReserve = enum { fits, over };
+
+fn vtmuxReserve(
+    storage: *ImageStorage,
+    alloc: Allocator,
+    len: usize,
+    more: bool,
+) !VtmuxReserve {
+    const loading = storage.loading.?;
+    if (!loading.vtmux_over) {
+        const need = loading.data.items.len +| len;
+        if (need <= storage.total_limit) {
+            if (need > loading.data.capacity) {
+                const grown = @max(need, loading.data.capacity *| 2);
+                try loading.data.ensureTotalCapacityPrecise(
+                    alloc,
+                    @min(grown, storage.total_limit),
+                );
+            }
+            return .fits;
+        }
+        loading.vtmux_over = true;
+        loading.data.clearAndFree(alloc);
+    }
+    if (more) return .over;
+    loading.destroy(alloc);
+    storage.loading = null;
+    return error.OutOfMemory;
+}
+
+/// vtmux patch 0043: a load's first chunk (`LoadingImage.init`) held to
+/// its storage's limit as `vtmuxReserve` holds the chunks after it. A
+/// direct chunk that fits is copied into a buffer of its size; one past
+/// the limit is not copied: alone, it fails with `ENOMEM` (`addImage`'s
+/// answer); the first of several starts the load over the limit, holding
+/// nothing, and its last chunk fails.
+fn vtmuxInit(
+    io: std.Io,
+    alloc: Allocator,
+    storage: *ImageStorage,
+    cmd: *const Command,
+) !LoadingImage {
+    const t = cmd.transmission().?;
+    if (t.medium != .direct)
+        return try LoadingImage.init(io, alloc, cmd, storage.image_limits);
+    var empty = cmd.*;
+    empty.data = "";
+    var loading = try LoadingImage.init(io, alloc, &empty, storage.image_limits);
+    errdefer loading.deinit(alloc);
+    if (cmd.data.len <= storage.total_limit) {
+        try loading.data.ensureTotalCapacityPrecise(alloc, cmd.data.len);
+        try loading.addData(alloc, cmd.data);
+    } else {
+        if (!t.more_chunks) return error.OutOfMemory;
+        loading.vtmux_over = true;
+    }
+    return loading;
+}
