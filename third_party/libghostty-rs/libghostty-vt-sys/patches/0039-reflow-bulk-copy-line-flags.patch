+test "Terminal: tmux line flags follow a bulk-copied reflow (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    const T = struct {
+        fn extended(term: *Terminal, y: usize) bool {
+            return term.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = @intCast(y) } }).?.row.tmux_extended;
+        }
+        // `input` on 10 columns, the cursor left on a row of its own (a
+        // row with a pin takes the per-cell path), reflowed to 4.
+        fn reflowed(this_io: anytype, a: Allocator, input: []const u8) !Terminal {
+            var t = try init(this_io, a, .{ .rows = 8, .cols = 10 });
+            errdefer t.deinit(a);
+            var s = t.vtStream();
+            defer s.deinit();
+            s.nextSlice(input);
+            s.nextSlice("\x1b[m\r\nX");
+            try t.resize(a, .{ .cols = 4, .rows = 8 });
+            return t;
+        }
+    };
+    // Runs of narrow cells sharing a style are copied whole
+    // (ReflowCursor.copyRun); a row they land on takes the flag, as a row
+    // writeCell writes to does (grid_set_cell). The rows tmux 3.8 flags
+    // (capture-pane -R after the cells are overwritten):
+    //
+    // An extended style: every row.
+    inline for (.{ "\x1b[53m", "\x1b[38;2;1;2;3m", "\x1b[9m" }) |pen| {
+        var t = try T.reflowed(io_impl, alloc, pen ++ "abcdefghijklmnopqrstuvwxy");
+        defer t.deinit(alloc);
+        for (0..7) |y| try testing.expect(T.extended(&t, y));
+    }
+    // A character past ASCII: its row only.
+    {
+        var t = try T.reflowed(io_impl, alloc, "abcdefghijklmn\u{e9}opqrstuvw");
+        defer t.deinit(alloc);
+        for (0..6) |y| try testing.expectEqual(y == 3, T.extended(&t, y));
+    }
+    // A background cell in an RGB colour: its row, and the line's first.
+    {
+        var t = try T.reflowed(io_impl, alloc, "abcde\x1b[48;2;9;8;7m\x1b[3X\x1b[m\x1b[3Cxyklmnopqrst");
+        defer t.deinit(alloc);
+        for (0..5) |y| try testing.expectEqual(y < 2, T.extended(&t, y));
+    }
+}
