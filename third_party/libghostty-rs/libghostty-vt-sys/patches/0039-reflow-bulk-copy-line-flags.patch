+/// vtmux: whether a run ReflowCursor.copyRun copies has a cell tmux holds
+/// in its extended form (tmuxCellExtended). The run shares one style and
+/// has no wide, tab, link or grapheme cell, so past its first cell only
+/// the character and a background cell's colour can tell.
+fn tmuxRunExtended(cells: []const pagepkg.Cell, page: *const Page) bool {
+    if (tmuxCellExtended(&cells[0], page)) return true;
+    for (cells[1..]) |*cell| switch (cell.content_tag) {
+        .codepoint => if (cell.content.codepoint.data >= 0x80 and !cell.protected) return true,
+        .bg_color_rgb => return true,
+        else => {},
+    };
+    return false;
+}
