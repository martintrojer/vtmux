+test "Terminal: reflow keeps the line break after a blank continuation (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 10 });
+    defer t.deinit(alloc);
+
+    // aaaaaaaaaa wraps onto b, which ECH erases: tmux keeps the erased cell
+    // and ccc stays on its own line after a wider reflow.
+    try t.printString("x\naaaaaaaaaab\nccc");
+    t.setCursorPos(3, 1);
+    t.eraseChars(1);
+    t.setCursorPos(6, 1);
+    try t.resize(alloc, .{ .cols = 14, .rows = 6 });
+    const str = try t.plainString(testing.allocator);
+    defer testing.allocator.free(str);
+    try testing.expectEqualStrings("x\naaaaaaaaaa\nccc", str);
+    try testing.expectEqual(@as(usize, 4), t.screens.active.cursor.y);
+}
+
+test "Terminal: reflow keeps an empty line under a wrapped line (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+    var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 10 });
+    defer t.deinit(alloc);
+
+    // SU in the region 1-2 scrolls x into history and adds an empty line
+    // under the wrapped aaaaaaaaaa: tmux's grid_reflow_join stops at the
+    // empty line, so it stays a blank line above bbb.
+    try t.printString("x\naaaaaaaaaabbb");
+    t.setTopAndBottomMargin(1, 2);
+    try t.scrollUp(1);
+    t.setTopAndBottomMargin(0, 0);
+    t.setCursorPos(6, 1);
+    try t.resize(alloc, .{ .cols = 14, .rows = 6 });
+    const str = try t.plainString(testing.allocator);
+    defer testing.allocator.free(str);
+    try testing.expectEqualStrings("aaaaaaaaaa\n\nbbb", str);
+    try testing.expectEqual(@as(usize, 5), t.screens.active.cursor.y);
+    // and the line above it stays wrapped, as tmux's does.
+    const r0 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?.row;
+    const r1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?.row;
+    try testing.expect(r0.wrap);
+    try testing.expect(!r1.wrap_continuation);
+}
