+test "Terminal: reflow measures a wide character as tmux does (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // tmux counts a wide character's padding cell too: 一 and abcdef
+    // are 9 columns to it, so g starts the second row on 9 columns.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 5, .cols = 20 });
+        defer t.deinit(alloc);
+        try t.printString("一abcdefghijklmnop");
+        try t.resize(alloc, .{ .cols = 9, .rows = 5 });
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("一abcdef\nghijklmno\np", str);
+        try testing.expectEqual(@as(size.CellCountInt, 1), t.screens.active.cursor.x);
+        try testing.expectEqual(@as(size.CellCountInt, 2), t.screens.active.cursor.y);
