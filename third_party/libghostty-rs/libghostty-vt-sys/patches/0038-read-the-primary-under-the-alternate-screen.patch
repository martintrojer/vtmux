+
+/// vtmux patch 0038: `clone_screen` of screen `screen_key` (0 primary,
+/// 1 alternate), active or not, into a new terminal of that screen's
+/// size: tmux's copy mode under the alternate screen shows the primary
+/// history, which the alternate screen leaves as it was (patch 0028).
+/// GHOSTTY_NO_VALUE when the terminal has no such screen.
+pub fn vtmux_clone_screen_of(
+    terminal_: Terminal,
+    screen_key: u8,
+    result: *Terminal,
+) callconv(lib.calling_conv) Result {
+    result.* = null;
+    const src = (terminal_ orelse return .invalid_value).terminal;
+    const screen = vtmuxScreen(src, screen_key) catch |err| return switch (err) {
+        error.InvalidValue => .invalid_value,
+        error.NoValue => .no_value,
+    };
+    result.* = cloneScreenOf(screen) catch |err| return switch (err) {
+        error.InvalidValue => .invalid_value,
+        error.OutOfMemory => .out_of_memory,
+    };
+    return .success;
+}
+
+/// vtmux patch 0038: screen `screen_key` of the terminal (0 primary,
+/// 1 alternate), active or not.
+fn vtmuxScreen(t: *ZigTerminal, screen_key: u8) error{ InvalidValue, NoValue }!*Screen {
+    const key: ScreenSet.Key = switch (screen_key) {
+        0 => .primary,
+        1 => .alternate,
+        else => return error.InvalidValue,
+    };
+    return t.screens.get(key) orelse error.NoValue;
+}
+
+fn cloneScreenOf(src_screen: *Screen) NewError!Terminal {
+    const out = try new_(null, src_screen.pages.cols, src_screen.pages.rows);
     errdefer free(out);
     const screen = out.?.terminal.screens.active;
-    const copy = src.screens.active.clone(
+    const copy = src_screen.clone(
         screen.io,
         screen.alloc,
         .{ .screen = .{} },
@@ -2216,6 +2254,46 @@ pub fn grid_ref(
     return .success;
 }
 
+/// vtmux patch 0038: `grid_ref` of point `pt` of screen `screen_key`
+/// (0 primary, 1 alternate), active or not: while the alternate screen is
+/// up the primary one is left as it was (patch 0028), and tmux goes on
+/// showing its history. The ref is a pin like any other, so the grid ref
+/// calls read and step it as they do one of the active screen.
+/// GHOSTTY_NO_VALUE when the terminal has no such screen.
+pub fn vtmux_screen_grid_ref(
+    terminal_: Terminal,
+    screen_key: u8,
+    pt: point.Point.C,
+    out_ref: ?*grid_ref_c.CGridRef,
+) callconv(lib.calling_conv) Result {
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    const screen = vtmuxScreen(t, screen_key) catch |err| return switch (err) {
+        error.InvalidValue => .invalid_value,
+        error.NoValue => .no_value,
+    };
+    const p = screen.pages.pin(.fromC(pt)) orelse return .invalid_value;
+    if (out_ref) |out| out.* = grid_ref_c.CGridRef.fromPin(p);
+    return .success;
+}
+
+/// vtmux patch 0038: the history rows of screen `screen_key`, active or
+/// not (`scrollback_rows` of the active one): the rows above its own
+/// active area, at its own size.
+pub fn vtmux_screen_scrollback_rows(
+    terminal_: Terminal,
+    screen_key: u8,
+    out: ?*usize,
+) callconv(lib.calling_conv) Result {
+    const t: *ZigTerminal = (terminal_ orelse return .invalid_value).terminal;
+    const o = out orelse return .invalid_value;
+    const screen = vtmuxScreen(t, screen_key) catch |err| return switch (err) {
+        error.InvalidValue => .invalid_value,
+        error.NoValue => .no_value,
+    };
+    o.* = screen.pages.total_rows - screen.pages.rows;
+    return .success;
+}
