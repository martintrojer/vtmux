+test "vtmux_screen_grid_ref reads the primary history under the alternate screen (vtmux)" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(null, &t, 10, 3));
+    defer free(t);
+    t.?.terminal.tmux_alternate = true;
+    var buf: [16]u8 = undefined;
+    for (0..2000) |i| {
+        const line = try std.fmt.bufPrint(&buf, "{d}\r\n", .{i});
+        vt_write(t, line.ptr, line.len);
+    }
+    var history: usize = 0;
+    try testing.expectEqual(Result.success, vtmux_screen_scrollback_rows(t, 0, &history));
+    try testing.expectEqual(@as(usize, 2000 + 1 - 3), history);
+    // Not up yet: no alternate screen.
+    try testing.expectEqual(Result.no_value, vtmux_screen_scrollback_rows(t, 1, &history));
+    try testing.expectEqual(Result.invalid_value, vtmux_screen_scrollback_rows(t, 2, &history));
+
+    const alt = "\x1b[?1049hALT";
+    vt_write(t, alt.ptr, alt.len);
+    try testing.expect(t.?.terminal.screens.active_key == .alternate);
+    // A resize under the alternate screen leaves the primary as it was.
+    try t.?.terminal.resize(t.?.terminal.gpa(), .{ .cols = 20, .rows = 5 });
+    var alt_history: usize = 99;
+    try testing.expectEqual(Result.success, vtmux_screen_scrollback_rows(t, 1, &alt_history));
+    try testing.expectEqual(@as(usize, 0), alt_history);
+    try testing.expectEqual(Result.success, vtmux_screen_scrollback_rows(t, 0, &history));
+    try testing.expectEqual(@as(usize, 2000 + 1 - 3), history);
+
+    // Every history row reads as written, looked up or stepped to.
+    var ref: grid_ref_c.CGridRef = .{};
+    try testing.expectEqual(Result.success, vtmux_screen_grid_ref(
+        t,
+        0,
+        point.Point.cval(.{ .screen = .{ .x = 0, .y = 0 } }),
+        &ref,
+    ));
+    for (0..history) |y| {
+        var looked: grid_ref_c.CGridRef = .{};
+        try testing.expectEqual(Result.success, vtmux_screen_grid_ref(
+            t,
+            0,
+            point.Point.cval(.{ .screen = .{ .x = 0, .y = @intCast(y) } }),
+            &looked,
+        ));
+        try testing.expectEqual(looked.node, ref.node);
+        try testing.expectEqual(looked.y, ref.y);
+        const p = looked.toPin().?;
+        const cells = p.node.page().getCells(p.rowAndCell().row);
+        const want = try std.fmt.bufPrint(&buf, "{d}", .{y});
+        for (want, 0..) |ch, x| try testing.expectEqual(@as(u21, ch), cells[x].codepoint());
+        if (y + 1 < history) {
+            try testing.expectEqual(Result.success, grid_ref_c.grid_ref_down(&ref, 1, &ref));
+        }
+    }
+    try testing.expectEqual(Result.invalid_value, vtmux_screen_grid_ref(
+        t,
+        0,
+        point.Point.cval(.{ .screen = .{ .x = 0, .y = @intCast(history + 3) } }),
+        &ref,
+    ));
+
+    // The clone of the primary is the primary at its own size.
+    var copy: Terminal = null;
+    try testing.expectEqual(Result.success, vtmux_clone_screen_of(t, 0, &copy));
+    defer free(copy);
+    try testing.expectEqual(@as(u16, 10), copy.?.terminal.cols);
+    try testing.expectEqual(@as(u16, 3), copy.?.terminal.rows);
+    var copied: usize = 0;
+    try testing.expectEqual(Result.success, vtmux_screen_scrollback_rows(copy, 0, &copied));
+    try testing.expectEqual(history, copied);
+    const last = try copy.?.terminal.screens.active.dumpStringAlloc(testing.allocator, .{ .screen = .{} });
+    defer testing.allocator.free(last);
+    try testing.expect(std.mem.startsWith(u8, last, "0\n1\n2\n"));
+    try testing.expect(std.mem.indexOf(u8, last, "\n1999") != null);
+    try testing.expect(std.mem.indexOf(u8, last, "ALT") == null);
+    var none: Terminal = null;
+    try testing.expectEqual(Result.invalid_value, vtmux_clone_screen_of(t, 5, &none));
+    try testing.expectEqual(@as(Terminal, null), none);
+}
