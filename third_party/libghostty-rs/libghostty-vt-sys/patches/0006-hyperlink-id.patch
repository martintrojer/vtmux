diff --git a/src/terminal/c/grid_ref.zig b/src/terminal/c/grid_ref.zig
index ebb74faf6..85c9c7ac5 100644
--- a/src/terminal/c/grid_ref.zig
+++ b/src/terminal/c/grid_ref.zig
@@ -168,6 +168,44 @@ pub fn grid_ref_hyperlink_uri(
     return .success;
 }
 
+/// vtmux: the OSC 8 id of the cell's hyperlink. `out_kind` is 0 when the
+/// cell has no hyperlink, 1 for an explicit id (its bytes go to `out_buf`,
+/// `out_len` gets the length) and 2 for an implicit one (`out_implicit`
+/// gets Ghostty's counter, which is unique per OSC 8 that opened a link
+/// without an id). OUT_OF_SPACE as for grid_ref_hyperlink_uri.
+pub fn grid_ref_hyperlink_id(
+    ref: *const CGridRef,
+    out_buf: ?[*]u8,
+    buf_len: usize,
+    out_len: *usize,
+    out_kind: *u8,
+    out_implicit: *u32,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const terminal_page = p.node.page();
+    const rac = terminal_page.getRowAndCell(p.x, p.y);
+    out_len.* = 0;
+    out_kind.* = 0;
+    out_implicit.* = 0;
+    if (!rac.cell.hyperlink) return .success;
+    const link_id = terminal_page.lookupHyperlink(rac.cell) orelse return .success;
+    const entry = terminal_page.hyperlink_set.get(terminal_page.memory, link_id);
+    switch (entry.id) {
+        .implicit => |n| {
+            out_kind.* = 2;
+            out_implicit.* = @intCast(n);
+        },
+        .explicit => |slice| {
+            const id = slice.slice(terminal_page.memory);
+            out_len.* = id.len;
+            if (out_buf == null or buf_len < id.len) return .out_of_space;
+            @memcpy(out_buf.?[0..id.len], id);
+            out_kind.* = 1;
+        },
+    }
+    return .success;
+}
