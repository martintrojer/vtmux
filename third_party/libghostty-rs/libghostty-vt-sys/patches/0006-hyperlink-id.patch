     size_t *out_written);
 
+/**
+ * Get the OSC 8 id of the hyperlink of the cell at the grid reference's
+ * position (vtmux).
+ *
+ * out_kind is 0 when the cell has no hyperlink, 1 for an explicit id
+ * (written to buf, its length to out_len) and 2 for an implicit one
+ * (out_implicit receives a counter unique to the OSC 8 that opened it).
+ * If buf is too small for an explicit id, GHOSTTY_OUT_OF_SPACE is returned
+ * with the required length in out_len.
+ *
+ * @ingroup grid_ref
+ */
+GHOSTTY_API GhosttyResult ghostty_grid_ref_hyperlink_id(
+    const GhosttyGridRef *ref,
+    uint8_t *buf,
+    size_t buf_len,
+    size_t *out_len,
+    uint8_t *out_kind,
+    uint32_t *out_implicit);
+
