--- a/src/terminal/Screen.zig
+++ b/src/terminal/Screen.zig
@@ -1661,6 +1661,24 @@ pub inline fn cursorMarkDirty(self: *Screen) void {
 /// since it's on Screen not Terminal. This needs to be addressed down the
 /// line. Not an extremely urgent issue since it's an edge case of an edge
 /// case, but not ideal.
+/// vtmux: unset the soft wrap of the row at `p` (and the continuation
+/// flag of the row below), as tmux's grid_clear_lines and grid_move_lines
+/// clear GRID_LINE_WRAPPED on the line above the lines they touch. A
+/// spacer head left at the end of the row is cleared, as in
+/// `cursorResetWrap`.
+pub fn unwrapRow(self: *Screen, p: Pin) void {
+    const row = p.rowAndCell().row;
+    if (!row.wrap) return;
+    row.wrap = false;
+    if (p.down(1)) |next| next.rowAndCell().row.wrap_continuation = false;
+    const cells = p.cells(.all);
+    const last = p.node.cols() - 1;
+    if (cells[last].wide == .spacer_head) {
+        self.clearCells(p.node.page(), row, cells[last..][0..1]);
+    }
+    p.markDirty();
+}
+
 pub fn cursorResetWrap(self: *Screen) void {
     // Reset the cursor's pending wrap state
     self.cursor.pending_wrap = false;
