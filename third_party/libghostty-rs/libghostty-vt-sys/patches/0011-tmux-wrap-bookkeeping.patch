+
+    // x / aaaaaaaaaa (wrapped) / b erased with ECH / ccc. DL on the wrapped
+    // row moves the blank continuation under x: it is a line of its own
+    // again and a wider reflow keeps it (tmux 3.8, 10x6 to 14 columns).
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("x\naaaaaaaaaab\nccc");
+        t.setCursorPos(3, 1);
+        t.eraseChars(1);
+        t.setCursorPos(2, 1);
+        t.deleteLinesTmux(1);
+        const r1 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 1 } }).?.row;
+        try testing.expect(!r1.wrap_continuation);
+        t.setCursorPos(6, 1);
+        try t.resize(alloc, .{ .cols = 14, .rows = 6 });
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("x\n\nccc", str);
+        try testing.expectEqual(@as(usize, 5), t.screens.active.cursor.y);
+    }
+
+    // SU in a region and LF at the bottom of a region that does not start
+    // at the top move rows up in place: the moved rows' continuation flags
+    // and the row below the region follow.
+    for ([_]bool{ false, true }) |lf| {
+        var t = try init(io_impl, alloc, .{ .rows = 6, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("x\naaaaaaaaaab\nccc");
