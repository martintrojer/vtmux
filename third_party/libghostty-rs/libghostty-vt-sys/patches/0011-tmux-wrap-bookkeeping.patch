+/// vtmux: without history (the alternate screen) tmux scrolls a region up
+/// with grid_move_lines (grid_view_scroll_region_up), which unwraps the
+/// line above the region; with history grid_scroll_history_region does
+/// not.
+fn tmuxUnwrapAboveRegionWithoutHistory(self: *Terminal) void {
+    if (!self.screens.active.no_scrollback) return;
+    if (self.scrolling_region.left > 0 or
+        self.scrolling_region.right < self.cols - 1) return;
+    if (self.scrolling_region.top == 0) return;
