+        const r3 = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 3 } }).?.row;
+        try testing.expect(!r1.wrap_continuation);
+        try testing.expect(!r3.wrap_continuation);
+    }
+
+    // A region from the top scrolled into history: its new blank bottom row
+    // is tmux's empty line, not a continuation, and the row below it
