+/// vtmux: a moved row keeps its wrap flags (tmux's grid_move_lines), so
+/// the continuation flag of a row whose neighbour above changed is made to
+/// follow that neighbour's wrap flag. A blank row a scroll adds is left
+/// as it is: a blank row that is not a continuation is tmux's empty line
+/// (grid_empty_line), which a reflow keeps as a line of its own even under
+/// a wrapped line (grid_reflow_join); patch 0012.
+///
+/// This one is for a full-width region scrolled up in place by one row
+/// (cursorScrollRegionUp, the cursor on its bottom row): the region's top
+/// row and the row below the region have new neighbours. The alternate
+/// screen does not reflow, so it skips this.
+fn tmuxFixRegionContinuations(self: *Terminal) void {
+    const screen = self.screens.active;
+    if (screen.no_scrollback) return;
+    const bottom = screen.cursor.page_pin.*;
+    if (bottom.up(self.scrolling_region.bottom - self.scrolling_region.top)) |top| {
+        tmuxFixContinuationAt(top);
+    }
+    if (self.scrolling_region.bottom + 1 < self.rows) {
+        if (bottom.down(1)) |below| tmuxFixContinuationAt(below);
+    }
