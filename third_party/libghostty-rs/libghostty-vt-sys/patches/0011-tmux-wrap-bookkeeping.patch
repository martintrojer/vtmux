+/// neighbour, so the hot path pays only the comparison.
+fn tmuxFixContinuationsBelowRegion(self: *Terminal) void {
+    if (self.scrolling_region.bottom + 1 >= self.rows) return;
+    if (self.screens.active.cursor.page_pin.down(1)) |below| tmuxFixContinuationAt(below);
