+
+/// vtmux: make row `p`'s continuation flag match the wrap flag of the
+/// row above it.
+fn tmuxFixContinuationAt(p: PageList.Pin) void {
+    const above = if (p.up(1)) |a| a.rowAndCell().row.wrap else false;
+    const row = p.rowAndCell().row;
+    if (row.wrap_continuation != above) {
+        row.wrap_continuation = above;
+        p.markDirty();
+    }
