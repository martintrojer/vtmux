+/// vtmux patch 0041: a pending (chunked) load holds no more than its
+/// storage's limit, which no image it could complete to may exceed
+/// (`addImage`). The chunk past it frees what the load holds, the chunks
+/// after it are dropped unanswered (`.over`), and the last one ends the
+/// load with `ENOMEM`, as `addImage` answers an image over the limit: one
+/// answer per transmission, at its end. Its buffer grows as `addData`'s
+/// would, capped at the limit, so what it costs is bounded too.
+const VtmuxReserve = enum { fits, over };
+
+fn vtmuxReserve(
+    storage: *ImageStorage,
+    alloc: Allocator,
+    len: usize,
+    more: bool,
+) !VtmuxReserve {
+    const loading = storage.loading.?;
+    if (!loading.vtmux_over) {
+        const need = loading.data.items.len +| len;
+        if (need <= storage.total_limit) {
+            if (need > loading.data.capacity) {
+                const grown = @max(need, loading.data.capacity *| 2);
+                try loading.data.ensureTotalCapacityPrecise(
+                    alloc,
+                    @min(grown, storage.total_limit),
+                );
+            }
+            return .fits;
+        }
+        loading.vtmux_over = true;
+        loading.data.clearAndFree(alloc);
+    }
+    if (more) return .over;
+    loading.destroy(alloc);
+    storage.loading = null;
+    return error.OutOfMemory;
+}
