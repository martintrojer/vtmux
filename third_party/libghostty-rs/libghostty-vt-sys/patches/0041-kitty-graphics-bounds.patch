+/// vtmux patch 0041: the bytes screen `key`'s (0 primary, 1 alternate)
+/// pending kitty load holds, a chunked transmission not finished yet
+/// (`ImageStorage.loading`): its buffer's capacity, what it costs. 0 for
+/// none or a screen not initialized.
+pub fn kitty_loading(
+    terminal_: terminal_c.Terminal,
+    key: u8,
+    bytes: ?*u64,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const b = bytes orelse return .invalid_value;
+    if (key > 1) return .invalid_value;
+    b.* = 0;
+    if (comptime !build_options.kitty_graphics) return .success;
+    const screen = wrapper.terminal.screens.get(if (key == 0) .primary else .alternate) orelse
+        return .success;
+    if (screen.kitty_images.loading) |loading| b.* = loading.data.capacity;
+    return .success;
+}
+
+/// vtmux patch 0041: abandon screen `key`'s pending kitty load, as a
+/// delete command does (`graphics_exec.zig` `delete`). Its next chunk
+/// starts a new transmission.
+pub fn drop_kitty_loading(
+    terminal_: terminal_c.Terminal,
+    key: u8,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (key > 1) return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .success;
+    const screen = wrapper.terminal.screens.get(if (key == 0) .primary else .alternate) orelse
+        return .success;
+    if (screen.kitty_images.loading) |loading| {
+        loading.destroy(screen.alloc);
+        screen.kitty_images.loading = null;
+    }
+    return .success;
+}
+
