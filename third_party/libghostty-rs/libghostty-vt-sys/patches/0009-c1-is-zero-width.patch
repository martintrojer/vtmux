+test "Terminal: C1 control joins the previous cell (vtmux)" {
+    var t = try init(testing.io, testing.allocator, .{ .rows = 5, .cols = 10 });
+    defer t.deinit(testing.allocator);
+
+    try t.print('a');
+    try t.print(0x85);
+    try t.print('b');
+    try testing.expectEqual(@as(usize, 2), t.screens.active.cursor.x);
+    const cell = t.screens.active.pages.getCell(.{ .screen = .{ .x = 0, .y = 0 } }).?;
+    try testing.expect(cell.cell.hasGrapheme());
+
+    // With grapheme clustering too.
+    t.modes.set(.grapheme_cluster, true);
+    try t.print(0x80);
+    try testing.expectEqual(@as(usize, 2), t.screens.active.cursor.x);
+}
