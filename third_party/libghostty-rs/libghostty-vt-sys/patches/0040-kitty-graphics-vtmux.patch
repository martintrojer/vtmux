+/// vtmux patch 0040: screen `key`'s (0 primary, 1 alternate) kitty image
+/// storage, the bytes its images hold and its limit. A screen not yet
+/// initialized holds nothing and has the primary's limit, which it takes
+/// when it starts (`Terminal.switchScreen`).
+pub fn kitty_storage(
+    terminal_: terminal_c.Terminal,
+    key: u8,
+    bytes: ?*u64,
+    limit: ?*u64,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    const b = bytes orelse return .invalid_value;
+    const l = limit orelse return .invalid_value;
+    if (key > 1) return .invalid_value;
+    b.* = 0;
+    l.* = 0;
+    if (comptime !build_options.kitty_graphics) return .success;
+    const screens = &wrapper.terminal.screens;
+    const screen = screens.get(if (key == 0) .primary else .alternate) orelse
+        screens.get(.primary) orelse return .no_value;
+    l.* = screen.kitty_images.total_limit;
+    if (screens.get(if (key == 0) .primary else .alternate) != null)
+        b.* = screen.kitty_images.total_bytes;
+    return .success;
+}
+
+/// vtmux patch 0040: set the kitty image storage limit of screen `key`
+/// alone (`ghostty_terminal_set` sets every screen's). Lowering it evicts
+/// as Ghostty does (`ImageStorage.setLimit`: unused images first, then the
+/// oldest); 0 deletes every image. A screen not yet initialized is left:
+/// it takes the primary's limit when it starts.
+pub fn set_kitty_limit(
+    terminal_: terminal_c.Terminal,
+    key: u8,
+    limit: u64,
+) callconv(lib.calling_conv) Result {
+    const wrapper = terminal_ orelse return .invalid_value;
+    if (key > 1) return .invalid_value;
+    if (comptime !build_options.kitty_graphics) return .success;
+    const screen = wrapper.terminal.screens.get(if (key == 0) .primary else .alternate) orelse
+        return .no_value;
+    screen.kitty_images.setLimit(screen.io, screen.alloc, screen, @intCast(limit));
+    return .success;
+}
