+/// vtmux patch 0040: the placement's top-left cell, its row relative to
+/// the active area's top row: negative is in history, however far up, as
+/// `placement_viewport_pos` would give it with no visibility cut (vtmux
+/// draws history rows itself, in copy mode). GHOSTTY_NO_VALUE for a
+/// virtual placement or a chain rooted at one.
+pub fn vtmux_placement_active_pos(
+    iter_: PlacementIterator,
+    terminal_: terminal_c.Terminal,
+    out_col: *i32,
+    out_row: *i32,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+
+    const wrapper = terminal_ orelse return .invalid_value;
+    const iter = iter_ orelse return .invalid_value;
+    const entry = iter.entry orelse return .invalid_value;
+    const t = wrapper.terminal;
+    var col_offset: i32 = 0;
+    var row_offset: i32 = 0;
+    const pin: *const PageList.Pin = switch (entry.value_ptr.location) {
+        .pin => |pin| pin,
+        .virtual => return .no_value,
+        .relative => |rel| pin: {
+            const chain = t.screens.active.kitty_images.resolveChain(rel) orelse
+                return .no_value;
+            switch (chain.root.location) {
+                .pin => |root_pin| {
+                    col_offset = chain.horizontal_offset;
+                    row_offset = chain.vertical_offset;
+                    break :pin root_pin;
+                },
+                .virtual => return .no_value,
+                .relative => unreachable, // resolveChain roots are never relative
+            }
+        },
+    };
+    if (pin.garbage) return .no_value;
+    const pages = &t.screens.active.pages;
+    const pin_screen = pages.pointFromPin(.screen, pin.*) orelse return .no_value;
+    const top = pages.pointFromPin(.screen, pages.getTopLeft(.active)) orelse
+        return .no_value;
+    out_row.* = (@as(i32, @intCast(pin_screen.screen.y)) -
+        @as(i32, @intCast(top.screen.y))) +| row_offset;
+    out_col.* = @as(i32, @intCast(pin_screen.screen.x)) +| col_offset;
+    return .success;
+}
