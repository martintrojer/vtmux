     }
 
     try t.print('X');
@@ -12488,6 +12496,37 @@ test "Terminal: eraseChars resets wrap" {
         defer testing.allocator.free(str);
         try testing.expectEqualStrings("XBCDE\n123", str);
     }
+
+    // vtmux: ECH over the whole row from its start is tmux's
+    // grid_clear_lines, which empties the line, its wrap flag too.
+    t.setCursorPos(1, 1);
+    t.eraseChars(5);
+    {
+        const list_cell = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 0 } }).?;
+        try testing.expect(!list_cell.row.wrap);
+    }
+}
+
+test "Terminal: eraseChars widened over a wide character keeps the wrap (vtmux)" {
+    const alloc = testing.allocator;
+    var t = try init(testing.io, alloc, .{ .rows = 5, .cols = 5 });
+    defer t.deinit(alloc);
+
+    // ABCDE / abc + a wide character in the last two columns / 1: ECH 4 at
+    // column 0 widens to 5 over the wide character, but tmux's nx is 4,
+    // not the width (grid_clear): no line is unwrapped or emptied
+    // (reference tmux 3.8: `capture-pane -pF` shows W, WX).
+    try t.printString("ABCDEabc\u{4E00}1");
+    t.setCursorPos(2, 1);
+    t.eraseChars(4);
+    try testing.expect(testActiveRow(&t, 0).wrap);
+    try testing.expect(testActiveRow(&t, 1).wrap);
+    try testing.expect(testActiveRow(&t, 1).tmux_used != 0);
+    {
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("ABCDE\n\n1", str);
+    }
 }
 
