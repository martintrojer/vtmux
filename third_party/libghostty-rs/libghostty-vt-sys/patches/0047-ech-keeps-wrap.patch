@@ -5148,6 +5148,12 @@ pub fn eraseChars(self: *Terminal, count_req: usize) void {
     // vtmux: and ECH (screen_write_clearcharacter).
     if (self.screens.active.cursor.pending_wrap) return;
 
+    // vtmux: tmux's ECH clears the whole line (grid_clear_lines) when the
+    // count it asks for, before any widening for a wide character below,
+    // covers the line from column 0 (grid_clear: `nx == gd->sx`).
+    const whole_line = self.screens.active.cursor.x == 0 and
+        @max(count_req, 1) >= self.cols;
+
     const count = end: {
         const remaining = self.cols - self.screens.active.cursor.x;
         var end = @min(remaining, @max(count_req, 1));
@@ -5170,12 +5176,12 @@ pub fn eraseChars(self: *Terminal, count_req: usize) void {
     self.screens.active.splitCellBoundary(self.screens.active.cursor.x);
     self.screens.active.splitCellBoundary(self.screens.active.cursor.x + count);
 
-    // Reset our row's soft-wrap.
-    self.screens.active.cursorResetWrap();
-
     // vtmux: ECH over the whole line is tmux's grid_clear_lines: the line
-    // is emptied (cellused 0) and the line above unwrapped.
-    if (self.screens.active.cursor.x == 0 and count >= self.cols) {
+    // is emptied (cellused 0), unwrapped, and the line above unwrapped.
+    // Any other ECH is grid_clear, which keeps the line's GRID_LINE_WRAPPED
+    // (screen_write_clearcharacter).
+    if (whole_line) {
+        self.screens.active.cursorResetWrap();
         self.screens.active.cursor.page_row.tmuxEmptied();
         self.tmuxUnwrapAbove(self.screens.active.cursor.y);
     }
@@ -12476,9 +12482,11 @@ test "Terminal: eraseChars resets wrap" {
