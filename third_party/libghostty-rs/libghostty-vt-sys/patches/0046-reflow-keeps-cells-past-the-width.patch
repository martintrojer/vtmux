+/// at past its last cell only when that cell is not empty (an erase with a
+/// background to the end of the line, EL or ED) or it keeps cells already,
+/// so a page of ordinary lines costs a cell a row; a line whose background
+/// stops short of its end (ECH) keeps its cells as far as the destination
+/// page holds them.
+fn tmuxKeptCols(page: *const Page, cols: size.CellCountInt) size.CellCountInt {
+    var need: size.CellCountInt = 0;
+    const rows = page.rows.ptr(page.memory)[0..page.size.rows];
+    for (rows) |*row| {
+        if (row.wrap) continue;
+        const len = if (row.tmux_kept) page.capacity.cols else page.size.cols;
+        if (len <= cols or len <= need) continue;
+        const cells = row.cells.ptr(page.memory)[0..len];
+        if (!row.tmux_kept and cells[len - 1].isEmpty()) continue;
+        var end: usize = len;
+        while (end > cols and end > need and cells[end - 1].isEmpty()) end -= 1;
+        if (end <= cols or end <= need) continue;
+        if (row.tmuxCellsUsed(cells[0..page.size.cols]) > cols) continue;
+        need = @intCast(end);
+    }
+    return need;
