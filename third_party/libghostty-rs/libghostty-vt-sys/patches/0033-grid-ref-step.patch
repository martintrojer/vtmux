     return .success;
 }
 
+/// vtmux: the reference `n` rows below `ref` (x kept, or the last column
+/// of a narrower page), in a step along the page list from the ref's own
+/// page rather than a walk from the top: a reader going through the rows
+/// in order resolves each in constant time. INVALID_VALUE for a null node
+/// or a row past the end. Valid while the page list is unchanged, as any
+/// grid ref.
+pub fn grid_ref_down(
+    ref: *const CGridRef,
+    n: usize,
+    out: ?*CGridRef,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const moved = p.down(n) orelse return .invalid_value;
+    if (out) |o| o.* = .fromPin(moved);
+    return .success;
+}
+
+/// vtmux: as grid_ref_down, `n` rows above `ref`.
+pub fn grid_ref_up(
+    ref: *const CGridRef,
+    n: usize,
+    out: ?*CGridRef,
+) callconv(lib.calling_conv) Result {
+    const p = ref.toPin() orelse return .invalid_value;
+    const moved = p.up(n) orelse return .invalid_value;
+    if (out) |o| o.* = .fromPin(moved);
+    return .success;
+}
+
 pub fn grid_ref_graphemes(
     ref: *const CGridRef,
     out_buf: ?[*]u32,
@@ -312,3 +341,76 @@ test "grid_ref_hyperlink_uri with hyperlink" {
     try testing.expectEqual(Result.success, grid_ref_hyperlink_uri(&ref, &buf, buf.len, &len));
     try testing.expectEqualStrings("https://example.com", buf[0..len]);
 }
+
+test "grid_ref_down and grid_ref_up null node" {
+    const ref = CGridRef{};
+    var out: CGridRef = undefined;
+    try testing.expectEqual(Result.invalid_value, grid_ref_down(&ref, 1, &out));
+    try testing.expectEqual(Result.invalid_value, grid_ref_up(&ref, 1, &out));
+}
+
+test "grid_ref_down and grid_ref_up step as a lookup resolves (vtmux)" {
+    var terminal: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(
+        &lib.alloc.test_allocator,
+        &terminal,
+        80,
+        4,
+    ));
+    defer terminal_c.free(terminal);
+    try testing.expectEqual(
+        Result.success,
+        terminal_c.set(terminal, .scrollback_max_bytes, null),
+    );
+
+    // Enough lines for history over several pages.
+    var buf: [32]u8 = undefined;
+    for (0..3000) |i| {
+        const line = try std.fmt.bufPrint(&buf, "\r\nline {d}", .{i});
+        terminal_c.vt_write(terminal, line.ptr, line.len);
+    }
+    const list = &terminal.?.terminal.screens.active.pages;
+    try testing.expect(list.pages.first != list.pages.last);
+    const total = list.total_rows;
+
+    const at = struct {
+        fn at(t: terminal_c.Terminal, y: usize) CGridRef {
+            var r: CGridRef = undefined;
+            std.debug.assert(terminal_c.grid_ref(
+                t,
+                point.Point.cval(.{ .screen = .{ .x = 0, .y = @intCast(y) } }),
+                &r,
+            ) == .success);
+            return r;
+        }
+    }.at;
+
+    // One row at a time, both ways, and in strides that cross pages.
+    var down = at(terminal, 0);
+    var up = at(terminal, total - 1);
+    for (1..total) |y| {
+        try testing.expectEqual(Result.success, grid_ref_down(&down, 1, &down));
+        const want = at(terminal, y);
+        try testing.expectEqual(want.node, down.node);
+        try testing.expectEqual(want.y, down.y);
+        try testing.expectEqual(Result.success, grid_ref_up(&up, 1, &up));
+        const want_up = at(terminal, total - 1 - y);
+        try testing.expectEqual(want_up.node, up.node);
+        try testing.expectEqual(want_up.y, up.y);
+    }
+    const first = at(terminal, 0);
+    var stride: CGridRef = undefined;
+    try testing.expectEqual(Result.success, grid_ref_down(&first, 2999, &stride));
+    try testing.expectEqual(at(terminal, 2999).node, stride.node);
+    try testing.expectEqual(at(terminal, 2999).y, stride.y);
+    try testing.expectEqual(Result.success, grid_ref_up(&stride, 2998, &stride));
+    try testing.expectEqual(at(terminal, 1).y, stride.y);
+
+    // Past either end.
+    var out: CGridRef = undefined;
+    try testing.expectEqual(Result.invalid_value, grid_ref_up(&first, 1, &out));
+    const last = at(terminal, total - 1);
+    try testing.expectEqual(Result.invalid_value, grid_ref_down(&last, 1, &out));
+    try testing.expectEqual(Result.success, grid_ref_down(&first, total - 1, &out));
+    try testing.expectEqual(Result.invalid_value, grid_ref_down(&first, total, &out));
+}
