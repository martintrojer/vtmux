+test "Terminal: reflow joins a wrapped row by the cells it used (vtmux)" {
+    const alloc = testing.allocator;
+    const io_impl = testing.io;
+
+    // A wide character that does not fit an empty row wraps it with no
+    // cell written (tmux's cellused 0, the row a dead pane's linefeed
+    // marks): it joins nothing to the line after it.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        t.setCursorPos(3, 10);
+        try t.print(0x4E00);
+        t.setCursorPos(4, 1);
+        t.eraseChars(2);
+        try t.printString("DEAD");
+        const c = t.screens.active.pages.getCell(.{ .active = .{ .x = 0, .y = 2 } }).?;
+        try testing.expect(c.row.wrap);
+        try testing.expectEqual(@as(size.CellCountInt, 0), c.row.tmux_used);
+        try t.resize(alloc, .{ .cols = 8, .rows = 4 });
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("\n\nDEAD", str);
+    }
+
+    // Text short of the width: only its cells join, so a wider pane puts
+    // the next line straight after it.
+    {
+        var t = try init(io_impl, alloc, .{ .rows = 4, .cols = 10 });
+        defer t.deinit(alloc);
+        try t.printString("ab");
+        t.setCursorPos(1, 10);
+        try t.print(0x4E00);
+        t.setCursorPos(2, 1);
+        t.eraseChars(2);
+        try t.printString("cd");
+        try t.resize(alloc, .{ .cols = 20, .rows = 4 });
+        const str = try t.plainString(testing.allocator);
+        defer testing.allocator.free(str);
+        try testing.expectEqualStrings("abcd", str);
+    }
+}
