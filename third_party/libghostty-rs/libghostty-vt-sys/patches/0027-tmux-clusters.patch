+/// vtmux: mode 2027 joins characters into a cell as tmux's
+/// `screen_write_combine` does (screen-write.c), not by UAX #29: see
+/// `Terminal.tmuxCombine`. Process-wide like the width overrides; set
+/// with `setTmuxClusters`.
+pub var tmux_clusters: bool = false;
+
+/// vtmux: tmux's `variation-selector-always-wide`: under `tmux_clusters`,
+/// U+FE0F joined to a one-column cell makes it two columns.
+pub var tmux_vs16_wide: bool = true;
+
+/// vtmux: turn tmux's clustering on or off. Not safe while another
+/// thread prints.
+pub fn setTmuxClusters(enabled: bool, vs16_wide: bool) void {
+    tmux_clusters = enabled;
+    tmux_vs16_wide = vs16_wide;
+}
+
+/// vtmux: tmux's Hangul jamo classes (utf8-combined.c
+/// `hanguljamo_get_class`), old and extended jamo included.
+pub const TmuxJamo = enum { none, choseong, jungseong, jongseong };
+
+pub fn tmuxJamo(cp: u21) TmuxJamo {
+    return switch (cp) {
+        0x1100...0x115F, 0xA960...0xA97C => .choseong,
+        0x1160...0x11A7, 0xD7B0...0xD7C6 => .jungseong,
+        0x11A8...0x11FF, 0xD7CB...0xD7FB => .jongseong,
+        else => .none,
+    };
+}
+
+pub inline fn tmuxIsRegional(cp: u21) bool {
+    return cp >= 0x1F1E6 and cp <= 0x1F1FF;
+}
+
+/// vtmux: the characters tmux's own width table makes two columns that
+/// are text presentation (vtmux_core::width::TEXT_PRESENTATION, D-045):
+/// one column alone in vtmux's grid, as in Ghostty's table, but two after a
+/// ZWJ joins them, where tmux's cell keeps its base's two columns and
+/// Ghostty draws the emoji sequence two wide.
+pub fn tmuxTextPresentation(cp: u21) bool {
+    return switch (cp) {
+        0x261D, 0x26F9, 0x270C, 0x270D, 0x1F3CB, 0x1F3CC, 0x1F574, 0x1F575, 0x1F590 => true,
+        else => false,
+    };
+}
+
+/// vtmux: tmux's `utf8_should_combine(with, add)` (utf8-combined.c),
+/// which looks at the first character of each side: two lone regional
+/// indicators, or an emoji skin-tone modifier (`with`) and one of the
+/// characters tmux lists as taking one (`add`). `with_ri` and `add_ri`
+/// count the regional indicators in each side's whole cell.
+pub fn tmuxShouldCombine(with: u21, with_ri: usize, add: u21, add_ri: usize) bool {
+    if (tmuxIsRegional(add) and tmuxIsRegional(with)) return with_ri == 1 and add_ri == 1;
+    const skin_base = switch (add) {
+        0x1F44B...0x1F450,
+        0x1F466...0x1F469,
+        0x1F46E,
+        0x1F470...0x1F478,
+        0x1F47C,
+        0x1F481...0x1F483,
+        0x1F485...0x1F487,
+        0x1F4AA,
+        0x1F575,
+        0x1F57A,
+        0x1F590,
+        0x1F595,
+        0x1F596,
+        0x1F645...0x1F647,
+        0x1F64B...0x1F64F,
+        0x1F6B4...0x1F6B6,
+        0x1F926,
+        0x1F937...0x1F939,
+        0x1F93D,
+        0x1F93E,
+        0x1F9B5,
+        0x1F9B6,
+        0x1F9B8,
+        0x1F9B9,
+        0x1F9CD...0x1F9CF,
+        0x1F9D1...0x1F9DF,
+        => true,
+        else => false,
+    };
+    return skin_base and with >= 0x1F3FB and with <= 0x1F3FF;
+}
+
+/// vtmux: whether tmux could join `cp` (a character with a width) to a
+/// cell holding only `prev`, or drop it: false means `cp` takes a cell of
+/// its own. The print fast paths batch only such characters.
+pub fn tmuxMayJoin(prev: u21, cp: u21) bool {
+    if (cp == 0x3164 or prev == 0x200D) return true;
+    switch (tmuxJamo(cp)) {
+        .jungseong, .jongseong => return true,
+        .choseong, .none => {},
+    }
+    const prev_ri: usize = @intFromBool(tmuxIsRegional(prev));
+    const cp_ri: usize = @intFromBool(tmuxIsRegional(cp));
+    return tmuxShouldCombine(prev, prev_ri, cp, cp_ri) or
+        tmuxShouldCombine(cp, cp_ri, prev, prev_ri);
+}
