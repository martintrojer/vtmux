+/// vtmux: what tmux's `screen_write_combine` (screen-write.c) does with
+/// `c` written after the cell `prev`, which has text.
+const TmuxCombine = enum {
+    /// `c` takes a cell of its own.
+    own,
+    /// `c` is dropped.
+    dropped,
+    /// `c` joins `prev`.
+    joined,
+    /// `c` joins `prev`, which becomes two columns if it was one.
+    joined_wide,
+};
+
+fn tmuxCombine(self: *Terminal, prev: *const Cell, c: u21) TmuxCombine {
+    const width: u2 = if (c >= 0x80 and c <= 0x9F) 0 else unicode.printWidth(c);
+    // A character that makes no sense on its own: dropped when it
+    // cannot join.
+    const zero_width = c == 0x200D or c == 0xFE0F or width == 0;
+    var force_wide = c == 0xFE0F and unicode.tmux_vs16_wide;
+    const alone: TmuxCombine = if (zero_width) .dropped else .own;
+
+    const base: u21 = prev.content.codepoint.data;
+    const rest: []const u21 = if (prev.hasGrapheme())
+        self.screens.active.cursor.page_pin.node.page().lookupGrapheme(prev).?
+    else
+        &.{};
+    const last: u21 = if (rest.len > 0) rest[rest.len - 1] else base;
+
+    if (!zero_width) {
+        // hanguljamo_check_state: a medial jamo joins an initial one, a
+        // final jamo a medial one; otherwise either is dropped.
+        switch (unicode.tmuxJamo(c)) {
+            .choseong => return .own,
+            .jungseong => if (unicode.tmuxJamo(last) != .choseong) return .dropped,
+            .jongseong => if (unicode.tmuxJamo(last) != .jungseong) return .dropped,
+            .none => {
+                var cell_ri: usize = @intFromBool(unicode.tmuxIsRegional(base));
+                for (rest) |cp| cell_ri += @intFromBool(unicode.tmuxIsRegional(cp));
+                const c_ri: usize = @intFromBool(unicode.tmuxIsRegional(c));
+                if (unicode.tmuxShouldCombine(base, cell_ri, c, c_ri) or
+                    unicode.tmuxShouldCombine(c, c_ri, base, cell_ri))
+                    force_wide = true
+                else if (last != 0x200D)
+                    return .own
+                else if (unicode.tmuxTextPresentation(base))
+                    // tmux's cell keeps its base's two columns (D-045).
+                    force_wide = true;
+            },
+        }
+    }
+
+    // A tmux cell holds at most 32 bytes of UTF-8 (UTF8_SIZE).
+    var bytes: usize = std.unicode.utf8CodepointSequenceLength(c) catch 4;
+    bytes += std.unicode.utf8CodepointSequenceLength(base) catch 4;
+    for (rest) |cp| bytes += std.unicode.utf8CodepointSequenceLength(cp) catch 4;
+    if (bytes > 32) return alone;
+
+    return if (force_wide) .joined_wide else .joined;
+}
