+test "PageList clone copies whole pages with their styles and graphemes (vtmux)" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var s = try init(alloc, .{ .cols = 80, .rows = 24 });
+    defer s.deinit();
+    try s.growColdPagesForTest(3);
+    const total = s.totalRows();
+
+    // Every row: a cell of one of three styles, a grapheme cluster in
+    // every hundredth (a page holds few), the rest plain.
+    for (0..total) |y| {
+        const p = s.pin(.{ .screen = .{ .y = @intCast(y) } }).?;
+        const page = p.node.page();
+        const rac = p.rowAndCell();
+        rac.cell.* = .init(@intCast('a' + y % 26));
+        const style: stylepkg.Style = .{ .flags = .{
+            .bold = y % 3 == 0,
+            .italic = y % 3 == 1,
+            .underline = if (y % 3 == 2) .double else .none,
+        } };
+        const id = try page.styles.add(page.memory, style);
+        rac.cell.style_id = id;
+        rac.row.styled = true;
+        if (y % 100 == 0) {
+            const next = p.right(1).rowAndCell();
+            next.cell.* = .init('e');
+            try page.appendGrapheme(rac.row, next.cell, 0x301);
+        }
+    }
+
+    var s2 = try s.clone(alloc, .{ .top = .{ .screen = .{} } });
+    defer s2.deinit();
+    try testing.expectEqual(total, s2.totalRows());
+
+    const check = struct {
+        fn rows(a: *const PageList, b: *const PageList, n: usize) !void {
+            for (0..n) |y| {
+                const pa = a.pin(.{ .screen = .{ .y = @intCast(y) } }).?;
+                const pb = b.pin(.{ .screen = .{ .y = @intCast(y) } }).?;
+                try testing.expect(pa.node.page().memory.ptr != pb.node.page().memory.ptr);
+                for (0..2) |x| {
+                    const ca = pa.right(x).rowAndCell().cell;
+                    const cb = pb.right(x).rowAndCell().cell;
+                    try testing.expectEqual(ca.content.codepoint, cb.content.codepoint);
+                    try testing.expectEqual(ca.hasGrapheme(), cb.hasGrapheme());
+                    if (ca.hasGrapheme()) try testing.expectEqualSlices(
+                        u21,
+                        pa.node.page().lookupGrapheme(ca).?,
+                        pb.node.page().lookupGrapheme(cb).?,
+                    );
+                    try testing.expectEqual(ca.style_id == 0, cb.style_id == 0);
+                    if (ca.style_id == 0) continue;
+                    const sa = pa.node.page().styles.get(pa.node.page().memory, ca.style_id);
+                    const sb = pb.node.page().styles.get(pb.node.page().memory, cb.style_id);
+                    try testing.expect(sa.eql(sb.*));
+                }
+            }
+        }
+    };
+    try check.rows(&s, &s2, total);
+    var n = s2.pages.first;
+    while (n) |node| : (n = node.next) node.page().assertIntegrity();
+
+    // Every page is whole, so each is copied byte for byte (cloned row by
+    // row, the style sets differ).
+    var a = s.pages.first;
+    var b = s2.pages.first;
+    while (a) |na| : ({
+        a = na.next;
+        b = b.?.next;
+    }) try testing.expectEqualSlices(u8, na.page().memory, b.?.page().memory);
+    try testing.expect(b == null);
+
+    // The copy is its own: changing the source changes nothing in it.
+    const first = s.pin(.{ .screen = .{} }).?.rowAndCell();
+    first.cell.content.codepoint.data = 'Z';
+    try testing.expectEqual(
+        @as(u21, 'a'),
+        s2.pin(.{ .screen = .{} }).?.rowAndCell().cell.content.codepoint.data,
+    );
+}
