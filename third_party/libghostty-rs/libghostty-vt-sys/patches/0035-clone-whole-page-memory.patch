+/// vtmux: `src.cloneBuf(dst.memory)` for `dst`, a new page of `src`'s
+/// capacity as `initBuf` leaves it: its memory zero (pool items and page
+/// allocations come zeroed, see `createPageExt`) but for the row headers.
+/// The row headers and cells are copied whole; each set or allocator of
+/// the metadata block only when it holds anything, else the copy keeps
+/// `dst`'s, empty: a page's memory never touched is not committed, and
+/// reading it to copy it faulted in a zero page each time (a plain
+/// `cloneBuf`, or one that skipped zero memory pages, took copy mode's
+/// entry over 1M lines 20-30 ms longer the first time).
+fn cloneWholePage(src: *const Page, dst: *const Page) Page {
+    const len = src.memory.len;
+    assert(dst.memory.len == len);
+    const l = Page.layout(src.capacity);
+    var result = src.*;
+    result.memory = dst.memory;
+    const copy = struct {
+        fn range(to: []u8, from: []const u8, start: usize, end: usize) void {
+            @memcpy(to[start..end], from[start..end]);
+        }
+    }.range;
+    copy(result.memory, src.memory, 0, l.styles_start);
+    if (src.styles.count() > 0) {
+        copy(result.memory, src.memory, l.styles_start, l.grapheme_alloc_start);
+    } else {
+        result.styles = dst.styles;
+    }
+    if (src.graphemeCount() > 0) {
+        copy(result.memory, src.memory, l.grapheme_alloc_start, l.string_alloc_start);
+    } else {
+        result.grapheme_alloc = dst.grapheme_alloc;
+        result.grapheme_map = dst.grapheme_map;
+    }
+    if (src.hyperlinkCount() > 0 or src.hyperlink_set.count() > 0) {
+        copy(result.memory, src.memory, l.string_alloc_start, len);
+    } else {
+        result.string_alloc = dst.string_alloc;
+        result.hyperlink_set = dst.hyperlink_set;
+        result.hyperlink_map = dst.hyperlink_map;
+    }
+    return result;
+}
