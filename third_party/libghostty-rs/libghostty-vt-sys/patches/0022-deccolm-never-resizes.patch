+test "DECCOLM never resizes, with DEC mode 40 or without (vtmux)" {
+    var t: Terminal = try .init(testing.io, testing.allocator, .{ .cols = 30, .rows = 6 });
+    defer t.deinit(testing.allocator);
+
+    var s: Stream = .init(.{ .allocator = testing.allocator, .handler = .init(&t) });
+    defer s.deinit();
+
+    s.nextSlice("abc\r\ndef\x1b[?40h\x1b[?3h");
+    try testing.expectEqual(@as(usize, 30), t.cols);
+    s.nextSlice("\x1b[?40;3l");
+    try testing.expectEqual(@as(usize, 30), t.cols);
+
+    const str = try t.plainString(testing.allocator);
+    defer testing.allocator.free(str);
+    try testing.expectEqualStrings("abc\ndef", str);
+}
