--- a/regress/copy-mode-test-emacs.sh
+++ b/regress/copy-mode-test-emacs.sh
@@ -10,6 +10,14 @@
 $TMUX new -d -x40 -y10 \
       "cat copy-mode-test.txt; printf '\e[9;15H'; cat" || exit 1
 $TMUX set -g window-size manual || exit 1
+# vtmux (compat/tmux-3.8/README.md, Test races): copy mode copies the screen
+# when it starts, and the pane program may not have printed yet; wait (max
+# 10 s) for the printf's cursor move.
+n=0
+while [ "$($TMUX display -p '#{cursor_x} #{cursor_y}')" != "14 8" ] &&
+    [ $n -lt 100 ]; do
+	sleep 0.1; n=$((n+1))
+done
 
 # Enter copy mode and go to the first column of the first row.
 $TMUX set-window-option -g mode-keys emacs
