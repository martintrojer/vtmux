--- a/regress/screen-redraw-scrollbars.sh
+++ b/regress/screen-redraw-scrollbars.sh
@@ -135,6 +135,12 @@
 $TMUX2 resizew -x40 -y12 || exit 1
 $TMUX2 setw pane-scrollbars-position right || exit 1
 $TMUX2 setw pane-scrollbars-style "bg=black,fg=white,width=1,pad=0" || exit 1
+# vtmux (compat/tmux-3.8/README.md, Test races): copy mode copies the screen
+# when it starts; wait (max 10 s) for seq's last line first.
+n=0
+while ! $TMUX2 capturep -p | grep -qx 40 && [ $n -lt 100 ]; do
+	sleep 0.1; n=$((n+1))
+done
 $TMUX2 copy-mode -H || exit 1
 $TMUX2 send -X history-top || exit 1
 compare scrollbar-copy-mode -e
