@@ -47,6 +47,24 @@
 	fail "prompt result is '$got', expected '$want'"
 }
 
+# vtmux (compat/tmux-3.8/README.md, Test races): wait (max 10 s) until the
+# outer pane shows (has) or no longer shows (lacks) a text, rather than for a
+# fixed time.
+wait_capture()
+{
+	i=0
+	while :; do
+		if capture | grep -Fq -- "$2"; then
+			[ "$1" = has ] && return 0
+		else
+			[ "$1" = lacks ] && return 0
+		fi
+		[ "$i" -lt 100 ] || fail "outer pane $1 '$2' after 10 s"
+		sleep 0.1
+		i=$((i + 1))
+	done
+}
